<Window x:Class="ClosetApp.UI.Views.AddClothingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加衣服"
        Width="500" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <TextBlock Text="衣服名称" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtName" Padding="12" Margin="0,0,0,16"/>

                <TextBlock Text="类型" FontSize="14" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbType" Margin="0,0,0,16">
                    <ComboBoxItem Content="上衣" Tag="Top"/>
                    <ComboBoxItem Content="下装" Tag="Bottom"/>
                    <ComboBoxItem Content="外套" Tag="Outerwear"/>
                    <ComboBoxItem Content="裙子" Tag="Dress"/>
                    <ComboBoxItem Content="鞋子" Tag="Shoes"/>
                    <ComboBoxItem Content="配饰" Tag="Accessory"/>
                </ComboBox>

                <TextBlock Text="季节" FontSize="14" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbSeason" Margin="0,0,0,16">
                    <ComboBoxItem Content="春" Tag="Spring"/>
                    <ComboBoxItem Content="夏" Tag="Summer"/>
                    <ComboBoxItem Content="秋" Tag="Autumn"/>
                    <ComboBoxItem Content="冬" Tag="Winter"/>
                    <ComboBoxItem Content="四季" Tag="AllSeason" IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="颜色" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtColor" Padding="12" Margin="0,0,0,16"/>

                <TextBlock Text="品牌" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtBrand" Padding="12" Margin="0,0,0,16"/>

                <TextBlock Text="喜欢程度" FontSize="14" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbFavorite" Margin="0,0,0,24">
                    <ComboBoxItem Content="一般" Tag="1"/>
                    <ComboBoxItem Content="不错" Tag="2"/>
                    <ComboBoxItem Content="喜欢" Tag="3"/>
                    <ComboBoxItem Content="很喜欢" Tag="4"/>
                    <ComboBoxItem Content="超级爱" Tag="5"/>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="取消" Padding="16" Click="Cancel_Click"/>
                    <Button Grid.Column="2" Content="保存" Padding="16" Background="{DynamicResource PrimaryBrush}" Foreground="White" Click="Save_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
