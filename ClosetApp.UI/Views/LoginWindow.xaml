<Window x:Class="ClosetApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录我的衣橱"
        Icon="../Assets/Icons/app-avatar.png"
        Width="1040"
        Height="780"
        MinWidth="1040"
        MinHeight="780"
        MaxWidth="1040"
        MaxHeight="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfacePageBrush}">
    <Window.Resources>
        <!-- 登录窗口没有主界面级容器，输入右键菜单在这里单独收敛成统一浅色样式。 -->
        <Style x:Key="LoginContextMenu"
               TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Hint}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource ComboBoxPopupLift}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginContextMenuItem"
               TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Hint}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Meta}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{TemplateBinding InputGestureText}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemShell" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="LoginTextContextMenu"
                     x:Shared="False"
                     Style="{StaticResource LoginContextMenu}">
            <MenuItem Header="剪切"
                      InputGestureText="Ctrl+X"
                      Style="{StaticResource LoginContextMenuItem}"
                      Command="ApplicationCommands.Cut"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="复制"
                      InputGestureText="Ctrl+C"
                      Style="{StaticResource LoginContextMenuItem}"
                      Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="粘贴"
                      InputGestureText="Ctrl+V"
                      Style="{StaticResource LoginContextMenuItem}"
                      Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="LoginPasswordContextMenu"
                     x:Shared="False"
                     Style="{StaticResource LoginContextMenu}">
            <MenuItem Header="粘贴"
                      InputGestureText="Ctrl+V"
                      Style="{StaticResource LoginContextMenuItem}"
                      Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="清空"
                      Style="{StaticResource LoginContextMenuItem}"
                      Click="PasswordContextMenuClear_Click"/>
        </ContextMenu>
        <Style x:Key="LoginInputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Hint}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginFieldErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,-6,0,12"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="LoginTextBox"
               TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="ContextMenu" Value="{StaticResource LoginTextContextMenu}"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox"
               TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="ContextMenu" Value="{StaticResource LoginPasswordContextMenu}"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginInlineLinkButton"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginRecentAccountButton"
               TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardShell" Property="Background" Value="White"/>
                                <Setter TargetName="CardShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="CardShell" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="-1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardShell" Property="Background" Value="White"/>
                                <Setter TargetName="CardShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardShell" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.992" ScaleY="0.992"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardShell" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginSubmitButton"
               TargetType="Button"
               BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="-1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource AppComboBoxBase}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ContextMenu="{StaticResource LoginTextContextMenu}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             Visibility="Hidden"/>
                                    <ToggleButton Grid.Column="1"
                                                  Width="42"
                                                  Style="{StaticResource AppComboBoxToggleButton}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="⌄"
                                                   Margin="0,0,0,2"
                                                   FontSize="{DynamicResource FontSize.SectionTitle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                                    <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="6"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Effect="{StaticResource ComboBoxPopupLift}">
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountComboBoxItem"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource AppComboBoxItemBase}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource SurfacePageBrush}">
        <StackPanel x:Name="LoginThemeToggle"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Orientation="Horizontal"
                    Panel.ZIndex="2">
            <Border Style="{StaticResource AppSegmentedTabShell}">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="BtnThemeRose"
                                 Content="柔粉"
                                 GroupName="LoginTheme"
                                 Style="{StaticResource AppSegmentedTabButton}"
                                 Checked="LoginThemeRose_Checked"/>
                    <RadioButton x:Name="BtnThemeBlue"
                                 Content="清蓝"
                                 GroupName="LoginTheme"
                                 Style="{StaticResource AppSegmentedTabButton}"
                                 Checked="LoginThemeBlue_Checked"/>
                </UniformGrid>
            </Border>
        </StackPanel>
        <StackPanel x:Name="LoginWorkspaceShell"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="20,74,20,24">
            <StackPanel x:Name="LoginHeroSurface"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Center">
                <Image Width="40"
                       Height="40"
                       HorizontalAlignment="Center"
                       Source="../Assets/Icons/app-avatar.png"/>
                <TextBlock Text="我的衣橱"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Hero}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="Closet Companion&#x0a;记录搭配与衣柜管理"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Hint}"
                           LineHeight="17"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel x:Name="LoginFormSurface">
                <TextBlock x:Name="TxtModeTitle"
                           Text="登录"
                           FontSize="{DynamicResource FontSize.PageTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtModeDescription"
                           Text="使用本地账号继续"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource FontSize.Hint}"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="管理员账号" Style="{StaticResource LoginInputLabel}"/>
                    <TextBox x:Name="SetupAccountBox"
                             Margin="0,6,0,12"
                             Style="{StaticResource LoginTextBox}"/>
                    <TextBlock x:Name="TxtSetupAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="管理员密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="确认密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupConfirmPasswordBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupConfirmPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                </StackPanel>

                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="账号"
                               Style="{StaticResource LoginInputLabel}"/>
                    <ComboBox x:Name="RecentAccountSelector"
                              Margin="0,6,0,12"
                              DisplayMemberPath="AccountName"
                              IsEditable="True"
                              ItemContainerStyle="{StaticResource RecentAccountComboBoxItem}"
                              Style="{StaticResource RecentAccountComboBox}"
                              TextSearch.TextPath="AccountName"
                              SelectionChanged="RecentAccountSelector_SelectionChanged"/>
                    <TextBlock x:Name="TxtLoginAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="密码"
                               Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtLoginPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                </StackPanel>

                <Border x:Name="LoginErrorHost"
                        Margin="0,8,0,0"
                        Padding="12,10"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LoginErrorIcon"
                                Width="22"
                                Height="22"
                                Margin="0,2,10,0"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtErrorTitle"
                                       Text="登录失败"
                                       FontSize="{DynamicResource FontSize.Hint}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtError"
                                       Margin="0,4,0,0"
                                       FontSize="{DynamicResource FontSize.Hint}"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LoginActionRail"
                        Margin="0,12,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button x:Name="BtnSubmit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource LoginSubmitButton}"
                            Click="Submit_Click">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <ProgressBar x:Name="SubmitBusyIndicator"
                                         Width="28"
                                         Height="8"
                                         Margin="0,0,10,0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtSubmitLabel"
                                       Text="登录"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                </StackPanel>

                <Button x:Name="HeroRecentAccountBlock"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LoginRecentAccountButton}"
                        Click="RecentAccountBlock_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryLightBrush}"
                                CornerRadius="17">
                            <TextBlock Text="近"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Hint}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryDarkBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0">
                            <TextBlock Text="最近使用"
                                       FontSize="{DynamicResource FontSize.Meta}"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"/>
                            <TextBlock x:Name="TxtRecentAccountName"
                                       Margin="0,2,0,0"
                                       FontSize="{DynamicResource FontSize.Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtRecentAccountLastLogin"
                                       Margin="0,2,0,0"
                                       FontSize="{DynamicResource FontSize.Meta}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Meta}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Text="填入"/>
                    </Grid>
                </Button>

                <StackPanel x:Name="FirstTimeHintBlock"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Hint}"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="首次使用？"/>
                        <Run Text="请先完成管理员初始化"/>
                    </TextBlock>
                    <Button x:Name="BtnLearnMultiUser"
                            Content="了解本地多用户模式"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Style="{StaticResource LoginInlineLinkButton}"
                            Click="LearnMultiUser_Click"/>
                    <Border x:Name="MultiUserModeInfoPanel"
                            Margin="0,6,0,0"
                            Padding="14,12"
                            MaxWidth="360"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Visibility="Collapsed">
                        <TextBlock Style="{StaticResource LoginInfoText}"
                                   FontSize="{DynamicResource FontSize.Meta}"
                                   Text="这是本地多用户工作区。成员由超级管理员在登录后创建和管理，登录页本身不开放公开注册。"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
