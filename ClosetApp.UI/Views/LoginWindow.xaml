<Window x:Class="ClosetApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录我的衣橱"
        Icon="../Assets/Icons/app-avatar.png"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfacePageBrush}">
    <Window.Resources>
        <Style x:Key="LoginInputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginFieldErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,-6,0,12"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="LoginTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource WorkbenchTextInput}">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="LoginPasswordBox"
               TargetType="PasswordBox"
               BasedOn="{StaticResource WorkbenchPasswordInput}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="LoginInfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginHeroInfoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="LoginSubmitButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style x:Key="RecentAccountComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource AppComboBoxBase}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             Visibility="Hidden"/>
                                    <ToggleButton Grid.Column="1"
                                                  Width="42"
                                                  Style="{StaticResource AppComboBoxToggleButton}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="⌄"
                                                   Margin="0,0,0,2"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="6"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Effect="{StaticResource ComboBoxPopupLift}">
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountComboBoxItem"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource AppComboBoxItemBase}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="LoginWorkspaceShell"
            Margin="34"
            Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="28">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="LoginHeroSurface"
                Grid.Column="0"
                Background="{DynamicResource SurfaceSectionBrush}"
                CornerRadius="28,0,0,28"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border x:Name="LoginSectionBadge"
                            Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="LOCAL WORKSPACE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock Text="我的衣橱"
                               Margin="0,16,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="输入账号和密码，进入对应的独立衣柜工作区。"
                               Margin="0,8,0,0"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="WelcomeInsightStack"
                            Grid.Row="1"
                            Margin="0,42,0,0"
                            VerticalAlignment="Bottom">
                    <Border x:Name="WelcomeMetricsCard"
                            Style="{StaticResource LoginHeroInfoCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地工作区"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="独立衣柜"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="快速回访"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="最近登录"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="WelcomeAccountIdentityCard"
                            Margin="0,14,0,0"
                            Style="{StaticResource LoginHeroInfoCard}">
                        <StackPanel>
                            <TextBlock Text="账号工作区"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="每个账号拥有独立衣柜、搭配、标签、效果图和个人资料。"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource LoginInfoText}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="WelcomeSessionCard"
                            Margin="0,14,0,0"
                            Style="{StaticResource LoginHeroInfoCard}"
                            Background="{DynamicResource PrimaryLightBrush}">
                        <StackPanel>
                            <TextBlock Text="欢迎回来"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="重新进入时会优先帮你回到最近使用的账号。"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource LoginInfoText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BorderLightBrush}"/>

        <Border x:Name="LoginFormSurface"
                Grid.Column="2"
                Background="{DynamicResource SurfaceCardBrush}"
                CornerRadius="0,28,28,0"
                Padding="46,42">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtModeTitle"
                               Text="登录"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtModeDescription"
                               Text="输入账号和密码继续。"
                               Margin="0,8,0,0"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="LoginFormScrollViewer"
                              Grid.Row="1"
                              Margin="0,22,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="520"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="管理员账号" Style="{StaticResource LoginInputLabel}"/>
                    <TextBox x:Name="SetupAccountBox"
                             Margin="0,8,0,14"
                             Style="{StaticResource LoginTextBox}"/>
                    <TextBlock x:Name="TxtSetupAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="管理员密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Margin="0,8,0,14"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="确认密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupConfirmPasswordBox"
                                 Margin="0,8,0,14"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupConfirmPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="快捷 PIN（可选）" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPinBox"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock Text="PIN 只用于本机快捷登录，可以之后再设置。"
                               Margin="2,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </StackPanel>

                <StackPanel x:Name="LoginPanel">
                    <Border x:Name="RecentAccountSectionCard"
                            Margin="0,0,0,16"
                            Padding="16,14"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="账号" Style="{StaticResource LoginInputLabel}"/>
                            <ComboBox x:Name="RecentAccountSelector"
                                      Margin="0,8,0,14"
                                      DisplayMemberPath="AccountName"
                                      IsEditable="True"
                                      ItemContainerStyle="{StaticResource RecentAccountComboBoxItem}"
                                      Style="{StaticResource RecentAccountComboBox}"
                                      TextSearch.TextPath="AccountName"
                                      SelectionChanged="RecentAccountSelector_SelectionChanged"/>
                            <TextBlock x:Name="TxtLoginAccountError"
                                       Style="{StaticResource LoginFieldErrorText}"/>
                            <Grid x:Name="CredentialModePanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="登录方式"
                                           Style="{StaticResource LoginInputLabel}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="CredentialModeSurface"
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource AppSegmentedTabShell}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="BtnPasswordMode"
                                                     Content="密码"
                                                     GroupName="LoginCredentialMode"
                                                     IsChecked="True"
                                                     Style="{StaticResource AppSegmentedTabButton}"
                                                     Checked="PasswordMode_Checked"/>
                                        <RadioButton x:Name="BtnPinMode"
                                                     Content="PIN"
                                                     GroupName="LoginCredentialMode"
                                                     Style="{StaticResource AppSegmentedTabButton}"
                                                     Checked="PinMode_Checked"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="PasswordCredentialPanel">
                        <TextBlock Text="密码" Style="{StaticResource LoginInputLabel}"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     Margin="0,8,0,14"
                                     Style="{StaticResource LoginPasswordBox}"/>
                    </StackPanel>
                    <StackPanel x:Name="PinCredentialPanel"
                                Visibility="Collapsed">
                        <TextBlock Text="PIN" Style="{StaticResource LoginInputLabel}"/>
                        <PasswordBox x:Name="LoginPinBox"
                                     Margin="0,8,0,14"
                                     Style="{StaticResource LoginPasswordBox}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLoginPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                </StackPanel>

                <Border x:Name="LoginErrorHost"
                        Margin="0,16,0,0"
                        Padding="13,12"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LoginErrorIcon"
                                Width="22"
                                Height="22"
                                Margin="0,2,10,0"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtErrorTitle"
                                       Text="登录失败"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtError"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LoginActionRail"
                        Margin="0,22,0,0"
                        Padding="14"
                        Background="{DynamicResource SurfaceSectionBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Button x:Name="BtnSubmit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource LoginSubmitButton}"
                            Click="Submit_Click">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <ProgressBar x:Name="SubmitBusyIndicator"
                                         Width="28"
                                         Height="8"
                                         Margin="0,0,10,0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtSubmitLabel"
                                       Text="登录"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
