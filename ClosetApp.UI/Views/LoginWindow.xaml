<Window x:Class="ClosetApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录我的衣橱"
        Icon="../Assets/Icons/app-avatar.png"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfacePageBrush}">
    <Window.Resources>
        <Style x:Key="LoginInputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginFieldErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,-6,0,12"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputShell" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputShell" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginSubmitButton" TargetType="Button">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountSelectedButton"
               BasedOn="{StaticResource RecentAccountButton}"
               TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
        </Style>

        <Style x:Key="RecentAccountHintChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RecentAccountPrimaryChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RecentAccountHoverAvatar" TargetType="Border">
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="LoginFieldSummaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginSelectedAccountCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Border Margin="34"
            Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="28">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceSectionBrush}"
                CornerRadius="28,0,0,28"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="LOCAL WORKSPACE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock Text="我的衣橱"
                               Margin="0,16,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="输入账号和密码，进入对应的独立衣柜工作区。"
                               Margin="0,8,0,0"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,42,0,0"
                            VerticalAlignment="Bottom">
                    <Border x:Name="WelcomeMetricsCard"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地工作区"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="独立衣柜"
                                           Margin="0,8,0,0"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="快速回访"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="最近登录"
                                           Margin="0,8,0,0"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="WelcomeSessionCard"
                            Margin="0,14,0,0"
                            Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="欢迎回来"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="每个账号拥有独立衣柜、搭配、标签和效果图，重新进入时会优先帮你回到最近使用的账号。"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource LoginInfoText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BorderLightBrush}"/>

        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceCardBrush}"
                CornerRadius="0,28,28,0"
                Padding="46,42">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtModeTitle"
                               Text="登录"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtModeDescription"
                               Text="输入账号和密码继续。"
                               Margin="0,8,0,0"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="LoginFormScrollViewer"
                              Grid.Row="1"
                              Margin="0,22,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="520"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="管理员账号" Style="{StaticResource LoginInputLabel}"/>
                    <TextBox x:Name="SetupAccountBox"
                             Margin="0,8,0,14"
                             Style="{StaticResource LoginTextBox}"/>
                    <TextBlock x:Name="TxtSetupAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="管理员密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Margin="0,8,0,14"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="确认密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupConfirmPasswordBox"
                                 Margin="0,8,0,14"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupConfirmPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="快捷 PIN（可选）" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPinBox"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock Text="PIN 只用于本机快捷登录，可以之后再设置。"
                               Margin="2,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </StackPanel>

                <StackPanel x:Name="LoginPanel">
                    <StackPanel x:Name="RecentAccountsPanel"
                                Margin="0,0,0,18"
                                Visibility="Collapsed">
                        <TextBlock Text="最近登录"
                                   Style="{StaticResource LoginInputLabel}"/>
                        <WrapPanel x:Name="RecentAccountsHost"
                                   MaxWidth="510"
                                   Margin="0,10,0,0"
                                   ItemHeight="68"
                                   ItemWidth="248"
                                   Orientation="Horizontal"/>
                        <Border x:Name="RecentAccountsDivider"
                                Margin="0,14,0,0"
                                Height="1"
                                Background="{DynamicResource BorderLightBrush}"
                                Opacity="0.72"/>
                    </StackPanel>
                    <Border x:Name="SelectedAccountCard"
                            Style="{StaticResource LoginSelectedAccountCard}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="当前账号"
                                       Style="{StaticResource LoginFieldSummaryText}"/>
                            <TextBlock x:Name="TxtSelectedUser"
                                       Text="账号"
                                       Margin="0,5,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSelectedUserHint"
                                       Text="使用最近登录账号或手动输入账号名。"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource LoginFieldSummaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="账号" Style="{StaticResource LoginInputLabel}"/>
                    <TextBox x:Name="LoginAccountBox"
                             Margin="0,8,0,14"
                             Style="{StaticResource LoginTextBox}"
                             TextChanged="LoginAccountBox_TextChanged"/>
                    <TextBlock x:Name="TxtLoginAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Margin="0,8,0,14"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtLoginPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="PIN（可选）" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="LoginPinBox"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock Text="如果填写 PIN，会优先使用 PIN 登录；留空则使用密码。"
                               Margin="2,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </StackPanel>

                <Border x:Name="LoginErrorHost"
                        Margin="0,16,0,0"
                        Padding="13,12"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LoginErrorIcon"
                                Width="22"
                                Height="22"
                                Margin="0,2,10,0"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtErrorTitle"
                                       Text="登录失败"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtError"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="BtnSubmit"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource LoginSubmitButton}"
                        Click="Submit_Click">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar x:Name="SubmitBusyIndicator"
                                     Width="28"
                                     Height="8"
                                     Margin="0,0,10,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtSubmitLabel"
                                   Text="登录"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
