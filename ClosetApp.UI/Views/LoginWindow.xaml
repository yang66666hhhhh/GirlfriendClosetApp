<Window x:Class="ClosetApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录我的衣橱"
        Icon="../Assets/Icons/app-avatar.png"
        Width="1040"
        Height="780"
        MinWidth="900"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfacePageBrush}">
    <Window.Resources>
        <Style x:Key="LoginInputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginFieldErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,-6,0,12"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="LoginTextBox"
               TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox"
               TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LoginSubmitButton"
               TargetType="Button"
               BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="-1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource AppComboBoxBase}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             Visibility="Hidden"/>
                                    <ToggleButton Grid.Column="1"
                                                  Width="42"
                                                  Style="{StaticResource AppComboBoxToggleButton}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="⌄"
                                                   Margin="0,0,0,2"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                                    <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="6"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Effect="{StaticResource ComboBoxPopupLift}">
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputShell" Property="Background" Value="White"/>
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentAccountComboBoxItem"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource AppComboBoxItemBase}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#F8FAFF">
        <StackPanel x:Name="LoginWorkspaceShell"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20,24,20,24">
            <StackPanel x:Name="LoginHeroSurface"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                <Image Width="40"
                       Height="40"
                       HorizontalAlignment="Center"
                       Source="../Assets/Icons/app-avatar.png"/>
                <TextBlock Text="我的衣橱"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="Closet Companion&#x0a;记录搭配与衣柜管理"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           LineHeight="18"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel x:Name="LoginFormSurface">
                <TextBlock x:Name="TxtModeTitle"
                           Text="登录"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtModeDescription"
                           Text="使用本地账号继续"
                           Margin="0,4,0,0"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Margin="0,20,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="管理员账号" Style="{StaticResource LoginInputLabel}"/>
                    <TextBox x:Name="SetupAccountBox"
                             Margin="0,6,0,12"
                             Style="{StaticResource LoginTextBox}"/>
                    <TextBlock x:Name="TxtSetupAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="管理员密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="确认密码" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupConfirmPasswordBox"
                                 Margin="0,6,0,12"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock x:Name="TxtSetupConfirmPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <TextBlock Text="快捷 PIN（可选）" Style="{StaticResource LoginInputLabel}"/>
                    <PasswordBox x:Name="SetupPinBox"
                                 Margin="0,6,0,0"
                                 Style="{StaticResource LoginPasswordBox}"/>
                    <TextBlock Text="PIN 只用于本机快捷登录，可以之后再设置。"
                               Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </StackPanel>

                <StackPanel x:Name="LoginPanel">
                    <ComboBox x:Name="RecentAccountSelector"
                              Margin="0,0,0,12"
                              DisplayMemberPath="AccountName"
                              IsEditable="True"
                              ItemContainerStyle="{StaticResource RecentAccountComboBoxItem}"
                              Style="{StaticResource RecentAccountComboBox}"
                              TextSearch.TextPath="AccountName"
                              SelectionChanged="RecentAccountSelector_SelectionChanged"/>
                    <TextBlock x:Name="TxtLoginAccountError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                    <Grid x:Name="CredentialModePanel"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="登录凭证"
                                   Style="{StaticResource LoginInputLabel}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="CredentialModeSurface"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AppSegmentedTabShell}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="BtnPasswordMode"
                                             Content="密码"
                                             GroupName="LoginCredentialMode"
                                             IsChecked="True"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="PasswordMode_Checked"/>
                                <RadioButton x:Name="BtnPinMode"
                                             Content="PIN"
                                             GroupName="LoginCredentialMode"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="PinMode_Checked"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="PasswordCredentialPanel">
                        <PasswordBox x:Name="LoginPasswordBox"
                                     Margin="0,0,0,12"
                                     Style="{StaticResource LoginPasswordBox}"/>
                    </StackPanel>
                    <StackPanel x:Name="PinCredentialPanel"
                                Visibility="Collapsed">
                        <PasswordBox x:Name="LoginPinBox"
                                     Margin="0,0,0,12"
                                     Style="{StaticResource LoginPasswordBox}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLoginPasswordError"
                               Style="{StaticResource LoginFieldErrorText}"/>
                </StackPanel>

                <Border x:Name="LoginErrorHost"
                        Margin="0,8,0,0"
                        Padding="12,10"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LoginErrorIcon"
                                Width="22"
                                Height="22"
                                Margin="0,2,10,0"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtErrorTitle"
                                       Text="登录失败"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtError"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LoginActionRail"
                        Margin="0,12,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button x:Name="BtnSubmit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource LoginSubmitButton}"
                            Click="Submit_Click">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <ProgressBar x:Name="SubmitBusyIndicator"
                                         Width="28"
                                         Height="8"
                                         Margin="0,0,10,0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtSubmitLabel"
                                       Text="登录"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                </StackPanel>

                <TextBlock x:Name="HeroSessionHint"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="最近使用：admin"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
