<Window x:Class="ClosetApp.UI.Views.EditClothingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑衣服" Width="560" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF8F6F2">

    <Window.Resources>
        <Color x:Key="CardBg">#FFFFFDFC</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
        <Color x:Key="SecondaryBg">#FFF5F3EE</Color>
        <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBg}"/>
        <Color x:Key="BorderC">#FFE8E2DC</Color>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderC}"/>
        <Color x:Key="TextPrimary">#FF2D2A26</Color>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <Color x:Key="TextSecondary">#FF5E5A56</Color>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <Color x:Key="TextTertiary">#FFA39B95</Color>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
        <Color x:Key="Accent">#FFD9A299</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <Color x:Key="AccentLight">#FFF5EDE9</Color>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
        <Color x:Key="Danger">#FFE88D8D</Color>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <TextBlock Text="编辑衣服" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Image Preview -->
                <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="14"
                        Height="200" Margin="0,0,0,20" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <TextBlock x:Name="TxtNoImage" Text="暂无图片"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Name -->
                <TextBlock Text="名称" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                    <TextBox x:Name="TxtName" BorderThickness="0" Background="Transparent" FontSize="14"/>
                </Border>

                <!-- Type + Season -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="类型" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbType">
                            <ComboBoxItem Content="上衣" Tag="Top"/>
                            <ComboBoxItem Content="下装" Tag="Bottom"/>
                            <ComboBoxItem Content="外套" Tag="Outerwear"/>
                            <ComboBoxItem Content="连衣裙" Tag="Dress"/>
                            <ComboBoxItem Content="短裙" Tag="Skirt"/>
                            <ComboBoxItem Content="鞋子" Tag="Shoes"/>
                            <ComboBoxItem Content="配饰" Tag="Accessory"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="季节" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbSeason">
                            <ComboBoxItem Content="春" Tag="Spring"/>
                            <ComboBoxItem Content="夏" Tag="Summer"/>
                            <ComboBoxItem Content="秋" Tag="Autumn"/>
                            <ComboBoxItem Content="冬" Tag="Winter"/>
                            <ComboBoxItem Content="四季" Tag="AllSeason"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Color + Brand -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="颜色" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12">
                            <TextBox x:Name="TxtColor" BorderThickness="0" Background="Transparent" FontSize="14"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="品牌" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12">
                            <TextBox x:Name="TxtBrand" BorderThickness="0" Background="Transparent" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="备注" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                    <TextBox x:Name="TxtNotes" BorderThickness="0" Background="Transparent" FontSize="14"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                </Border>

                <!-- Favorite Level -->
                <TextBlock Text="喜爱程度" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <hc:Rate x:Name="RatingControl" Count="5" Value="3" Foreground="#fbbf24" FontSize="22" Margin="0,0,0,16"/>

                <!-- Image Path -->
                <TextBlock Text="图片" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12">
                        <TextBox x:Name="TxtImagePath" BorderThickness="0" Background="Transparent" FontSize="13"
                                 IsReadOnly="True" Foreground="{StaticResource TextTertiaryBrush}"/>
                    </Border>
                    <Button Grid.Column="2" Content="更换" Padding="14,10" Margin="0,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="SelectImage_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="删除衣服" Padding="14,10"
                        Style="{StaticResource DangerButton}" Click="Delete_Click"/>
                <Button Grid.Column="2" Content="取消" Padding="14,10"
                        Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Grid.Column="4" Content="保存" Padding="20,10"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
