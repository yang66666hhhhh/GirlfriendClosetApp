<UserControl x:Class="ClosetApp.UI.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dto="clr-namespace:ClosetApp.Application.DTOs;assembly=ClosetApp.Application">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsBlueSurfaceBrush" Color="{DynamicResource Theme.Sky.Surface}"/>
        <SolidColorBrush x:Key="SettingsBlueBorderBrush" Color="{DynamicResource Theme.Sky.Border}"/>
        <SolidColorBrush x:Key="SettingsBlueTextBrush" Color="{DynamicResource Theme.Sky.Text}"/>
        <SolidColorBrush x:Key="SettingsAmberSurfaceBrush" Color="{DynamicResource Theme.Amber.Surface}"/>
        <SolidColorBrush x:Key="SettingsAmberBorderBrush" Color="{DynamicResource Theme.Amber.Border}"/>
        <SolidColorBrush x:Key="SettingsAmberTextBrush" Color="{DynamicResource Theme.Amber.Text}"/>
        <SolidColorBrush x:Key="SettingsGreenSurfaceBrush" Color="{DynamicResource Theme.Mint.Surface}"/>
        <SolidColorBrush x:Key="SettingsGreenBorderBrush" Color="{DynamicResource Theme.Mint.Border}"/>
        <SolidColorBrush x:Key="SettingsGreenTextBrush" Color="{DynamicResource Theme.Mint.Text}"/>
        <SolidColorBrush x:Key="SettingsRoseSurfaceBrush" Color="{DynamicResource Theme.Rose.Surface}"/>
        <SolidColorBrush x:Key="SettingsRoseBorderBrush" Color="{DynamicResource Theme.Rose.Border}"/>
        <SolidColorBrush x:Key="SettingsRoseTextBrush" Color="{DynamicResource Theme.Rose.Text}"/>
        <SolidColorBrush x:Key="SettingsLavenderSurfaceBrush" Color="{DynamicResource Theme.Lavender.Surface}"/>
        <SolidColorBrush x:Key="SettingsLavenderBorderBrush" Color="{DynamicResource Theme.Lavender.Border}"/>
        <SolidColorBrush x:Key="SettingsLavenderTextBrush" Color="{DynamicResource Theme.Lavender.Text}"/>

        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsBlueSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBlueBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsAmberSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
            <Setter Property="Background" Value="{StaticResource ThemeAmberSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAmberBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsGreenSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
            <Setter Property="Background" Value="{StaticResource ThemeMintSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsGreenBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsRoseSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
            <Setter Property="Background" Value="{StaticResource ThemeRoseSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsRoseBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsLavenderSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
            <Setter Property="Background" Value="{StaticResource ThemeLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLavenderBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsEyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ThemeCurrentBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ThemeCurrentBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfacePageBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="SettingsBlueStatCard" TargetType="Border" BasedOn="{StaticResource SettingsStatCard}">
            <Setter Property="Background" Value="{StaticResource SettingsBlueSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBlueBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsAmberStatCard" TargetType="Border" BasedOn="{StaticResource SettingsStatCard}">
            <Setter Property="Background" Value="{StaticResource SettingsAmberSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAmberBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsGreenStatCard" TargetType="Border" BasedOn="{StaticResource SettingsStatCard}">
            <Setter Property="Background" Value="{StaticResource SettingsGreenSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsGreenBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsRoseStatCard" TargetType="Border" BasedOn="{StaticResource SettingsStatCard}">
            <Setter Property="Background" Value="{StaticResource SettingsRoseSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsRoseBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsLavenderStatCard" TargetType="Border" BasedOn="{StaticResource SettingsStatCard}">
            <Setter Property="Background" Value="{StaticResource SettingsLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLavenderBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsActionWrap" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <Style x:Key="SettingsBlueInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{StaticResource SettingsBlueSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBlueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsAmberInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{StaticResource SettingsAmberSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAmberBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsGreenInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{StaticResource SettingsGreenSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsGreenBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsRoseInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{StaticResource SettingsRoseSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsRoseBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsLavenderInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{StaticResource SettingsLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLavenderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsBlueButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource SettingsBlueSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBlueBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsBlueTextBrush}"/>
        </Style>

        <Style x:Key="SettingsAmberButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource SettingsAmberSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAmberBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsAmberTextBrush}"/>
        </Style>

        <Style x:Key="SettingsGreenButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource SettingsGreenSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsGreenBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsGreenTextBrush}"/>
        </Style>

        <Style x:Key="SettingsLavenderButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource SettingsLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsLavenderBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsLavenderTextBrush}"/>
        </Style>

        <Style x:Key="SettingsRoseButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource SettingsRoseSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsRoseBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsRoseTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <TextBlock Text="设置"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,16"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="设置总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="把目录、图片维护、天气和备份集中到一页里，整理和排障都更顺手。"
                                       Style="{StaticResource PageSummaryBodyText}"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="维护"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="图片缓存 · 日志"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="偏好"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="天气城市 · 外观"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="安全"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="备份与恢复"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <UniformGrid Grid.Column="2"
                                     Columns="2"
                                     Rows="2">
                            <Border Style="{StaticResource SettingsBlueStatCard}">
                                <StackPanel>
                                    <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtImageStats" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsAmberStatCard}">
                                <StackPanel>
                                    <TextBlock Text="缓存状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtCacheStats" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsGreenStatCard}">
                                <StackPanel>
                                    <TextBlock Text="默认城市" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock Text="{Binding Text, ElementName=TxtWeatherCity}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRoseStatCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="日志状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtLogStats" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingsBlueSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsBlueSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsBlueBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="资源与目录"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsBlueTextBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文件位置"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="把常用目录集中展示，遇到图片、数据库或缓存问题时能快速定位。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="打开应用目录"
                                            Style="{StaticResource SettingsBlueButton}"
                                            Click="OpenAppDir_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsBlueInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="数据目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtDataDir"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开目录"
                                                        Style="{StaticResource SettingsBlueButton}"
                                                        Click="OpenDataDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="定位数据库"
                                                        Style="{StaticResource SettingsBlueButton}"
                                                        Click="OpenDatabase_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsBlueInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="图片目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtImagesDir"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开图片"
                                                        Style="{StaticResource SettingsBlueButton}"
                                                        Click="OpenImagesDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="打开缓存"
                                                        Style="{StaticResource SettingsBlueButton}"
                                                        Click="OpenThumbnailsDir_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsAmberSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsAmberSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsAmberBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="维护"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsAmberTextBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="图片资产"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="把缓存、缺失修复和孤儿原图治理收进同一组，减少来回切换。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Style="{StaticResource SettingsAmberButton}"
                                            Click="RefreshStats_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SettingsBlueStatCard}">
                                        <StackPanel>
                                            <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock Text="{Binding Text, ElementName=TxtImageStats}" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsAmberStatCard}">
                                        <StackPanel>
                                            <TextBlock Text="缓存体量" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock Text="{Binding Text, ElementName=TxtCacheStats}" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRoseStatCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="缺失状态" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock x:Name="TxtMissingImageStats" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsAmberInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="缓存健康" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtThumbnailHealthStats"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsAmberInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="原图治理" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtOrphanOriginalStats"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                    <Button Content="重建缺失缓存"
                                            Style="{StaticResource SettingsAmberButton}"
                                            Click="RebuildThumbnails_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="修复缺失图片"
                                            Style="{StaticResource SettingsAmberButton}"
                                            Click="RepairMissingImages_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理图片缓存"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ClearThumbnails_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理孤儿原图"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="CleanupOrphanOriginals_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsRoseSectionCard}" Margin="0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsRoseSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsRoseBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="排障"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsRoseTextBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="系统日志"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="保留最近 14 天日志，主要用于排查启动、图片处理和数据同步问题。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="RefreshStats_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsRoseInsetCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text, ElementName=TxtLogStats}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLogDir"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                    <Button Content="打开日志目录"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="OpenLogsDir_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理历史日志"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ClearLogs_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SettingsGreenSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsGreenSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsGreenBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="偏好"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsGreenTextBrush}"/>
                                </Border>
                                <TextBlock Text="天气与城市"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock Text="默认城市会用于获取实时天气，后续天气穿搭推荐也会直接复用这里。"
                                           Style="{StaticResource PageSectionBodyText}"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtWeatherCity"
                                             Grid.Column="0"
                                             MinHeight="40"
                                             Padding="12,9"
                                             Text="Shanghai"/>
                                    <Button x:Name="BtnSaveWeatherCity"
                                            Grid.Column="1"
                                            Content="保存"
                                            Style="{StaticResource SettingsGreenButton}"
                                            Click="SaveWeatherCity_Click"
                                            Margin="8,0,0,0"/>
                                    <Button x:Name="BtnRefreshWeather"
                                            Grid.Column="2"
                                            Content="刷新天气"
                                            Style="{StaticResource SettingsGreenButton}"
                                            Click="RefreshWeather_Click"
                                            Margin="8,0,0,0"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsGreenInsetCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtWeatherSummary"
                                                   Text="还没有获取天气。"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtWeatherDetails"
                                                   Text="保存城市后，点一次刷新就可以验证天气接口是否接通。"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtWeatherObservedAt"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"/>
                                        <Border x:Name="WeatherStatusCard"
                                                Style="{StaticResource PageInsetCard}"
                                                Background="{StaticResource SurfacePageBrush}"
                                                Padding="12"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="TxtWeatherStatus"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AppearanceSectionCard"
                                Style="{StaticResource SettingsLavenderSectionCard}">
                            <StackPanel>
                                <Border x:Name="AppearanceSectionBadge"
                                        Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsLavenderSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsLavenderBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AppearanceSectionBadgeText"
                                               Text="外观"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsLavenderTextBrush}"/>
                                </Border>
                                <TextBlock Text="界面与应用"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock Text="把主题调性和应用信息放在同一块，右侧阅读会更顺。"
                                           Style="{StaticResource PageSectionBodyText}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ThemeSelectionPanel"
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsLavenderInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="系统配色"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="ThemeRoseCard"
                                                        Grid.Column="0"
                                                        Background="{StaticResource SettingsRoseSurfaceBrush}"
                                                        BorderBrush="{StaticResource SettingsRoseBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="14"
                                                        Padding="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="柔粉"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Border x:Name="ThemeRoseCurrentBadge"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource ThemeCurrentBadge}">
                                                                <TextBlock Text="当前使用"
                                                                           Style="{StaticResource ThemeCurrentBadgeText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                            <Border x:Name="ThemeRoseSwatchPrimary" Width="22" Height="22" CornerRadius="11" Background="#FFDA94A5" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeRoseSwatchSoft" Width="22" Height="22" CornerRadius="11" Background="#FFF7E3E8" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeRoseSwatchSurface" Width="22" Height="22" CornerRadius="11" Background="#FFF8F1ED" Margin="0,0,6,6"/>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="温柔、亲近、暖一点。"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <Button x:Name="BtnUseRoseTheme"
                                                                Grid.Row="3"
                                                                Content="启用柔粉"
                                                                Style="{StaticResource PageToolbarCapsuleButton}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,10,0,0"
                                                                Click="UseRoseTheme_Click"/>
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="ThemeBlueCard"
                                                        Grid.Column="2"
                                                        Background="{StaticResource SettingsBlueSurfaceBrush}"
                                                        BorderBrush="{StaticResource SettingsBlueBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="14"
                                                        Padding="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="清蓝"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Border x:Name="ThemeBlueCurrentBadge"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource ThemeCurrentBadge}">
                                                                <TextBlock Text="当前使用"
                                                                           Style="{StaticResource ThemeCurrentBadgeText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                            <Border x:Name="ThemeBlueSwatchPrimary" Width="22" Height="22" CornerRadius="11" Background="#FF5881D6" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeBlueSwatchSoft" Width="22" Height="22" CornerRadius="11" Background="#FFE0ECFF" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeBlueSwatchSurface" Width="22" Height="22" CornerRadius="11" Background="#FFEBF1FB" Margin="0,0,6,6"/>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="克制、清爽、冷一点。"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <Button x:Name="BtnUseBlueTheme"
                                                                Grid.Row="3"
                                                                Content="启用清蓝"
                                                                Style="{StaticResource PageToolbarCapsuleButton}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,10,0,0"
                                                                Click="UseBlueTheme_Click"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtThemeSummary"
                                                       Text="当前使用柔粉主题"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtThemeDescription"
                                                       Text="适合长期整理衣橱，不抢照片和衣物本身的视觉重点。"
                                                       Style="{StaticResource PageMutedBodyText}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppearanceAppInfoCard"
                                            Grid.Column="2"
                                            Style="{StaticResource SettingsLavenderInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="应用信息"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtVersion"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text=".NET WPF / SQLite / Clean Architecture"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <Button x:Name="BtnAppearanceOpenAppDir"
                                                    Content="打开应用目录"
                                                    Style="{StaticResource PageToolbarCapsuleButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,14,0,0"
                                                    Click="OpenAppDir_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsRoseSectionCard}" Margin="0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{StaticResource SettingsRoseSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsRoseBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="安全"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{StaticResource SettingsRoseTextBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数据备份与恢复"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="导出前先看状态，导入后立刻看到结果和建议，整个闭环会更清楚。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新备份状态"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="RefreshBackupState_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="导出备份包"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="ExportBackup_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="一键导出"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="QuickExportBackup_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="导入备份"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ImportBackup_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="打开备份目录"
                                            Style="{StaticResource SettingsRoseButton}"
                                            Click="OpenBackupsDir_Click"/>
                                </WrapPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsRoseInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="导出前校验"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtBackupValidation"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationData"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationImages"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationHint"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <Border x:Name="BackupValidationWarningCard"
                                                    Style="{StaticResource PageWarningCard}"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="导出提醒"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtBackupValidationWarnings"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsRoseInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="最近一次导入"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtLastImportSummary"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtLastImportDetail"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Border x:Name="LastImportWarningCard"
                                                    Style="{StaticResource PageWarningCard}"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="建议处理"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtLastImportWarning"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                    <Button x:Name="BtnRepairAfterImport"
                                                            Content="立即修复缺失图片"
                                                            Style="{StaticResource SettingsRoseButton}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,10,0,0"
                                                            Click="RepairMissingImages_Click"
                                                            Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="LastImportMissingCard"
                                                    Style="{StaticResource PageInsetCard}"
                                                    Background="{StaticResource SurfacePageBrush}"
                                                    Padding="12"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="缺失图片"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtLastImportMissingFiles"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource SettingsRoseInsetCard}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="最近记录"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <WrapPanel HorizontalAlignment="Right">
                                                <Button Content="清空历史"
                                                        Style="{StaticResource PageToolbarDangerButton}"
                                                        Click="ClearBackupHistory_Click"/>
                                            </WrapPanel>
                                        </DockPanel>

                                        <ItemsControl x:Name="BackupHistoryList" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type dto:BackupHistoryItem}">
                                                    <Border Background="{StaticResource SurfacePageBrush}"
                                                            CornerRadius="14"
                                                            Padding="12"
                                                            Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding Summary}"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           Width="220"/>
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding MetaText}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,6,0,0"/>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding TimestampText}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,4,0,0"/>
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Button Content="打开文件"
                                                                        Style="{StaticResource SettingsRoseButton}"
                                                                        Click="OpenBackupFile_Click"
                                                                        Tag="{Binding FilePath}"
                                                                        Margin="0,0,8,8"/>
                                                                <Button Content="打开目录"
                                                                        Style="{StaticResource SettingsRoseButton}"
                                                                        Click="OpenBackupFolder_Click"
                                                                        Tag="{Binding FilePath}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtBackupHistoryEmpty"
                                                   Text="还没有备份记录。"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
