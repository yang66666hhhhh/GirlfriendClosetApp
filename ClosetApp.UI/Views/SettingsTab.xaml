<UserControl x:Class="ClosetApp.UI.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:ClosetApp.UI.Components.Settings">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionHeading" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <TextBlock Text="设置"
                           FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,10,44,32">
            <StackPanel x:Name="SettingsSectionFlow"
                        Margin="0,0,0,8">
                <Border x:Name="SettingsAppearanceSection"
                        Style="{StaticResource SettingsSectionHeading}">
                    <TextBlock Text="外观"
                               Style="{StaticResource PageSectionTitleText}"/>
                </Border>

                <settings:AppearanceSettingsPanel x:Name="AppearancePanel"
                                                  ThemeChanged="AppearancePanel_ThemeChanged"
                                                  FontSizeLevelChanged="AppearancePanel_FontSizeLevelChanged"
                                                  OutfitCardDisplayModeChanged="AppearancePanel_OutfitCardDisplayModeChanged"/>

                <Border x:Name="SettingsLocationWeatherSection"
                        Margin="0,20,0,12"
                        Style="{StaticResource SettingsSectionHeading}">
                    <TextBlock Text="位置与天气"
                               Style="{StaticResource PageSectionTitleText}"/>
                </Border>

                <settings:WeatherPreferencesSettingsPanel x:Name="WeatherPreferencesPanel"
                                                          OutfitsRefreshRequested="WeatherPreferencesPanel_OutfitsRefreshRequested"/>

                <Border x:Name="SettingsStorageSection"
                        Margin="0,20,0,12"
                        Style="{StaticResource SettingsSectionHeading}">
                    <TextBlock Text="存储"
                               Style="{StaticResource PageSectionTitleText}"/>
                </Border>

                <settings:StorageLocationsSettingsPanel x:Name="StorageLocationsPanel"/>

                <Border x:Name="SettingsSystemSection"
                        Margin="0,20,0,12"
                        Style="{StaticResource SettingsSectionHeading}">
                    <TextBlock Text="系统"
                               Style="{StaticResource PageSectionTitleText}"/>
                </Border>

                <StackPanel x:Name="SettingsSystemWorkspaceGrid">
                    <Grid x:Name="SettingsSystemTopRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <settings:AiImageGenerationSettingsPanel x:Name="AiImageGenerationPanel"
                                                                 Grid.Column="0"/>
                        <settings:ImageMaintenanceSettingsPanel x:Name="ImageMaintenancePanel"
                                                                Grid.Column="2"
                                                                WardrobeImagesChanged="ImageMaintenancePanel_WardrobeImagesChanged"/>
                    </Grid>

                    <Grid x:Name="SettingsSystemBottomRow"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <settings:LogMaintenanceSettingsPanel x:Name="LogMaintenancePanel"
                                                              Grid.Column="0"/>
                        <settings:BackupSettingsPanel x:Name="BackupPanel"
                                                      Grid.Column="2"
                                                      BackupImported="BackupPanel_BackupImported"
                                                      RepairMissingImagesRequested="BackupPanel_RepairMissingImagesRequested"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
