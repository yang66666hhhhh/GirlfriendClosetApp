<UserControl x:Class="ClosetApp.UI.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:settings="clr-namespace:ClosetApp.UI.Components.Settings"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        

        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsEyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ThemeCurrentBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ThemeCurrentBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="SettingsStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsActionWrap" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <Style x:Key="SettingsInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="ThemeChoiceButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <TextBlock Text="设置"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,16"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="设置总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="把目录、图片维护、天气和备份集中到一页里，整理和排障都更顺手。"
                                       Style="{StaticResource PageSummaryBodyText}"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="维护"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="图片缓存 · 日志"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="偏好"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="天气城市 · 外观"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="安全"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="备份与恢复"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <UniformGrid Grid.Column="2"
                                     Columns="2"
                                     Rows="2">
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtImageStats" Text="{Binding ImageStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="缓存状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtCacheStats" Text="{Binding CacheStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="默认城市" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock Text="{Binding WeatherCity}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="日志状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtLogStats" Text="{Binding LogStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="全部设置"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="目录、维护、天气和备份都在这一层展开，排查问题时不用来回切页。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingsSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="资源与目录"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文件位置"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="把常用目录集中展示，遇到图片、数据库或缓存问题时能快速定位。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="打开应用目录"
                                            Style="{StaticResource SettingsButton}"
                                            Click="OpenAppDir_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="数据目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtDataDir"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开目录"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenDataDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="定位数据库"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenDatabase_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="图片目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtImagesDir"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开图片"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenImagesDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="打开缓存"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenThumbnailsDir_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <settings:ImageMaintenanceSettingsPanel x:Name="ImageMaintenancePanel"
                                                                WardrobeImagesChanged="ImageMaintenancePanel_WardrobeImagesChanged"/>

                        <Border Style="{StaticResource SettingsSectionCard}" Margin="0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="排障"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="系统日志"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="保留最近 14 天日志，主要用于排查启动、图片处理和数据同步问题。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RefreshStats_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsInsetCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LogStats}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLogDir"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                    <Button Content="打开日志目录"
                                            Style="{StaticResource SettingsButton}"
                                            Click="OpenLogsDir_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理历史日志"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ClearLogs_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <settings:WeatherPreferencesSettingsPanel x:Name="WeatherPreferencesPanel"
                                                                  OutfitsRefreshRequested="WeatherPreferencesPanel_OutfitsRefreshRequested"/>

                        <settings:AppearanceSettingsPanel x:Name="AppearancePanel"
                                                          ThemeChanged="AppearancePanel_ThemeChanged"/>

                        <settings:BackupSettingsPanel x:Name="BackupPanel"
                                                      BackupImported="BackupPanel_BackupImported"
                                                      RepairMissingImagesRequested="BackupPanel_RepairMissingImagesRequested"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
