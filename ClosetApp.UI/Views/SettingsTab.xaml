<UserControl x:Class="ClosetApp.UI.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="72" Margin="64,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="管理数据、图片缓存和应用偏好" Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="64,28,64,60">
            <StackPanel>
                <Border Style="{StaticResource LookbookCard}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="私人衣橱设置中心" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="把存储路径、缓存和主题信息收在一个稳定入口里。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="76" Height="76" CornerRadius="24"
                                Background="{StaticResource PrimaryLightBrush}" Margin="40,0,0,0">
                            <TextBlock Text="⚙" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource LookbookCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="存储位置" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="应用数据保存在本机 LocalAppData，图片和缩略图会单独归档。"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>

                                <TextBlock Text="数据目录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="14" Padding="14,10" Margin="0,6,0,12">
                                    <TextBlock x:Name="TxtDataDir" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <WrapPanel Margin="0,0,0,18">
                                    <Button Content="打开数据目录" Style="{StaticResource CapsuleButton}" Click="OpenDataDir_Click" Margin="0,0,10,0"/>
                                    <Button Content="打开数据库位置" Style="{StaticResource CapsuleButton}" Click="OpenDatabase_Click"/>
                                </WrapPanel>

                                <TextBlock Text="图片目录" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="14" Padding="14,10" Margin="0,6,0,12">
                                    <TextBlock x:Name="TxtImagesDir" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <WrapPanel>
                                    <Button Content="打开图片目录" Style="{StaticResource CapsuleButton}" Click="OpenImagesDir_Click" Margin="0,0,10,0"/>
                                    <Button Content="打开缩略图目录" Style="{StaticResource CapsuleButton}" Click="OpenThumbnailsDir_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LookbookCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="图片缓存" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="清理缩略图不会删除原图；后续需要时可以重新生成。"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtImageStats" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtCacheStats" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource CapsuleButton}" Click="RefreshStats_Click"/>
                                </Grid>
                                <Button Content="清理缩略图缓存" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left" Click="ClearThumbnails_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LookbookCard}">
                            <StackPanel>
                                <TextBlock Text="系统日志" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="日志用于排查启动、图片处理和数据同步问题。默认保留最近 14 天。"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLogStats" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLogDir" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource CapsuleButton}" Click="RefreshStats_Click"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="打开日志目录" Style="{StaticResource CapsuleButton}"
                                            Click="OpenLogsDir_Click" Margin="0,0,10,0"/>
                                    <Button Content="清理历史日志" Style="{StaticResource DangerButton}"
                                            Click="ClearLogs_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource LookbookCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="主题与外观" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="当前使用暖粉色设计系统。主题切换会在后续版本开放。"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
                                <WrapPanel>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,10"/>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource DangerBrush}" Margin="0,0,10,10"/>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SurfaceHeroBrush}" Margin="0,0,10,10"/>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SurfaceCardBrush}" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="18" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="柔和、温暖、低对比" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="适合长期整理衣橱，不抢照片和衣物本身的视觉重点。"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LookbookCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="关于应用" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtVersion" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text=".NET WPF / SQLite / Clean Architecture"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
                                <Button Content="打开应用目录" Style="{StaticResource CapsuleButton}"
                                        HorizontalAlignment="Left" Click="OpenAppDir_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFF8F7"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="数据备份与恢复" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="先提供 JSON 备份和恢复核心数据。恢复会覆盖当前数据库，但不会搬运图片文件。"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,18"/>
                                <WrapPanel>
                                    <Button Content="导出数据备份" Style="{StaticResource CapsuleButton}"
                                            Click="ExportBackup_Click" Margin="0,0,10,10"/>
                                    <Button Content="导入数据备份" Style="{StaticResource DangerButton}"
                                            Click="ImportBackup_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
