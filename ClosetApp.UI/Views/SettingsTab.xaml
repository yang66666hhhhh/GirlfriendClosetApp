<UserControl x:Class="ClosetApp.UI.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:dto="clr-namespace:ClosetApp.Application.DTOs;assembly=ClosetApp.Application">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        

        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsEyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ThemeCurrentBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ThemeCurrentBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="SettingsStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SettingsStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsActionWrap" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <Style x:Key="SettingsInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="ThemeChoiceButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <TextBlock Text="设置"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,16"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="设置总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="把目录、图片维护、天气和备份集中到一页里，整理和排障都更顺手。"
                                       Style="{StaticResource PageSummaryBodyText}"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="维护"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="图片缓存 · 日志"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="偏好"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="天气城市 · 外观"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}" Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="安全"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock Text="备份与恢复"
                                                   Style="{StaticResource PageSummaryValueText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <UniformGrid Grid.Column="2"
                                     Columns="2"
                                     Rows="2">
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtImageStats" Text="{Binding ImageStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="缓存状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtCacheStats" Text="{Binding CacheStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}">
                                <StackPanel>
                                    <TextBlock Text="默认城市" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock Text="{Binding Text, ElementName=TxtWeatherCity}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsStatCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="日志状态" Style="{StaticResource SettingsStatLabel}"/>
                                    <TextBlock x:Name="TxtLogStats" Text="{Binding LogStats}" Style="{StaticResource SettingsStatValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="全部设置"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="目录、维护、天气和备份都在这一层展开，排查问题时不用来回切页。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingsSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="资源与目录"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文件位置"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="把常用目录集中展示，遇到图片、数据库或缓存问题时能快速定位。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="打开应用目录"
                                            Style="{StaticResource SettingsButton}"
                                            Click="OpenAppDir_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="数据目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtDataDir"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开目录"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenDataDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="定位数据库"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenDatabase_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="图片目录" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtImagesDir"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                                <Button Content="打开图片"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenImagesDir_Click"
                                                        Margin="0,0,8,8"/>
                                                <Button Content="打开缓存"
                                                        Style="{StaticResource SettingsButton}"
                                                        Click="OpenThumbnailsDir_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="维护"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="图片资产"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="把缓存、缺失修复和孤儿原图治理收进同一组，减少来回切换。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RefreshStats_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SettingsStatCard}">
                                        <StackPanel>
                                            <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock Text="{Binding ImageStats}" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsStatCard}">
                                        <StackPanel>
                                            <TextBlock Text="缓存体量" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock Text="{Binding CacheStats}" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsStatCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="缺失状态" Style="{StaticResource SettingsStatLabel}"/>
                                            <TextBlock x:Name="TxtMissingImageStats" Text="{Binding MissingImageStats}" Style="{StaticResource SettingsStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="缓存健康" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtThumbnailHealthStats"
                                                       Text="{Binding ThumbnailHealthStats}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="原图治理" Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtOrphanOriginalStats"
                                                       Text="{Binding OrphanOriginalStats}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                    <Button Content="重建缺失缓存"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RebuildThumbnails_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="修复缺失图片"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RepairMissingImages_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理图片缓存"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ClearThumbnails_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理孤儿原图"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="CleanupOrphanOriginals_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionCard}" Margin="0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="排障"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="系统日志"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="保留最近 14 天日志，主要用于排查启动、图片处理和数据同步问题。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RefreshStats_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsInsetCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LogStats}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLogDir"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Style="{StaticResource SettingsActionWrap}">
                                    <Button Content="打开日志目录"
                                            Style="{StaticResource SettingsButton}"
                                            Click="OpenLogsDir_Click"
                                            Margin="0,0,8,8"/>
                                    <Button Content="清理历史日志"
                                            Style="{StaticResource PageToolbarDangerButton}"
                                            Click="ClearLogs_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SettingsSectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="偏好"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="天气与城市"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock Text="默认城市会用于获取实时天气，后续天气穿搭推荐也会直接复用这里。"
                                           Style="{StaticResource PageSectionBodyText}"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtWeatherCity"
                                             Grid.Column="0"
                                             MinHeight="40"
                                             Padding="12,9"
                                             Text="{Binding WeatherCity, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button x:Name="BtnSaveWeatherCity"
                                            Grid.Column="1"
                                            Content="保存"
                                            Style="{StaticResource SettingsButton}"
                                            Click="SaveWeatherCity_Click"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding CanEditWeather}"/>
                                    <Button x:Name="BtnRefreshWeather"
                                            Grid.Column="2"
                                            Content="刷新天气"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RefreshWeather_Click"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding CanEditWeather}"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsInsetCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtWeatherSummary"
                                                   Text="{Binding WeatherSummary}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtWeatherDetails"
                                                   Text="{Binding WeatherDetails}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtWeatherObservedAt"
                                                   Text="{Binding WeatherObservedAt}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"/>
                                        <Border x:Name="WeatherStatusCard"
                                                Style="{StaticResource PageInsetCard}"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                Padding="12"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding IsWeatherStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock x:Name="TxtWeatherStatus"
                                                       Text="{Binding WeatherStatus}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AppearanceSectionCard"
                                Style="{StaticResource SettingsSectionCard}">
                            <StackPanel>
                                <Border x:Name="AppearanceSectionBadge"
                                        Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AppearanceSectionBadgeText"
                                               Text="外观"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="界面与应用"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock Text="把主题调性和应用信息放在同一块，右侧阅读会更顺。"
                                           Style="{StaticResource PageSectionBodyText}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ThemeSelectionPanel"
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="系统配色"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="ThemeRoseCard"
                                                        Grid.Column="0"
                                                        Background="{DynamicResource PrimaryLightBrush}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="14"
                                                        Padding="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="柔粉"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Border x:Name="ThemeRoseCurrentBadge"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource ThemeCurrentBadge}">
                                                                <TextBlock Text="当前使用"
                                                                           Style="{StaticResource ThemeCurrentBadgeText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                            <Border x:Name="ThemeRoseSwatchPrimary" Width="22" Height="22" CornerRadius="11" Background="#FFCA9C9F" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeRoseSwatchSoft" Width="22" Height="22" CornerRadius="11" Background="#FFF7F0EE" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeRoseSwatchSurface" Width="22" Height="22" CornerRadius="11" Background="#FFF9F5F1" Margin="0,0,6,6"/>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="柔和、克制、奶雾粉。"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <Button x:Name="BtnUseRoseTheme"
                                                                Grid.Row="3"
                                                                Content="使用柔粉"
                                                                Style="{StaticResource ThemeChoiceButton}"
                                                                Margin="0,10,0,0"
                                                                Click="UseRoseTheme_Click"/>
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="ThemeBlueCard"
                                                        Grid.Column="2"
                                                        Background="{DynamicResource PrimaryLightBrush}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="14"
                                                        Padding="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="清蓝"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Border x:Name="ThemeBlueCurrentBadge"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource ThemeCurrentBadge}">
                                                                <TextBlock Text="当前使用"
                                                                           Style="{StaticResource ThemeCurrentBadgeText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                            <Border x:Name="ThemeBlueSwatchPrimary" Width="22" Height="22" CornerRadius="11" Background="#FF5881D6" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeBlueSwatchSoft" Width="22" Height="22" CornerRadius="11" Background="#FFE0ECFF" Margin="0,0,6,6"/>
                                                            <Border x:Name="ThemeBlueSwatchSurface" Width="22" Height="22" CornerRadius="11" Background="#FFEBF1FB" Margin="0,0,6,6"/>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="克制、清爽、冷一点。"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <Button x:Name="BtnUseBlueTheme"
                                                                Grid.Row="3"
                                                                Content="使用清蓝"
                                                                Style="{StaticResource ThemeChoiceButton}"
                                                                Margin="0,10,0,0"
                                                                Click="UseBlueTheme_Click"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtThemeSummary"
                                                       Text="{Binding ThemeSummary}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,12,0,0"/>
                                            <TextBlock x:Name="TxtThemeDescription"
                                                       Text="{Binding ThemeDescription}"
                                                       Style="{StaticResource PageMutedBodyText}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="AppearanceAppInfoCard"
                                            Grid.Column="2"
                                            Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="应用信息"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtVersion"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text=".NET WPF / SQLite / Clean Architecture"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <Button x:Name="BtnAppearanceOpenAppDir"
                                                    Content="打开应用目录"
                                                    Style="{StaticResource PageToolbarCapsuleButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,14,0,0"
                                                    Click="OpenAppDir_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionCard}" Margin="0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsEyebrowBadge}"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="安全"
                                               Style="{StaticResource SettingsEyebrowBadgeText}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数据备份与恢复"
                                                   Style="{StaticResource PageSectionTitleText}"/>
                                        <TextBlock Text="导出前先看状态，导入后立刻看到结果和建议，整个闭环会更清楚。"
                                                   Style="{StaticResource PageSectionBodyText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="刷新状态"
                                            Style="{StaticResource SettingsButton}"
                                            Click="RefreshBackupState_Click"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <!-- 导出 -->
                                <Border Style="{StaticResource SettingsInsetCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="导出备份"
                                                   Style="{StaticResource PageFieldLabelText}"/>
                                        <TextBlock Text="建议使用 ZIP 格式保留图片，JSON 仅备份数据。"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10"/>
                                        <WrapPanel>
                                            <Button Content="导出 ZIP 备份包"
                                                    Style="{StaticResource SettingsButton}"
                                                    Click="ExportBackup_Click"
                                                    Margin="0,0,8,8"/>
                                            <Button Content="一键快速导出"
                                                    Style="{StaticResource SettingsButton}"
                                                    Click="QuickExportBackup_Click"
                                                    Margin="0,0,8,8"/>
                                            <Button Content="打开备份目录"
                                                    Style="{StaticResource SettingsButton}"
                                                    Click="OpenBackupsDir_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 导入 -->
                                <Border Style="{StaticResource SettingsInsetCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="导入恢复"
                                                   Style="{StaticResource PageFieldLabelText}"/>
                                        <TextBlock Text="导入会覆盖当前数据，请确认后再操作。"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10"/>
                                        <Button Content="导入备份文件"
                                                Style="{StaticResource PageToolbarDangerButton}"
                                                Click="ImportBackup_Click"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- 状态卡片 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="导出前校验"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtBackupValidation"
                                                       Text="{Binding BackupValidation}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationData"
                                                       Text="{Binding BackupValidationData}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationImages"
                                                       Text="{Binding BackupValidationImages}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtBackupValidationHint"
                                                       Text="{Binding BackupValidationHint}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                            <Border x:Name="BackupValidationWarningCard"
                                                    Style="{StaticResource PageWarningCard}"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding IsBackupValidationWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="导出提醒"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtBackupValidationWarnings"
                                                               Text="{Binding BackupValidationWarnings}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                                        <StackPanel>
                                            <TextBlock Text="最近一次导入"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <TextBlock x:Name="TxtLastImportSummary"
                                                       Text="{Binding LastImportSummary}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="TxtLastImportDetail"
                                                       Text="{Binding LastImportDetail}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Border x:Name="LastImportWarningCard"
                                                    Style="{StaticResource PageWarningCard}"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding IsLastImportWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="建议处理"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtLastImportWarning"
                                                               Text="{Binding LastImportWarning}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                    <Button x:Name="BtnRepairAfterImport"
                                                            Content="立即修复缺失图片"
                                                            Style="{StaticResource SettingsButton}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,10,0,0"
                                                            Click="RepairMissingImages_Click"
                                                            Visibility="{Binding IsRepairAfterImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="LastImportMissingCard"
                                                    Style="{StaticResource PageInsetCard}"
                                                    Background="{DynamicResource SurfacePageBrush}"
                                                    Padding="12"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding IsLastImportMissingCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="缺失图片"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtLastImportMissingFiles"
                                                               Text="{Binding LastImportMissingFiles}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 历史记录 -->
                                <Border Style="{StaticResource SettingsInsetCard}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="备份历史"
                                                       Style="{StaticResource PageFieldLabelText}"/>
                                            <Button Content="清空历史"
                                                    Style="{StaticResource PageToolbarDangerButton}"
                                                    HorizontalAlignment="Right"
                                                    Click="ClearBackupHistory_Click"/>
                                        </DockPanel>

                                        <ItemsControl x:Name="BackupHistoryList"
                                                      ItemsSource="{Binding BackupHistory}"
                                                      Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type dto:BackupHistoryItem}">
                                                    <Border Background="{DynamicResource SurfacePageBrush}"
                                                            CornerRadius="14"
                                                            Padding="12"
                                                            Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding Summary}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           Width="220"/>
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding MetaText}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,6,0,0"/>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding TimestampText}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,4,0,0"/>
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Button Content="打开文件"
                                                                        Style="{StaticResource SettingsButton}"
                                                                        Click="OpenBackupFile_Click"
                                                                        Tag="{Binding FilePath}"
                                                                        Margin="0,0,8,8"/>
                                                                <Button Content="打开目录"
                                                                        Style="{StaticResource SettingsButton}"
                                                                        Click="OpenBackupFolder_Click"
                                                                        Tag="{Binding FilePath}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtBackupHistoryEmpty"
                                                   Text="{Binding BackupHistoryEmptyText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,8,0,0"
                                                   Visibility="{Binding IsBackupHistoryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
