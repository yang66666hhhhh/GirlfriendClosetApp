<UserControl x:Class="ClosetApp.UI.Views.TagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="TagSkySurfaceBrush" Color="{DynamicResource Theme.Sky.Surface}"/>
        <SolidColorBrush x:Key="TagSkyBorderBrush" Color="{DynamicResource Theme.Sky.Border}"/>
        <SolidColorBrush x:Key="TagSkyTextBrush" Color="{DynamicResource Theme.Sky.Text}"/>
        <SolidColorBrush x:Key="TagRoseSurfaceBrush" Color="{DynamicResource Theme.Rose.Surface}"/>
        <SolidColorBrush x:Key="TagRoseBorderBrush" Color="{DynamicResource Theme.Rose.Border}"/>
        <SolidColorBrush x:Key="TagRoseTextBrush" Color="{DynamicResource Theme.Rose.Text}"/>
        <SolidColorBrush x:Key="TagLavenderSurfaceBrush" Color="{DynamicResource Theme.Lavender.Surface}"/>
        <SolidColorBrush x:Key="TagLavenderBorderBrush" Color="{DynamicResource Theme.Lavender.Border}"/>
        <SolidColorBrush x:Key="TagLavenderTextBrush" Color="{DynamicResource Theme.Lavender.Text}"/>
        <SolidColorBrush x:Key="TagMintSurfaceBrush" Color="{DynamicResource Theme.Mint.Surface}"/>
        <SolidColorBrush x:Key="TagMintBorderBrush" Color="{DynamicResource Theme.Mint.Border}"/>
        <SolidColorBrush x:Key="TagMintTextBrush" Color="{DynamicResource Theme.Mint.Text}"/>

        <Style x:Key="TagSkyButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource TagSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TagSkyBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TagSkyTextBrush}"/>
        </Style>

        <Style x:Key="TagRoseButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource TagRoseSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TagRoseBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TagRoseTextBrush}"/>
        </Style>

        <Style x:Key="TagEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource TagLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TagLavenderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TagEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TagLavenderTextBrush}"/>
        </Style>

        <Style x:Key="TagMetaBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
        </Style>

        <Style x:Key="TagMetaBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TagCardItem" TargetType="Border" BasedOn="{StaticResource PageItemCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TagLavenderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource TagSkyBorderBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource Shadow.Card}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagCardTitleText" TargetType="TextBlock" BasedOn="{StaticResource PageItemTitleText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagSkyTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagCardUsageBadge" TargetType="Border" BasedOn="{StaticResource TagMetaBadge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TagSkySurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource TagSkyBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagCardUsageText" TargetType="TextBlock" BasedOn="{StaticResource TagMetaBadgeText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagSkyTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagCardMoreButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoreBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoreBorder" Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
                                <Setter TargetName="MoreBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                <Setter TargetName="MoreBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MoreBorder" Property="Background" Value="{DynamicResource TagSkySurfaceBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}, Path=IsMouseOver}" Value="True">
                                <Setter Property="Opacity" Value="0.56"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagCardMoreMenu" TargetType="ContextMenu" BasedOn="{StaticResource WardrobeCard.MoreMenu}">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Background="Transparent"
                              Margin="6">
                            <Border CornerRadius="12"
                                    Background="#01FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="4"
                                                      Opacity="0.08"
                                                      Color="#564A61"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="#FFFFFFFF"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagCardMoreMenuItem" TargetType="MenuItem" BasedOn="{StaticResource WardrobeCard.MoreMenuItem}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,7,10,7"/>
        </Style>

        <!-- 标签卡片模板 - 风格和场景共用 -->
        <DataTemplate x:Key="TagCardTemplate">
            <Border Style="{StaticResource TagCardItem}"
                    Width="280"
                    Padding="16,14"
                    Margin="0,0,14,14"
                    Tag="{Binding Tag}">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource TagCardMoreMenu}"
                                 ItemContainerStyle="{StaticResource TagCardMoreMenuItem}">
                        <MenuItem Click="EditTag_Click">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="12"
                                             Height="12"
                                             VerticalAlignment="Center">
                                        <Canvas Width="16" Height="16">
                                            <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                  Data="M12.6,1.4 C13.4,0.6 14.6,0.6 15.4,1.4 C16.2,2.2 16.2,3.4 15.4,4.2 L5.1,14.5 L1,15 L1.5,10.9 z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2"
                                               Text="编辑"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Tag="Danger"
                                  Click="DeleteTag_Click">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="12"
                                             Height="12"
                                             VerticalAlignment="Center">
                                        <Canvas Width="16" Height="16">
                                            <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                  Data="M6,1 L10,1 L11,2.2 L14.5,2.2 L14.5,3.6 L1.5,3.6 L1.5,2.2 L5,2.2 z M3,4.6 L13,4.6 L12.3,15 L3.7,15 z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2"
                                               Text="删除"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,10,0">
                            <Border Background="{DynamicResource TagRoseSurfaceBrush}"
                                    BorderBrush="{DynamicResource TagRoseBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6,4">
                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="{Binding Color}"/>
                            </Border>
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource TagCardTitleText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="⋯"
                                Style="{StaticResource TagCardMoreButton}"
                                Tag="{Binding Tag}"
                                ToolTip="管理标签"
                                Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource TagCardMoreMenu}"
                                             ItemContainerStyle="{StaticResource TagCardMoreMenuItem}"
                                             Placement="Bottom"
                                             HorizontalOffset="-2"
                                             VerticalOffset="2">
                                    <MenuItem Click="EditTag_Click">
                                        <MenuItem.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                              Data="M12.6,1.4 C13.4,0.6 14.6,0.6 15.4,1.4 C16.2,2.2 16.2,3.4 15.4,4.2 L5.1,14.5 L1,15 L1.5,10.9 z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="2"
                                                           Text="编辑"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Tag="Danger"
                                              Click="DeleteTag_Click">
                                        <MenuItem.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                              Data="M6,1 L10,1 L11,2.2 L14.5,2.2 L14.5,3.6 L1.5,3.6 L1.5,2.2 L5,2.2 z M3,4.6 L13,4.6 L12.3,15 L3.7,15 z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="2"
                                                           Text="删除"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- 使用统计徽章 -->
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource TagCardUsageBadge}"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding UsageText}"
                                       Style="{StaticResource TagCardUsageText}"/>
                        </Border>
                        <Border CornerRadius="10"
                                Padding="6,3"
                                Background="{DynamicResource TagMintSurfaceBrush}"
                                BorderBrush="{DynamicResource TagMintBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasOutfitUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding OutfitUsageText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TagMintTextBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="标签管理"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="+ 添加标签"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="AddTag_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,40"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- 标签体系概览 -->
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource TagLavenderBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource TagEyebrowBadge}">
                                <TextBlock Text="标签体系"
                                           Style="{StaticResource TagEyebrowBadgeText}"/>
                            </Border>
                            <TextBlock Text="整理你的风格和场景词"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="季节标签（春/夏/秋/冬/四季）由系统管理，会自动应用到衣物筛选和天气推荐。"
                                       Style="{StaticResource PageSummaryBodyText}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding UsageSummaryText}"
                                       Style="{StaticResource PageSummaryBodyText}"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource TagSkySurfaceBrush}"
                                    BorderBrush="{DynamicResource TagSkyBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding StyleCountText}"
                                               Style="{StaticResource PageSummaryValueText}"/>
                                    <TextBlock Text="风格标签"
                                               Style="{StaticResource PageSummaryHintText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource TagRoseSurfaceBrush}"
                                    BorderBrush="{DynamicResource TagRoseBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding SceneCountText}"
                                               Style="{StaticResource PageSummaryValueText}"/>
                                    <TextBlock Text="场景标签"
                                               Style="{StaticResource PageSummaryHintText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 筛选区域 -->
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,14"
                        Padding="16,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="筛选标签"
                                           Style="{StaticResource PageSummaryTitleText}"/>
                                <TextBlock Text="按名称、分类或使用状态缩小范围，快速找到需要处理的标签。"
                                           Style="{StaticResource PageSummaryBodyText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="清除筛选"
                                    Style="{StaticResource PageToolbarCapsuleButton}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="ClearFilters_Click"/>
                        </Grid>

                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Width="240"
                                        Margin="0,0,10,8">
                                <TextBlock Text="搜索"
                                           Style="{StaticResource PageFieldLabelText}"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Padding="12,9"
                                         Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Width="140"
                                        Margin="0,0,10,8">
                                <TextBlock Text="分类"
                                           Style="{StaticResource PageFieldLabelText}"/>
                                <ComboBox x:Name="CategoryFilterComboBox"
                                          MinHeight="36"
                                          Margin="0,6,0,0"
                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="全部分类"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="风格标签"
                                                  Tag="Style"/>
                                    <ComboBoxItem Content="场景标签"
                                                  Tag="Scene"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Width="140"
                                        Margin="0,0,10,8">
                                <TextBlock Text="使用状态"
                                           Style="{StaticResource PageFieldLabelText}"/>
                                <ComboBox x:Name="UsageFilterComboBox"
                                          MinHeight="36"
                                          Margin="0,6,0,0"
                                          SelectionChanged="UsageFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="全部状态"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="正在使用"
                                                  Tag="Used"/>
                                    <ComboBoxItem Content="未使用"
                                                  Tag="Unused"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="{Binding FilterSummary}"
                                   Style="{StaticResource PageSummaryBodyText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 排序和统计 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CollectionSectionTitle}"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="{Binding CollectionSectionBody}"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Width="140"
                                VerticalAlignment="Top">
                        <TextBlock Text="排序"
                                   Style="{StaticResource PageFieldLabelText}"
                                   HorizontalAlignment="Left"/>
                        <ComboBox x:Name="SortComboBox"
                                  MinWidth="130"
                                  Margin="0,6,0,0"
                                  SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem Content="常用优先"
                                          Tag="MostUsed"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="名称排序"
                                          Tag="Name"/>
                            <ComboBoxItem Content="未使用优先"
                                          Tag="LeastUsed"/>
                            <ComboBoxItem Content="最近添加"
                                          Tag="Newest"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 筛选结果为空提示 -->
                <Border Style="{StaticResource PageInsetCard}"
                        Margin="0,0,0,12"
                        Padding="16,14"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="没有找到符合条件的标签"
                                   Style="{StaticResource PageSummaryTitleText}"/>
                        <TextBlock Text="换个关键词试试，或者先把筛选条件清掉。"
                                   Style="{StaticResource PageSummaryBodyText}"/>
                        <Button Content="清除筛选"
                                Style="{StaticResource PageToolbarCapsuleButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="ClearFilters_Click"/>
                    </StackPanel>
                </Border>

                <!-- 风格标签区域 -->
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,14"
                        Padding="16,14"
                        Visibility="{Binding ShowStyleSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="风格标签"
                                           Style="{StaticResource PageSummaryTitleText}"/>
                                <TextBlock Text="描述衣物的气质和风格，如「简约」「甜美」「复古」等。"
                                           Style="{StaticResource PageSummaryBodyText}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource TagLavenderSurfaceBrush}"
                                    BorderBrush="{DynamicResource TagLavenderBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding StyleTags.Count, StringFormat={}{0} 个}"
                                           Style="{StaticResource PageSummaryValueText}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding StyleTags}"
                                      ItemTemplate="{StaticResource TagCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 场景标签区域 -->
                <Border Style="{StaticResource PageSummaryCard}"
                        Padding="16,14"
                        Visibility="{Binding ShowSceneSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="场景标签"
                                           Style="{StaticResource PageSummaryTitleText}"/>
                                <TextBlock Text="描述衣物适合的场合，如「通勤」「约会」「运动」等。"
                                           Style="{StaticResource PageSummaryBodyText}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource TagSkySurfaceBrush}"
                                    BorderBrush="{DynamicResource TagSkyBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SceneTags.Count, StringFormat={}{0} 个}"
                                           Style="{StaticResource PageSummaryValueText}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SceneTags}"
                                      ItemTemplate="{StaticResource TagCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="🏷"
                           Title="还没有标签"
                           Body="创建风格和场景标签，让衣物管理更有条理。"
                           ActionText="+ 添加标签"
                           ActionClicked="AddTag_Click"/>
    </Grid>
</UserControl>
