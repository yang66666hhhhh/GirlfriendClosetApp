<UserControl x:Class="ClosetApp.UI.Views.TagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="标签管理"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="+ 添加标签"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="AddTag_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="标签总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="{Binding CategorySummaryText}"
                                       Style="{StaticResource PageSummaryBodyText}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource PageSummaryBadge}"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding TagCountText}"
                                           Style="{StaticResource PageSummaryValueText}"/>
                                <TextBlock Text="当前标签库"
                                           Style="{StaticResource PageSummaryHintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="全部标签"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="优先整理风格词，其次再补场景和季节。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource PageSummaryBadge}"
                            VerticalAlignment="Center"
                            Padding="9,6"
                            Margin="12,0,0,0">
                        <TextBlock Text="{Binding TagCountText}"
                                   Style="{StaticResource PageSummaryValueText}"/>
                    </Border>
                </Grid>

                <ItemsControl x:Name="TagsList"
                              ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PageItemCard}"
                                    Cursor="Hand" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="编辑" Click="EditTag_Click"/>
                                        <MenuItem Header="删除" Click="DeleteTag_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource PageItemTitleText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="🏷"
                           Title="还没有标签"
                           Body="先创建几个风格词，衣柜和搭配都会更好用。"
                           ActionText="+ 添加标签"
                           ActionClicked="AddTag_Click"/>
    </Grid>
</UserControl>
