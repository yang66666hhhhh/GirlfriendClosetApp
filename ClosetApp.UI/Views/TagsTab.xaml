<UserControl x:Class="ClosetApp.UI.Views.TagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="标签管理"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="+ 添加标签"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="AddTag_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="标签总览" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CategorySummaryText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource PageSummaryBadge}"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding TagCountText}"
                                           Style="{StaticResource PageSummaryValueText}"/>
                                <TextBlock Text="当前标签库"
                                           Style="{StaticResource PageSummaryHintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl x:Name="TagsList"
                              ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18" Padding="16,10" Margin="0,0,10,10"
                                    Cursor="Hand" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="编辑" Click="EditTag_Click"/>
                                        <MenuItem Header="删除" Click="DeleteTag_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="TxtEmpty" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="🏷" FontSize="52" HorizontalAlignment="Center" Opacity="0.55"/>
            <TextBlock Text="还没有标签"
                       Style="{StaticResource EmptyStateTitleText}"
                       Margin="0,18,0,0"/>
            <TextBlock Text="先创建一个风格标签吧"
                       Style="{StaticResource EmptyStateBodyText}"/>
            <Button Content="+ 添加标签"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Click="AddTag_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
