<UserControl x:Class="ClosetApp.UI.Views.TagsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="TagSkySurfaceBrush" Color="{DynamicResource Theme.Sky.Surface}"/>
        <SolidColorBrush x:Key="TagSkyBorderBrush" Color="{DynamicResource Theme.Sky.Border}"/>
        <SolidColorBrush x:Key="TagSkyTextBrush" Color="{DynamicResource Theme.Sky.Text}"/>
        <SolidColorBrush x:Key="TagRoseSurfaceBrush" Color="{DynamicResource Theme.Rose.Surface}"/>
        <SolidColorBrush x:Key="TagRoseBorderBrush" Color="{DynamicResource Theme.Rose.Border}"/>
        <SolidColorBrush x:Key="TagRoseTextBrush" Color="{DynamicResource Theme.Rose.Text}"/>
        <SolidColorBrush x:Key="TagLavenderSurfaceBrush" Color="{DynamicResource Theme.Lavender.Surface}"/>
        <SolidColorBrush x:Key="TagLavenderBorderBrush" Color="{DynamicResource Theme.Lavender.Border}"/>
        <SolidColorBrush x:Key="TagLavenderTextBrush" Color="{DynamicResource Theme.Lavender.Text}"/>

        <Style x:Key="TagSkyButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource TagSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TagSkyBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TagSkyTextBrush}"/>
        </Style>

        <Style x:Key="TagEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource TagLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TagLavenderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TagEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TagLavenderTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfacePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="标签管理"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="+ 添加标签"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="AddTag_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,60"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,16"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource TagLavenderBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource TagEyebrowBadge}">
                                <TextBlock Text="标签体系"
                                           Style="{StaticResource TagEyebrowBadgeText}"/>
                            </Border>
                            <TextBlock Text="标签总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="{Binding CategorySummaryText}"
                                       Style="{StaticResource PageSummaryBodyText}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource PageSummaryBadge}"
                                Background="{StaticResource TagSkySurfaceBrush}"
                                BorderBrush="{StaticResource TagSkyBorderBrush}"
                                BorderThickness="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding TagCountText}"
                                           Style="{StaticResource PageSummaryValueText}"/>
                                <TextBlock Text="当前标签库"
                                           Style="{StaticResource PageSummaryHintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource TagEyebrowBadge}">
                            <TextBlock Text="风格词库"
                                       Style="{StaticResource TagEyebrowBadgeText}"/>
                        </Border>
                        <TextBlock Text="全部标签"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="优先整理风格词，其次再补场景和季节。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource PageSummaryBadge}"
                            Background="{StaticResource TagRoseSurfaceBrush}"
                            BorderBrush="{StaticResource TagRoseBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Padding="9,6"
                            Margin="12,0,0,0">
                        <TextBlock Text="{Binding TagCountText}"
                                   Style="{StaticResource PageSummaryValueText}"/>
                    </Border>
                </Grid>

                <ItemsControl x:Name="TagsList"
                              ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PageItemCard}"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource TagLavenderBorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="编辑" Click="EditTag_Click"/>
                                        <MenuItem Header="删除" Click="DeleteTag_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource TagRoseSurfaceBrush}"
                                            BorderBrush="{StaticResource TagRoseBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource PageItemTitleText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="🏷"
                           Title="还没有标签"
                           Body="先创建几个风格词，衣柜和搭配都会更好用。"
                           ActionText="+ 添加标签"
                           ActionClicked="AddTag_Click"/>
    </Grid>
</UserControl>
