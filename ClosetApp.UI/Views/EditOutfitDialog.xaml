<Window x:Class="ClosetApp.UI.Views.EditOutfitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑穿搭" Width="800" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <TextBlock Text="搭配名称" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtName" Padding="12" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="场景" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbScene">
                            <ComboBoxItem Content="上班" Tag="Work"/>
                            <ComboBoxItem Content="约会" Tag="Date"/>
                            <ComboBoxItem Content="出游" Tag="Travel"/>
                            <ComboBoxItem Content="派对" Tag="Party"/>
                            <ComboBoxItem Content="休闲" Tag="Casual"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="季节" FontSize="14" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbSeason">
                            <ComboBoxItem Content="春" Tag="Spring"/>
                            <ComboBoxItem Content="夏" Tag="Summer"/>
                            <ComboBoxItem Content="秋" Tag="Autumn"/>
                            <ComboBoxItem Content="冬" Tag="Winter"/>
                            <ComboBoxItem Content="四季" Tag="AllSeason"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="满意度" FontSize="14" Margin="0,0,0,8"/>
                <hc:Rate x:Name="RatingControl" Count="5" Value="3" Foreground="#fbbf24" FontSize="24" Margin="0,0,0,24"/>

                <TextBlock Text="选择衣服" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl x:Name="ClothesSelection">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Padding="20">
            <StackPanel>
                <TextBlock Text="实时预览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Border Background="#f5f5f5" CornerRadius="12" MinHeight="300">
                    <Grid>
                        <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="选择衣服查看预览" FontSize="14" Foreground="#999" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="PreviewItems" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Button Content="保存修改" Margin="0,20,0,0" Padding="16" Click="Save_Click"/>
                <Button Content="取消" Margin="0,8,0,0" Padding="16" Background="#f5f5f5" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>