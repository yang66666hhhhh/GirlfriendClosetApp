<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="#FFF8F6F2">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:OutfitSeasonToIconConverter x:Key="SeasonToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>

        <Color x:Key="PageBg">#FFF8F6F2</Color>
        <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBg}"/>
        <Color x:Key="CardBg">#FFFFFDFC</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
        <Color x:Key="SecondaryBg">#FFF5F3EE</Color>
        <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBg}"/>
        <Color x:Key="BorderC">#FFE8E2DC</Color>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderC}"/>
        <Color x:Key="TextPrimary">#FF2D2A26</Color>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <Color x:Key="TextSecondary">#FF5E5A56</Color>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <Color x:Key="TextTertiary">#FFA39B95</Color>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
        <Color x:Key="Accent">#FFD9A299</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <Color x:Key="Danger">#FFE88D8D</Color>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

        <!-- Outfit Card Template -->
        <DataTemplate x:Key="OutfitCardTemplate">
            <Border Width="280" Margin="8"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="16" Padding="16" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.07" Color="#000" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Preview area -->
                    <Border Height="140" Background="{StaticResource SecondaryBgBrush}"
                            CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                        <Grid>
                            <!-- Grid lines for outfit layout -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" CornerRadius="10,0,0,0"/>
                            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" CornerRadius="0,10,0,0"/>
                            <Border Grid.Column="0" Grid.Row="2" Background="{StaticResource SecondaryBgBrush}" CornerRadius="0,0,0,10"/>
                            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource SecondaryBgBrush}" CornerRadius="0,0,10,0"/>
                            <Rectangle Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Fill="{StaticResource BorderBrush}"/>
                            <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Fill="{StaticResource BorderBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Name -->
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                    <!-- Meta -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding Scene, Converter={StaticResource SceneToIconConverter}}"
                              Fill="{StaticResource AccentBrush}" Width="14" Height="14"
                              Stretch="Uniform" VerticalAlignment="Center"/>
                        <Path Data="{Binding Season, Converter={StaticResource SeasonToIconConverter}}"
                              Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14"
                              Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WearCount}" FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="编辑" Padding="12,7" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Click="EditOutfit_Click"/>
                        <Button Content="删除" Padding="12,7" FontSize="12"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteOutfit_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PageBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="72" Margin="64,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="我的搭配" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Grid.Column="1" Content="创建搭配"
                        Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Click="CreateOutfit_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="56,20">
            <ItemsControl x:Name="OutfitsList"
                          ItemTemplate="{StaticResource OutfitCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <TextBlock x:Name="TxtEmpty" Grid.Row="1"
                   Text="还没有搭配，点击「创建搭配」开始"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Foreground="{StaticResource TextTertiaryBrush}"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
