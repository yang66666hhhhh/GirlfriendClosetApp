<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="{StaticResource SurfacePageBrush}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>

        <DataTemplate x:Key="OutfitCardTemplate">
            <outfit:OutfitCard Margin="12" Outfit="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Key="WeatherRecommendationTemplate">
            <Border Background="{StaticResource SurfaceElevatedBrush}"
                    CornerRadius="12"
                    Padding="12,10"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Season, Converter={StaticResource SeasonToName}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding WearCount, StringFormat=已穿 {0} 次}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="我的搭配"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+ 新建今日搭配"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="CreateOutfit_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,48"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,12"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.45*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="搭配总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="先看今天适合穿什么，再按需展开记录和日历。"
                                       Style="{StaticResource PageSummaryBodyText}"/>

                            <WrapPanel Margin="0,7,0,0">
                                <Border Background="{StaticResource SurfaceSectionBrush}"
                                        Style="{StaticResource PageSummaryBadge}"
                                        Padding="9,6"
                                        Margin="0,0,6,4">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtOutfitCount"
                                                   Text="{Binding OutfitCountText}"
                                                   Style="{StaticResource PageSummaryValueText}"/>
                                        <TextBlock Text="当前收藏"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        Style="{StaticResource PageSummaryBadge}"
                                        Padding="9,6"
                                        Margin="0,0,6,4">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtHistoryQuick"
                                                   Text="{Binding HistoryQuickText}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="穿着时间线"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,5,0,0">
                                <Button Content="刷新天气推荐"
                                        Style="{StaticResource PageToolbarCapsuleButton}"
                                        Click="RefreshWeatherRecommendations_Click"
                                        Margin="0,0,6,0"
                                        />
                                <Button x:Name="ToggleHistoryButton"
                                        Content="{Binding HistoryToggleText}"
                                        Style="{StaticResource PageToolbarCapsuleButton}"
                                        Click="ToggleHistory_Click"
                                        Margin="0,0,6,0"
                                        />
                                <Button Content="去设置城市"
                                        Style="{StaticResource PageToolbarCapsuleButton}"
                                        Click="OpenSettings_Click"
                                        />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource SurfaceSectionBrush}"
                                    CornerRadius="12"
                                    Padding="11,9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="今日天气"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9"/>
                                            <TextBlock Text="{Binding WeatherCompactSummaryText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding WeatherCityCompactText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource SurfacePageBrush}"
                                                CornerRadius="9"
                                                Padding="8,5"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="推荐"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="8"/>
                                                <TextBlock Text="{Binding WeatherRecommendationCountText}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ContentControl Content="{Binding PrimaryWeatherRecommendation}"
                                                    ContentTemplate="{StaticResource WeatherRecommendationTemplate}"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding PrimaryWeatherRecommendation, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="按当前天气暂时没有更合适的搭配。"
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               FontSize="9"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding PrimaryWeatherRecommendation, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HistoryPanel"
                        Style="{StaticResource LookbookCard}"
                        Margin="0,0,0,24"
                        Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最近穿着"
                                       Style="{StaticResource PageSectionTitleText}"/>
                            <TextBlock x:Name="TxtHistorySummary"
                                       Text="{Binding HistorySummaryText}"
                                       Style="{StaticResource PageSectionBodyText}"
                                       Margin="0,6,0,16"/>
                            <ItemsControl x:Name="RecentWornList"
                                          ItemsSource="{Binding RecentWornRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceElevatedBrush}"
                                                CornerRadius="16"
                                                Padding="14,10"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding OutfitName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="穿搭日历"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock x:Name="TxtCalendarSummary"
                                           Text="{Binding CalendarSummaryText}"
                                           Style="{StaticResource PageSectionBodyText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Style="{StaticResource CapsuleButton}"
                                        MinWidth="42" Padding="12,8" Click="PrevMonth_Click"/>
                                <TextBlock x:Name="TxtCalendarMonth"
                                           Text="{Binding CalendarMonthText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                                <Button Content="›" Style="{StaticResource CapsuleButton}"
                                        MinWidth="42" Padding="12,8" Click="NextMonth_Click"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,8">
                            <TextBlock Text="一" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="二" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="三" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="四" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="五" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="六" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="日" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>

                        <ItemsControl x:Name="CalendarDaysList"
                                      ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="82"
                                            CornerRadius="16"
                                            Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CalendarDay_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRecords}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DayText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CountText}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding FirstOutfitName}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="全部搭配"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="悬停卡片可编辑、删除或快速记录「今天穿了」。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="OutfitsList"
                              ItemsSource="{Binding Outfits}"
                              ItemTemplate="{StaticResource OutfitCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="👗"
                           Title="还没有搭配"
                           Body="今天从一套简单的开始吧"
                           ActionText="+ 新建今日搭配"
                           ActionClicked="CreateOutfit_Click"/>
    </Grid>
</UserControl>
