<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="#FFF8F6F2">

    <UserControl.Resources>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>

        <DataTemplate x:Key="OutfitCardTemplate">
            <outfit:OutfitCard Margin="12"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFF8F6F2"
                BorderBrush="#FFE8E2DC" BorderThickness="0,0,0,1">
            <Grid Height="72" Margin="64,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="我的搭配" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="#FF2D2A26"/>
                <Button Grid.Column="1" Content="创建搭配"
                        Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Click="CreateOutfit_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="44,20">
            <ItemsControl x:Name="OutfitsList"
                          ItemTemplate="{StaticResource OutfitCardTemplate}"
                          Loaded="OutfitsList_Loaded">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <TextBlock x:Name="TxtEmpty" Grid.Row="1"
                   Text="还没有搭配，点击「创建搭配」开始"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Foreground="#FFA39B95"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
