<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="{StaticResource SurfacePageBrush}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>

        <DataTemplate x:Key="OutfitCardTemplate">
            <outfit:OutfitCard Margin="12" Outfit="{Binding}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="72" Margin="64,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="我的搭配" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="像翻 Lookbook 一样整理日常穿搭" Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ 新建今日搭配"
                        Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Click="CreateOutfit_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="64,28,64,60"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource LookbookCard}"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="搭配灵感库" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="先看搭配，再按需展开记录和日历。页面不抢戏，衣服才是主角。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                            <Border Background="{StaticResource SurfaceSectionBrush}"
                                    CornerRadius="18"
                                    Padding="16,10"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOutfitCount"
                                               Text="{Binding OutfitCountText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="当前收藏"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="18"
                                    Padding="16,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHistoryQuick"
                                               Text="{Binding HistoryQuickText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="穿着时间线"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="ToggleHistoryButton"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Content="{Binding HistoryToggleText}"
                                Style="{StaticResource CapsuleButton}"
                                HorizontalAlignment="Left"
                                Margin="0,22,0,0"
                                Click="ToggleHistory_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="HistoryPanel"
                        Style="{StaticResource LookbookCard}"
                        Margin="0,0,0,24"
                        Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最近穿着" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtHistorySummary"
                                       Text="{Binding HistorySummaryText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" Margin="0,6,0,16"/>
                            <ItemsControl x:Name="RecentWornList"
                                          ItemsSource="{Binding RecentWornRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceElevatedBrush}"
                                                CornerRadius="16"
                                                Padding="14,10"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding OutfitName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="穿搭日历" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtCalendarSummary"
                                           Text="{Binding CalendarSummaryText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Style="{StaticResource CapsuleButton}"
                                        MinWidth="42" Padding="12,8" Click="PrevMonth_Click"/>
                                <TextBlock x:Name="TxtCalendarMonth"
                                           Text="{Binding CalendarMonthText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                                <Button Content="›" Style="{StaticResource CapsuleButton}"
                                        MinWidth="42" Padding="12,8" Click="NextMonth_Click"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,8">
                            <TextBlock Text="一" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="二" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="三" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="四" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="五" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="六" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="日" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>

                        <ItemsControl x:Name="CalendarDaysList"
                                      ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="82"
                                            CornerRadius="16"
                                            Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CalendarDay_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRecords}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DayText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CountText}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding FirstOutfitName}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="全部搭配"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="悬停卡片可编辑、删除或快速记录「今天穿了」。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="+ 新建"
                            Style="{StaticResource CapsuleButton}"
                            VerticalAlignment="Center"
                            Click="CreateOutfit_Click"/>
                </Grid>

                <ItemsControl x:Name="OutfitsList"
                              ItemsSource="{Binding Outfits}"
                              ItemTemplate="{StaticResource OutfitCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:Name="TxtEmpty" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="👗" FontSize="52" HorizontalAlignment="Center" Opacity="0.55"/>
            <TextBlock Text="还没有搭配"
                       Style="{StaticResource EmptyStateTitleText}"
                       Margin="0,18,0,0"/>
            <TextBlock Text="今天从一套简单的开始吧"
                       Style="{StaticResource EmptyStateBodyText}"/>
            <Button Content="+ 新建今日搭配"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Click="CreateOutfit_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
