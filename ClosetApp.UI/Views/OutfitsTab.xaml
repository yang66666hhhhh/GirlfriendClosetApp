<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:ClosetApp.UI.Components"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:OutfitSortByLabelConverter x:Key="OutfitSortByLabelConverter"/>
        <DataTemplate x:Key="OutfitFilterOptionTemplate">
            <TextBlock Text="{Binding Label}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{DynamicResource FontSize.Hint}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <SolidColorBrush x:Key="OutfitSkySurfaceBrush" Color="{DynamicResource Theme.Sky.Surface}"/>
        <SolidColorBrush x:Key="OutfitSkyBorderBrush" Color="{DynamicResource Theme.Sky.Border}"/>
        <SolidColorBrush x:Key="OutfitSkyTextBrush" Color="{DynamicResource Theme.Sky.Text}"/>
        <SolidColorBrush x:Key="OutfitMintSurfaceBrush" Color="{DynamicResource Theme.Mint.Surface}"/>
        <SolidColorBrush x:Key="OutfitMintBorderBrush" Color="{DynamicResource Theme.Mint.Border}"/>
        <SolidColorBrush x:Key="OutfitMintTextBrush" Color="{DynamicResource Theme.Mint.Text}"/>
        <SolidColorBrush x:Key="OutfitLavenderSurfaceBrush" Color="{DynamicResource Theme.Lavender.Surface}"/>
        <SolidColorBrush x:Key="OutfitLavenderBorderBrush" Color="{DynamicResource Theme.Lavender.Border}"/>
        <SolidColorBrush x:Key="OutfitLavenderTextBrush" Color="{DynamicResource Theme.Lavender.Text}"/>

        <Style x:Key="OutfitSkyButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitSkyBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitSkyTextBrush}"/>
        </Style>

        <Style x:Key="OutfitMintButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitMintSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitMintBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitMintTextBrush}"/>
        </Style>

        <Style x:Key="OutfitLavenderButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitLavenderBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitLavenderTextBrush}"/>
        </Style>

        <Style x:Key="WeatherRecommendationCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="MinHeight" Value="138"/>
        </Style>

        <Style x:Key="WeatherRecommendationChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OutfitSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitSkyBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="WeatherRecommendationChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OutfitSkyTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Tiny}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CandidateIndexChip" TargetType="Border" BasedOn="{StaticResource WeatherRecommendationChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirstCandidate}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OutfitLavenderSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OutfitLavenderBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFirstCandidate}" Value="False">
                    <Setter Property="Background" Value="{StaticResource OutfitMintSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OutfitMintBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidateIndexChipText" TargetType="TextBlock" BasedOn="{StaticResource WeatherRecommendationChipText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirstCandidate}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OutfitLavenderTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFirstCandidate}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource OutfitMintTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeatherRecommendationMetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
        </Style>

        <Style x:Key="RecommendationStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource OutfitSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitSkyBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RecommendationStatusBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OutfitSkyTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Tiny}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RecommendationActionHintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TodayHeroStatusPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="TodayHeroSecondaryActionButton" TargetType="Button" BasedOn="{StaticResource CapsuleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TodayHeroLinkButton" TargetType="Button" BasedOn="{StaticResource TodayHeroSecondaryActionButton}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Tiny}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TodayHeroFooterRail" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TodayHeroMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TodayHeroToolDivider" TargetType="TextBlock">
            <Setter Property="Text" Value="·"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <LinearGradientBrush x:Key="TodayHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Surface.Hero}" Offset="0"/>
            <GradientStop Color="{DynamicResource Surface.Modal}" Offset="0.48"/>
            <GradientStop Color="{DynamicResource Primary.Light}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TodayHeroAtmosphereBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="{DynamicResource Primary.Glow}" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TodayHeroInlineActionButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="SecondaryRecommendationActionButton" TargetType="Button" BasedOn="{StaticResource OutfitSkyButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="SecondaryRecommendationDetailButton" TargetType="Button" BasedOn="{StaticResource TodayHeroSecondaryActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Tiny}"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>

        <Style x:Key="OutfitToolbarLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="OutfitCardTemplate">
            <outfit:OutfitCard Outfit="{Binding}"
                               DisplayMode="{Binding DataContext.CardDisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CardClicked="OutfitCard_CardClicked"
                               EditClicked="OutfitCard_EditClicked"
                               DeleteClicked="OutfitCard_DeleteClicked"
                               FavoriteToggled="OutfitCard_FavoriteToggled"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                     <TextBlock Text="我的搭配"
                                FontSize="{DynamicResource FontSize.Body}"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center"/>
                    <Border Width="1"
                            Height="16"
                            Background="{DynamicResource BorderDividerBrush}"
                            Margin="16,0"
                            VerticalAlignment="Center"/>
                    <Button Content="数据洞察"
                            Style="{StaticResource PageToolbarCapsuleButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Command="{Binding ShowWardrobeInsightsCommand}"/>
                    <Button Content="年度报告"
                            Style="{StaticResource PageToolbarCapsuleButton}"
                            Padding="12,6"
                            Command="{Binding ShowAnnualReportCommand}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="+ 新建今日搭配"
                        Style="{StaticResource PageToolbarPrimaryButton}"
                        Click="CreateOutfit_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,30"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Border Background="{StaticResource TodayHeroBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.24*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Border x:Name="TodayHeroCardHost"
                                        Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="18,16"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <Grid x:Name="TodayHeroCardGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="224"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="TodayHeroInfoColumn"
                                              Grid.Column="0"
                                              Margin="0,0,14,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding WeatherCompactSummaryText}"
                                                               Foreground="{StaticResource OutfitSkyTextBrush}"
                                                               Style="{StaticResource TodayHeroMetaText}"/>
                                                    <Border Width="1"
                                                            Height="12"
                                                            Background="{DynamicResource BorderDividerBrush}"
                                                            Margin="10,0"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding WeatherCityCompactText}"
                                                               Style="{StaticResource TodayHeroMetaText}"/>
                                                    <Border Width="1"
                                                            Height="12"
                                                            Background="{DynamicResource BorderDividerBrush}"
                                                            Margin="10,0"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TodayWornStatusText}"
                                                               Style="{StaticResource TodayHeroMetaText}"/>
                                                </StackPanel>

                                                <TextBlock Text="今天穿什么"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="{DynamicResource FontSize.Input}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,12,0,0"/>

                                                <TextBlock Text="{Binding TodayHeroRecommendationNameText}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="{DynamicResource FontSize.Hero}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="500"/>

                                                <TextBlock Text="{Binding TodayHeroRecommendationSupportText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource FontSize.Hint}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="490"
                                                           MaxHeight="40"/>

                                                <Border x:Name="TodayHeroStatusPanelHost"
                                                        Style="{StaticResource TodayHeroStatusPanel}">
                                                    <StackPanel>
                                                        <WrapPanel Visibility="{Binding HasRecommendationReadiness, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Border Style="{StaticResource RecommendationStatusBadge}"
                                                                    Margin="0,0,8,6">
                                                                <TextBlock Text="{Binding RecommendationReadinessBadgeText}"
                                                                           Style="{StaticResource RecommendationStatusBadgeText}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource RecommendationStatusBadge}"
                                                                    Margin="0,0,0,6"
                                                                    Background="{StaticResource OutfitMintSurfaceBrush}"
                                                                    BorderBrush="{StaticResource OutfitMintBorderBrush}">
                                                                <TextBlock Text="{Binding RecommendationReadinessTitle}"
                                                                           Style="{StaticResource RecommendationStatusBadgeText}"
                                                                           Foreground="{StaticResource OutfitMintTextBrush}"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <TextBlock Text="{Binding TodayHeroStatusSummaryText}"
                                                                   Style="{StaticResource RecommendationActionHintText}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="34"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Border Grid.Row="1"
                                                    Background="Transparent"
                                                    MinHeight="18"/>

                                            <StackPanel x:Name="TodayHeroActionsPanel"
                                                        Grid.Row="2"
                                                        VerticalAlignment="Bottom">
                                                <Grid x:Name="TodayHeroPrimaryActionRow">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="{Binding TodayHeroPrimaryActionText}"
                                                            Grid.Column="0"
                                                            Style="{StaticResource OutfitMintButton}"
                                                            Padding="16,9"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding RecordRecommendedOutfitWornCommand}"
                                                            CommandParameter="{Binding PrimaryWeatherRecommendation}"
                                                            Click="TodayHeroPrimaryAction_Click"/>
                                                    <Button Content="{Binding RefreshWeatherButtonText}"
                                                            Grid.Column="1"
                                                            Style="{StaticResource TodayHeroInlineActionButton}"
                                                            Command="{Binding RefreshWeatherRecommendationsWithFeedbackCommand}"
                                                            IsEnabled="{Binding CanRefreshWeatherRecommendations}"/>
                                                </Grid>

                                                <WrapPanel x:Name="TodayHeroFooterRailHost"
                                                           Style="{StaticResource TodayHeroFooterRail}">
                                                    <Button Content="查看记录"
                                                            Style="{StaticResource TodayHeroLinkButton}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Click="OpenOutfitHistory_Click"/>
                                                    <TextBlock Style="{StaticResource TodayHeroToolDivider}"/>
                                                    <Button Content="推荐详情"
                                                            Style="{StaticResource TodayHeroLinkButton}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding ShowRecommendationDebugCommand}"/>
                                                    <TextBlock Style="{StaticResource TodayHeroToolDivider}"
                                                               Visibility="{Binding HasRecommendationGap, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Content="调偏好"
                                                            Style="{StaticResource TodayHeroLinkButton}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasRecommendationGap, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Click="OpenSettings_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SurfaceHeroBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="10"
                                                MinHeight="332">
                                            <Grid>
                                                <Grid Visibility="{Binding HasPrimaryWeatherRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <outfit:OutfitPreviewCanvas Clothes="{Binding PrimaryWeatherRecommendation.PreviewClothes}"
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Center"/>
                                                </Grid>

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0"
                                                            Visibility="{Binding HasPrimaryWeatherRecommendation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="今天还没有合适推荐"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TodayHeroCompactSummaryText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Meta}"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center"
                                                               MaxWidth="148"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="SecondaryRecommendationRail"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Height="{Binding ElementName=TodayHeroCardHost, Path=ActualHeight}"
                                    MinHeight="332"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding HasSecondaryWeatherRecommendations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <ItemsControl x:Name="SecondaryRecommendationCardsHost"
                                                  ItemsSource="{Binding SecondaryWeatherRecommendationCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid x:Name="SecondaryRecommendationCardsPanel">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                </Grid>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayIndex}" Value="1">
                                                        <Setter Property="Grid.Row" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WeatherRecommendationCard}"
                                                        Margin="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Background="{DynamicResource SurfaceHeroBrush}"
                                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="10"
                                                                VerticalAlignment="Stretch">
                                                            <outfit:OutfitPreviewCanvas Clothes="{Binding PreviewClothes}"/>
                                                        </Border>

                                                        <Grid Grid.Column="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <WrapPanel x:Name="SecondaryRecommendationTagRail"
                                                                       MaxHeight="24"
                                                                       Margin="0,2,0,0">
                                                                <Border Style="{StaticResource CandidateIndexChip}"
                                                                        Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding CandidateIndexLabel}"
                                                                               Style="{StaticResource CandidateIndexChipText}"/>
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding CandidateDisplayTags}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="8"
                                                                                    Margin="0,0,6,0"
                                                                                    Padding="7,3">
                                                                                <TextBlock Text="{Binding}"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           FontSize="{DynamicResource FontSize.Tiny}"
                                                                                           FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="8,3"
                                                                        Margin="0,0,0,0">
                                                                    <TextBlock Text="{Binding WearSummaryText}"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               FontSize="{DynamicResource FontSize.Tiny}"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>
                                                            </WrapPanel>

                                                            <StackPanel x:Name="SecondaryRecommendationContentStack"
                                                                        Grid.Row="1"
                                                                        Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontSize="{DynamicResource FontSize.Body}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="42"/>
                                                                <TextBlock Text="{Binding UserReasonHeadline}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontSize="{DynamicResource FontSize.Tiny}"
                                                                           Margin="0,4,0,0"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Border Grid.Row="2"
                                                                    Background="Transparent"/>

                                                            <Grid Grid.Row="3"
                                                                  Margin="0,10,0,2"
                                                                  VerticalAlignment="Bottom">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Content="记这套"
                                                                        Style="{StaticResource SecondaryRecommendationActionButton}"
                                                                        HorizontalAlignment="Left"
                                                                        MinWidth="74"
                                                                        Command="{Binding DataContext.RecordRecommendedOutfitWornCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Recommendation}"/>
                                                                <Button Grid.Column="1"
                                                                        Content="详情"
                                                                        Style="{StaticResource SecondaryRecommendationDetailButton}"
                                                                        Margin="8,0,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        MinWidth="52"
                                                                        Command="{Binding DataContext.ShowRecommendationDebugForOutfitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Recommendation}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="OutfitsBrowseWorkbench"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,2,0,0"
                        Padding="0,16,0,0">
                    <Grid x:Name="OutfitsToolbarSurface"
                          Style="{StaticResource PageCollectionHeaderGrid}"
                          Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding CollectionSectionTitle}"
                                   Style="{StaticResource PageSectionTitleText}"/>

                        <Border x:Name="OutfitsFilterRail"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0"
                                           VerticalAlignment="Center"
                                           ItemHeight="40">
                                    <shared:SearchBox Width="280"
                                                      Margin="0,0,12,0"
                                                      Placeholder="搜索搭配名称、标签..."
                                                      Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <ComboBox x:Name="SceneFilterComboBox"
                                              Width="144"
                                              MinHeight="40"
                                              ItemsSource="{Binding SceneFilterOptions}"
                                              ItemTemplate="{StaticResource OutfitFilterOptionTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedScene, Mode=TwoWay}"
                                              Margin="0,0,12,0"/>

                                    <ComboBox x:Name="SeasonFilterComboBox"
                                              Width="144"
                                              MinHeight="40"
                                              ItemsSource="{Binding SeasonFilterOptions}"
                                              ItemTemplate="{StaticResource OutfitFilterOptionTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedSeason, Mode=TwoWay}"
                                              Margin="0,0,12,0"/>

                                    <CheckBox Content="仅收藏"
                                              IsChecked="{Binding FavoriteOnly, Mode=TwoWay}"
                                              Style="{StaticResource AppToolbarToggleChip}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"/>

                                    <CheckBox Content="有效果图"
                                              IsChecked="{Binding EffectImageOnly, Mode=TwoWay}"
                                              Style="{StaticResource AppToolbarToggleChip}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding IsEffectImageFirstDisplayMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Content="清除"
                                            Style="{StaticResource PageToolbarCapsuleButton}"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding ClearFiltersCommand}"/>
                                </WrapPanel>

                                <StackPanel x:Name="OutfitsDisplayActionRail"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource AppSegmentedTabShell}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="DisplayModeOutfitFirst"
                                                         Content="搭配"
                                                         GroupName="OutfitsDisplayMode"
                                                         Style="{StaticResource AppSegmentedTabButton}"
                                                         Checked="DisplayMode_Checked"/>
                                            <RadioButton x:Name="DisplayModeEffectImageFirst"
                                                         Content="效果图"
                                                         GroupName="OutfitsDisplayMode"
                                                         Style="{StaticResource AppSegmentedTabButton}"
                                                         Checked="DisplayMode_Checked"/>
                                        </UniformGrid>
                                    </Border>

                                    <ComboBox x:Name="OutfitsSortComboBox"
                                              Width="128"
                                              MinHeight="40"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SortBy, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource OutfitSortByLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="OutfitsToolbarDivider"
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Height="1"
                                Background="{DynamicResource BorderDividerBrush}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PageFilteredEmptyCard}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="没有筛出搭配"
                                   Style="{StaticResource PageSummaryTitleText}"/>
                        <TextBlock Text="换个条件试试，或者先清掉一两个筛选项。"
                                   Style="{StaticResource PageSummaryBodyText}"/>
                        <Button Content="清除筛选"
                                Style="{StaticResource PageToolbarCapsuleButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding ClearFiltersCommand}"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="OutfitsList"
                              ItemsSource="{Binding DisplayedOutfits}"
                              Margin="0,0,0,0"
                              Visibility="{Binding IsFilteredEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              ItemTemplate="{StaticResource OutfitCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MasonryPanel ColumnWidth="296"
                                                     Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Button Content="加载更多搭配"
                        Style="{StaticResource PageToolbarCapsuleButton}"
                        HorizontalAlignment="Center"
                        Margin="0,18,0,4"
                        Visibility="{Binding HasMoreOutfits, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding LoadMoreOutfitsCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           Style="{StaticResource PageEmptyStateAlignment}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="👗"
                           Title="还没有搭配"
                           Body="今天从一套简单的开始吧"
                           ActionText="+ 新建今日搭配"
                           ActionClicked="CreateOutfit_Click"/>
    </Grid>
</UserControl>
