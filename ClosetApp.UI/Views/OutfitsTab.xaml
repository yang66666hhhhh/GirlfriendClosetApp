<UserControl x:Class="ClosetApp.UI.Views.OutfitsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:ClosetApp.UI.Components"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>
        <conv:OutfitSortByLabelConverter x:Key="OutfitSortByLabelConverter"/>
        <SolidColorBrush x:Key="OutfitSkySurfaceBrush" Color="{DynamicResource Theme.Sky.Surface}"/>
        <SolidColorBrush x:Key="OutfitSkyBorderBrush" Color="{DynamicResource Theme.Sky.Border}"/>
        <SolidColorBrush x:Key="OutfitSkyTextBrush" Color="{DynamicResource Theme.Sky.Text}"/>
        <SolidColorBrush x:Key="OutfitMintSurfaceBrush" Color="{DynamicResource Theme.Mint.Surface}"/>
        <SolidColorBrush x:Key="OutfitMintBorderBrush" Color="{DynamicResource Theme.Mint.Border}"/>
        <SolidColorBrush x:Key="OutfitMintTextBrush" Color="{DynamicResource Theme.Mint.Text}"/>
        <SolidColorBrush x:Key="OutfitLavenderSurfaceBrush" Color="{DynamicResource Theme.Lavender.Surface}"/>
        <SolidColorBrush x:Key="OutfitLavenderBorderBrush" Color="{DynamicResource Theme.Lavender.Border}"/>
        <SolidColorBrush x:Key="OutfitLavenderTextBrush" Color="{DynamicResource Theme.Lavender.Text}"/>
        <SolidColorBrush x:Key="OutfitRoseSurfaceBrush" Color="{DynamicResource Theme.Rose.Surface}"/>
        <SolidColorBrush x:Key="OutfitRoseBorderBrush" Color="{DynamicResource Theme.Rose.Border}"/>
        <SolidColorBrush x:Key="OutfitRoseTextBrush" Color="{DynamicResource Theme.Rose.Text}"/>

        <Style x:Key="OutfitSkyButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitSkySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitSkyBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitSkyTextBrush}"/>
        </Style>

        <Style x:Key="OutfitMintButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitMintSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitMintBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitMintTextBrush}"/>
        </Style>

        <Style x:Key="OutfitLavenderButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{StaticResource OutfitLavenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutfitLavenderBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OutfitLavenderTextBrush}"/>
        </Style>

        <DataTemplate x:Key="OutfitCardTemplate">
            <outfit:OutfitCard Outfit="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Key="WeatherRecommendationTemplate">
            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource OutfitMintBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10"
                    Margin="0,0,8,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Height="88"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid Margin="4">
                                <Border Width="38"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Margin="0,8,0,10"
                                        CornerRadius="20"
                                        Opacity="0.24">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#28FFFFFF" Offset="0"/>
                                            <GradientStop Color="#10FFFFFF" Offset="0.52"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse Width="30"
                                         Height="6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,12"
                                         Opacity="0.13"
                                         IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush RadiusX="0.78" RadiusY="0.9">
                                            <GradientStop Color="#22000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <outfit:OutfitPreviewCanvas Clothes="{Binding PreviewClothes}"
                                                            Margin="0,1,0,0"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Season, Converter={StaticResource SeasonToName}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"/>
                                <TextBlock Text=" · "
                                           Foreground="{DynamicResource TextPlaceholderBrush}"
                                           FontSize="10"/>
                                <TextBlock Text="{Binding WearSummaryText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                            <Border Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                    BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6,3"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ReasonChipText}"
                                           Foreground="{StaticResource OutfitLavenderTextBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="穿了"
                                Style="{StaticResource OutfitMintButton}"
                                Padding="7,4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                Click="RecommendedOutfitWorn_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding ReasonSummaryText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecentWornRecordTemplate">
            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource OutfitRoseBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="10"
                    Margin="0,0,0,10"
                    Cursor="Hand"
                    MouseLeftButtonDown="RecentWornItem_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="92"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid Margin="4">
                            <Border Width="52"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Margin="0,8,0,10"
                                    CornerRadius="28"
                                    Opacity="0.28">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#28FFFFFF" Offset="0"/>
                                        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Ellipse Width="40"
                                     Height="8"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,12"
                                     Opacity="0.14"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush RadiusX="0.78" RadiusY="0.9">
                                        <GradientStop Color="#22000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <outfit:OutfitPreviewCanvas Clothes="{Binding PreviewClothes}"
                                                        Margin="0,2,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DateText}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                            BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                            BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="8,4"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding TimeText}"
                                           Foreground="{StaticResource OutfitLavenderTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding OutfitName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding MetaText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="我的搭配"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SortComboBox"
                              MinWidth="90"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortBy, Mode=TwoWay}"
                              Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource OutfitSortByLabelConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="+ 新建今日搭配"
                            Style="{StaticResource PageToolbarPrimaryButton}"
                            Click="CreateOutfit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="44,12,44,48"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource PageSummaryCard}"
                        Margin="0,0,0,12"
                        Padding="18,14"
                        MinHeight="316"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1.2*" MinWidth="520"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="搭配总览"
                                       Style="{StaticResource PageSummaryTitleText}"/>
                            <TextBlock Text="先看今天适合穿什么，再按需展开记录和日历。"
                                       Style="{StaticResource PageSummaryBodyText}"/>

                            <UniformGrid Columns="2"
                                         Margin="0,10,0,0"
                                         MaxWidth="360">
                                <Border Background="{DynamicResource SurfaceSectionBrush}"
                                        Style="{StaticResource PageSummaryBadge}"
                                        BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                                        BorderThickness="1"
                                        Padding="11,9"
                                        Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="已保存搭配"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock x:Name="TxtOutfitCount"
                                                   Text="{Binding OutfitCountText}"
                                                   Foreground="{StaticResource OutfitSkyTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="随时回看"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PrimaryLightBrush}"
                                        Style="{StaticResource PageSummaryBadge}"
                                        BorderBrush="{StaticResource OutfitMintBorderBrush}"
                                        BorderThickness="1"
                                        Padding="11,9"
                                        Margin="0,0,8,6">
                                    <StackPanel>
                                        <TextBlock Text="最近穿着"
                                                   Style="{StaticResource PageSummaryHintText}"/>
                                        <TextBlock x:Name="TxtHistoryQuick"
                                                   Text="{Binding HistoryQuickText}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="时间线已整理"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{Binding RefreshWeatherButtonText}"
                                        Style="{StaticResource OutfitMintButton}"
                                        Click="RefreshWeatherRecommendations_Click"
                                        IsEnabled="{Binding CanRefreshWeatherRecommendations}"
                                        Margin="0,0,6,0"
                                        />
                                <Button x:Name="ToggleHistoryButton"
                                        Content="{Binding HistoryToggleText}"
                                        Style="{StaticResource OutfitLavenderButton}"
                                        Click="ToggleHistory_Click"
                                        Margin="0,0,6,0"
                                        />
                                <Button Content="去设置城市"
                                        Style="{StaticResource OutfitSkyButton}"
                                        Click="OpenSettings_Click"
                                        />
                            </WrapPanel>

                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12,10"
                                    Margin="0,10,0,0"
                                    MaxWidth="420"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecommendationReadinessTitle}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RecommendationReadinessDetail}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource OutfitSkySurfaceBrush}"
                                            BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,4"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding WeatherCompactSummaryText}"
                                                   Foreground="{StaticResource OutfitSkyTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{StaticResource OutfitMintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    MinHeight="270">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="今日天气"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9"/>
                                            <TextBlock Text="{Binding WeatherCompactSummaryText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding WeatherCityCompactText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                                BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="8,5"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="推荐"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="8"/>
                                                <TextBlock Text="{Binding WeatherRecommendationCountText}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding WeatherRecommendationHintText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding WeatherStatusText}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                    <ItemsControl ItemsSource="{Binding WeatherRecommendations}"
                                                  Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource WeatherRecommendationTemplate}"
                                                  Visibility="{Binding HasWeatherRecommendations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,8,0,0"
                                            MinHeight="96"
                                            Visibility="{Binding HasWeatherRecommendations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="正在整理今日推荐..."
                                                   Foreground="{DynamicResource TextPlaceholderBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HistoryPanel"
                        Style="{StaticResource LookbookCard}"
                        Margin="0,0,0,24"
                        BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最近穿着"
                                       Style="{StaticResource PageSectionTitleText}"/>
                            <TextBlock x:Name="TxtHistorySummary"
                                       Text="{Binding HistorySummaryText}"
                                       Style="{StaticResource PageSectionBodyText}"
                                       Margin="0,6,0,16"/>
                            <ItemsControl x:Name="RecentWornList"
                                          ItemsSource="{Binding RecentWornRecords}"
                                          ItemTemplate="{StaticResource RecentWornRecordTemplate}"/>
                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{StaticResource OutfitMintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,11"
                                    Margin="0,2,0,0"
                                    Visibility="{Binding SelectedRecentWornRecord, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="当前聚焦"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedRecentWornRecord.OutfitName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedRecentWornRecord.FocusSummaryText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                                BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="8,4"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SelectedRecentWornRecord.FocusSyncText}"
                                                       Foreground="{StaticResource OutfitLavenderTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,8"
                                            Margin="0,9,0,0">
                                        <TextBlock Text="{Binding SelectedRecentWornRecord.FocusNoteText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="穿搭日历"
                                           Style="{StaticResource PageSectionTitleText}"/>
                                <TextBlock x:Name="TxtCalendarSummary"
                                           Text="{Binding CalendarSummaryText}"
                                           Style="{StaticResource PageSectionBodyText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Style="{StaticResource CapsuleButton}"
                                        Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                        BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                        MinWidth="42" Padding="12,8" Click="PrevMonth_Click"/>
                                <TextBlock x:Name="TxtCalendarMonth"
                                           Text="{Binding CalendarMonthText}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                                <Button Content="›" Style="{StaticResource CapsuleButton}"
                                        Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                        BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                        MinWidth="42" Padding="12,8" Click="NextMonth_Click"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,8">
                            <TextBlock Text="一" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="二" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="三" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="四" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="五" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="六" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="日" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>

                        <ItemsControl x:Name="CalendarDaysList"
                                      ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="82"
                                            CornerRadius="16"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource OutfitSkyBorderBrush}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="4"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CalendarDay_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRecords}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource OutfitLavenderSurfaceBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DayText}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource OutfitLavenderSurfaceBrush}"
                                                        BorderBrush="{StaticResource OutfitLavenderBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="6,2"
                                                        Visibility="{Binding HasRecords, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMultipleRecords}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource OutfitMintSurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource OutfitMintBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DensityText}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource OutfitLavenderTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasMultipleRecords}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource OutfitMintTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,8,0,0">
                                                <TextBlock Text="{Binding CountText}"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FirstOutfitName}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding DensitySummaryText}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           FontSize="9"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding HasRecords, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="全部搭配"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="悬停卡片可编辑、删除或快速记录「今天穿了」。"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="OutfitsList"
                              ItemsSource="{Binding Outfits}"
                              ItemTemplate="{StaticResource OutfitCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MasonryPanel ColumnWidth="304"
                                                     Spacing="20"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <states:EmptyState Grid.Row="1"
                           x:Name="TxtEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Icon="👗"
                           Title="还没有搭配"
                           Body="今天从一套简单的开始吧"
                           ActionText="+ 新建今日搭配"
                           ActionClicked="CreateOutfit_Click"/>
    </Grid>
</UserControl>
