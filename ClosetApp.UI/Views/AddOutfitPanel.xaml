<UserControl x:Class="ClosetApp.UI.Views.AddOutfitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Color x:Key="PageBg">#FFF8F6F2</Color>
        <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBg}"/>
        <Color x:Key="CardBg">#FFFFFDFC</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
        <Color x:Key="SecondaryBg">#FFF5F3EE</Color>
        <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBg}"/>
        <Color x:Key="BorderC">#FFE8E2DC</Color>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderC}"/>
        <Color x:Key="TextPrimary">#FF2D2A26</Color>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <Color x:Key="TextSecondary">#FF5E5A56</Color>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <Color x:Key="TextTertiary">#FFA39B95</Color>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
        <Color x:Key="Accent">#FFD9A299</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <Color x:Key="AccentLight">#FFF5EDE9</Color>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>

        <DataTemplate x:Key="ClothSelectTemplate">
            <Border Width="100" Height="120" Margin="6"
                    Background="{StaticResource SecondaryBgBrush}"
                    CornerRadius="12" Cursor="Hand"
                    BorderThickness="2" BorderBrush="Transparent"
                    MouseLeftButtonDown="ClothItem_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border CornerRadius="10" ClipToBounds="True" Margin="2">
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="Uniform"/>
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,4,0"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                              Fill="White" Width="10" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBgBrush}" MinWidth="720" MinHeight="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PageBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock Text="创建搭配" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource IconButton}" Click="CloseButton_Click">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Left: Form -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <!-- Basic Info -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="14"
                            Padding="20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="基本信息" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="搭配名称" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12">
                                <TextBox x:Name="TxtName" BorderThickness="0" Background="Transparent" FontSize="14"/>
                            </Border>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="场景" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbScene">
                                        <ComboBoxItem Content="上班" Tag="Work"/>
                                        <ComboBoxItem Content="约会" Tag="Date"/>
                                        <ComboBoxItem Content="出游" Tag="Travel"/>
                                        <ComboBoxItem Content="派对" Tag="Party"/>
                                        <ComboBoxItem Content="休闲" Tag="Casual"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="季节" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbSeason">
                                        <ComboBoxItem Content="春" Tag="Spring"/>
                                        <ComboBoxItem Content="夏" Tag="Summer"/>
                                        <ComboBoxItem Content="秋" Tag="Autumn"/>
                                        <ComboBoxItem Content="冬" Tag="Winter"/>
                                        <ComboBoxItem Content="四季" Tag="AllSeason"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="满意度" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6"/>
                            <hc:Rate x:Name="RatingControl" Count="5" Value="3" Foreground="#fbbf24" FontSize="22"/>
                        </StackPanel>
                    </Border>

                    <!-- Select Clothes -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="选择衣服" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                            <!-- Dress -->
                            <Border x:Name="DressSection" Margin="0,0,0,10">
                                <Expander Header="连衣裙 (选了则上下装不可选)" IsExpanded="True">
                                    <ItemsControl x:Name="DressList" Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource ClothSelectTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </Border>

                            <!-- Top -->
                            <Border x:Name="TopSection" Margin="0,0,0,10">
                                <Expander Header="上装" IsExpanded="True">
                                    <ItemsControl x:Name="TopsList" Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource ClothSelectTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </Border>

                            <!-- Bottom -->
                            <Border x:Name="BottomSection" Margin="0,0,0,10">
                                <Expander Header="下装" IsExpanded="True">
                                    <ItemsControl x:Name="BottomsList" Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource ClothSelectTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </Border>

                            <!-- Shoes -->
                            <Border x:Name="ShoesSection" Margin="0,0,0,10">
                                <Expander Header="鞋子" IsExpanded="True">
                                    <ItemsControl x:Name="ShoesList" Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource ClothSelectTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </Border>

                            <!-- Accessory -->
                            <Border x:Name="AccessorySection">
                                <Expander Header="装饰" IsExpanded="True">
                                    <ItemsControl x:Name="AccessoryList" Margin="0,8,0,0"
                                                  ItemTemplate="{StaticResource ClothSelectTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Preview sidebar -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="穿搭预览" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtPreviewCount" FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                    <Border Background="#F7F3EE" CornerRadius="14"
                            Padding="8" MinHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                            <Grid>
                                <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MinHeight="180">
                                    <TextBlock Text="选择衣服&#x0a;查看穿搭" FontSize="13"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Canvas x:Name="PreviewCanvas" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="{StaticResource PageBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid MaxWidth="400" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                    <Button Grid.Column="2" Content="创建搭配" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
