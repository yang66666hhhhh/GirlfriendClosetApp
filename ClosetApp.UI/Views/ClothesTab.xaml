<UserControl x:Class="ClosetApp.UI.Views.ClothesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:components="clr-namespace:ClosetApp.UI.Components"
             Background="#FFF8F6F2">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <conv:ClothingTypeToNameConverter x:Key="ClothingTypeToName"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>
        <conv:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor"/>

        <Color x:Key="PageBg">#FFF8F6F2</Color>
        <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBg}"/>
        <Color x:Key="CardBg">#FFFFFDFC</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
        <Color x:Key="Border">#FFF0EBE6</Color>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
        <Color x:Key="TextPrimary">#FF2D2A26</Color>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <Color x:Key="TextSecondary">#FF5E5A56</Color>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <Color x:Key="TextTertiary">#FFA39B95</Color>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
        <Color x:Key="TextPlaceholder">#FFC8C0B8</Color>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholder}"/>
        <Color x:Key="Accent">#FFD9A299</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <Color x:Key="AccentLight">#FFF5EDE9</Color>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>

        <!-- ═══ SEARCH ═══ -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="#FFFFFFFF" CornerRadius="14"
                                Padding="16,11" BorderThickness="1.5"
                                BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPlaceholderBrush}"
                                           Grid.Column="0" Margin="0,0,8,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="搜索衣服..."
                                           FontSize="14" Foreground="{StaticResource TextPlaceholderBrush}"
                                           VerticalAlignment="Center" Grid.Column="1" Margin="2,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SearchBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource Accent}" BlurRadius="14" ShadowDepth="0" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ CHIP ═══ -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFF6F2EE"/>
            <Setter Property="Foreground" Value="#FF7A746B"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="GroupName" Value="CategoryGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBg"
                                Background="#FFF6F2EE"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="#FFEEE4DC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="#FFE6CFC2"/>
                                <Setter Property="Foreground" Value="#FF5B4636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         ROOT
         ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{StaticResource PageBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Height="72" Margin="64,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="我的衣柜" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Center: Search -->
                <TextBox x:Name="TxtSearch" Grid.Column="1"
                         Style="{StaticResource SearchBoxStyle}"
                         Width="320"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>

                <!-- Right: Add Button -->
                <Button Grid.Column="2" Content="+ 添加衣服"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Click="AddClothing_Click"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,60">

            <StackPanel x:Name="ContentStack">

                <!-- ═══ HERO (short) ═══ -->
                <Border x:Name="HeroBanner" Height="180" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE4C5B5" Offset="0"/>
                            <GradientStop Color="#FFF3E4DD" Offset="0.5"/>
                            <GradientStop Color="#FFF8F0EC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="64,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Text -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="今天穿什么 ✨"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="温柔穿搭，从整理衣柜开始"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Right: Illustration -->
                        <Canvas Grid.Column="1" Width="120" Height="140"
                                VerticalAlignment="Center">
                            <Path Stroke="#FFD9A299" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M60,12 L60,22 M48,28 Q60,18 72,28"/>
                            <Path Stroke="#FFD9A299" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M8,36 L60,26 L112,36"/>
                            <Path Stroke="#FFD9A299" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M28,40 L20,100 L100,100 L92,40"/>
                            <Line X1="28" Y1="40" X2="92" Y2="40"
                                  Stroke="#FFD9A299" StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- ═══ TOOLBAR: Chips + Count ═══ -->
                <Grid Margin="64,20,64,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Chips -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ChipAll" Content="✨ 全部"
                                         Style="{StaticResource ChipStyle}" IsChecked="True"
                                         Checked="Category_Changed"/>
                            <RadioButton x:Name="ChipTop" Content="👕 上装"
                                         Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                         Checked="Category_Changed"/>
                            <RadioButton x:Name="ChipBottom" Content="👖 下装"
                                         Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                         Checked="Category_Changed"/>
                            <RadioButton x:Name="ChipDress" Content="👗 连衣裙"
                                         Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                         Checked="Category_Changed"/>
                            <RadioButton x:Name="ChipShoes" Content="👟 鞋子"
                                         Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                         Checked="Category_Changed"/>
                            <RadioButton x:Name="ChipAccessory" Content="👜 配饰"
                                         Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                         Checked="Category_Changed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Count -->
                    <TextBlock x:Name="TxtCount" Grid.Column="1"
                               FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ═══ MASONRY FLOW ═══ -->
                <ItemsControl x:Name="ClothesList" Margin="64,0,64,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MasonryPanel ColumnWidth="280" Spacing="24"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:PremiumClothingCard
                                EditClicked="ClothingCard_Edit"
                                DeleteClicked="ClothingCard_Delete"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ EMPTY STATE ═══ -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,80,0,0">
                    <Canvas Width="80" Height="100" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Canvas.Left="34" Canvas.Top="0"
                                 Fill="{StaticResource TextPlaceholderBrush}" Opacity="0.25"/>
                        <Path Stroke="{StaticResource TextPlaceholderBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" Opacity="0.25"
                              Data="M40,12 L40,22 M20,32 L40,26 L60,32 M20,32 L14,82 L66,82 L60,32 M30,50 L40,44 L50,50"/>
                    </Canvas>
                    <TextBlock Text="衣柜还空空的 ✨" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    <TextBlock Text="先添加第一件喜欢的衣服吧" FontSize="14"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Content="+ 添加衣服" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Click="AddClothing_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
