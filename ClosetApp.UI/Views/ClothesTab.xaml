<UserControl x:Class="ClosetApp.UI.Views.ClothesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:components="clr-namespace:ClosetApp.UI.Components"
             xmlns:clothing="clr-namespace:ClosetApp.UI.Components.Clothing"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClosetApp.UI;component/Components/Clothing/WardrobeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:ImagePathConverter x:Key="ImagePathConverter"/>
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
            <conv:ClothingTypeToNameConverter x:Key="ClothingTypeToName"/>
            <conv:SeasonToNameConverter x:Key="SeasonToName"/>
            <conv:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         ROOT
         ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <TextBlock Grid.Column="0"
                           Text="我的衣柜"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Right: Add Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="批量导入"
                            Style="{StaticResource WardrobeButton}"
                            Click="BatchImport_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="批量清空"
                            Style="{StaticResource PageToolbarDangerButton}"
                            Click="OpenBatchClearWardrobe_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="+ 添加衣服"
                            Style="{StaticResource PageToolbarPrimaryButton}"
                            Click="AddClothing_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,32">

            <StackPanel x:Name="ContentStack">

                <clothing:WardrobeSummaryPanel ToggleFilterRequested="ToggleFilter_Click"
                                               ClearFilterRequested="ClearFilter_Click"
                                               BatchCompleteQueueRequested="BatchCompleteQueue_Click"
                                               ClearCurrentCategoryRequested="ClearCurrentCategory_Click"/>

                <clothing:WardrobeFilterPanel/>

                <clothing:WardrobeCollectionHeaderPanel/>

                <!-- ═══ MASONRY FLOW ═══ -->
                <ItemsControl x:Name="ClothesList"
                              Margin="44,0,44,8"
                              ItemsSource="{Binding DisplayedClothes}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MasonryPanel ColumnWidth="244" Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:PremiumClothingCard
                                FavoriteToggled="ClothingCard_FavoriteToggled"
                                EditClicked="ClothingCard_Edit"
                                DeleteClicked="ClothingCard_Delete"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="加载更多衣物"
                        Style="{StaticResource PageToolbarCapsuleButton}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,12"
                        Visibility="{Binding HasMoreClothes, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="LoadMoreClothes_Click"/>

                <!-- ═══ EMPTY STATE ═══ -->
                <states:EmptyState x:Name="EmptyState"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,88,0,0"
                                   Icon="✨"
                                   Title="衣柜还空空的"
                                   Body="先导入一批照片，或者手动记下第一件心动单品。"
                                   ActionText="+ 添加衣服"
                                   ActionClicked="AddClothing_Click"
                                   SecondaryActionText="批量导入"
                                   SecondaryActionVisible="Visible"
                                   SecondaryActionClicked="BatchImport_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
