<UserControl x:Class="ClosetApp.UI.Views.ClothesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:components="clr-namespace:ClosetApp.UI.Components"
             xmlns:states="clr-namespace:ClosetApp.UI.Components.Shared.States"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <conv:ClothingTypeToNameConverter x:Key="ClothingTypeToName"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>
        <conv:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor"/>
        <conv:SortByLabelConverter x:Key="SortByLabelConverter"/>

        <!-- ═══ SEARCH ═══ -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}" CornerRadius="11"
                                Padding="12,8" BorderThickness="1.5"
                                BorderBrush="{DynamicResource BorderLightBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPlaceholderBrush}"
                                           Grid.Column="0" Margin="0,0,6,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="搜索衣服..."
                                           FontSize="12" Foreground="{DynamicResource TextPlaceholderBrush}"
                                           VerticalAlignment="Center" Grid.Column="1" Margin="2,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="SearchBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource Primary}" BlurRadius="14" ShadowDepth="0" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ CHIP ═══ -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="GroupName" Value="CategoryGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBg"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CheckBg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagChipStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBg" Property="BorderThickness" Value="1.4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{Binding SoftBackground}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,7"
                                Margin="0,0,8,8"
                                Opacity="{Binding UnselectedOpacity}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding BorderBrush}"
                                         Opacity="0.9"/>
                                <TextBlock x:Name="TagName"
                                           Text="{Binding Tag.Name}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{Binding BorderBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{Binding SelectedBackground}"/>
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="ChipBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{Binding SelectedBackground}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{Binding BorderBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="1"/>
                                <Setter TargetName="ChipBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="TagName" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WardrobeButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         ROOT
         ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorder}">
            <Grid Height="48" Margin="44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <TextBlock Grid.Column="0"
                           Text="我的衣柜"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Right: Add Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="批量导入"
                            Style="{StaticResource WardrobeButton}"
                            Click="BatchImport_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="批量清空"
                            Style="{StaticResource PageToolbarDangerButton}"
                            Click="BatchClearWardrobe_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="+ 添加衣服"
                            Style="{StaticResource PageToolbarPrimaryButton}"
                            Click="AddClothing_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,48">

            <StackPanel x:Name="ContentStack">

                <!-- ═══ TOP TOOLBELT ═══ -->
                <Border x:Name="WardrobeSummary"
                        Style="{StaticResource PageSummaryCard}"
                        Margin="44,8,44,8"
                        Padding="12,10"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="衣柜"
                                           Style="{StaticResource PageSummaryTitleText}"
                                           FontSize="13"/>
                                <TextBlock Text="搜索、筛选、待整理都在这里。"
                                           Style="{StaticResource PageSummaryHintText}"
                                           Margin="6,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Border Style="{StaticResource PageSummaryBadge}"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        Padding="8,5"
                                        Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtTotalCount"
                                                   Text="{Binding TotalCount, StringFormat={}{0} 件}"
                                                   Style="{StaticResource PageSummaryValueText}"/>
                                        <TextBlock Text=" 全部"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="4,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageSummaryBadge}"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtFilteredCount"
                                                   Text="{Binding FilteredCount, StringFormat={}{0} 件}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text=" 当前"
                                                   Style="{StaticResource PageSummaryHintText}"
                                                   Margin="4,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InlineSearch"
                                     Grid.Column="0"
                                     Style="{StaticResource SearchBoxStyle}"
                                     MinWidth="240"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <ComboBox x:Name="SortComboBox"
                                          MinWidth="90"
                                          ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SortBy, Mode=TwoWay}"
                                          Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SortByLabelConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="ToggleFilterButton"
                                        Content="{Binding FilterToggleText}"
                                        Style="{StaticResource WardrobeButton}"
                                        Click="ToggleFilter_Click"/>
                                <Button x:Name="ClearFilterButton"
                                        Content="清除"
                                        Style="{StaticResource WardrobeButton}"
                                        Margin="4,0,0,0"
                                        Click="ClearFilter_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="待整理"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="导入后优先补资料"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,1,0,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="批量补全"
                                            Style="{StaticResource WardrobeButton}"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding CanBatchCompleteCurrentQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="BatchCompleteQueue_Click"/>
                                    <Button Content="清空当前"
                                            Style="{StaticResource WardrobeButton}"
                                            Margin="4,0,0,0"
                                            Click="BatchClearWardrobe_Click"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel>
                                <RadioButton Content="{Binding QueueAllText}"
                                             Style="{StaticResource ChipStyle}"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueAllSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueUnnamedText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueUnnamedSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueUncategorizedText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueUncategorizedSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueUnseasonedText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueUnseasonedSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueUntaggedText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueUntaggedSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueMissingBrandOrColorText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueMissingBrandOrColorSelected, Mode=TwoWay}"/>
                                <RadioButton Content="{Binding QueueRecentlyImportedText}"
                                             Style="{StaticResource ChipStyle}"
                                             Margin="8,0,0,8"
                                             GroupName="QueueGroup"
                                             IsChecked="{Binding IsQueueRecentlyImportedSelected, Mode=TwoWay}"/>
                            </WrapPanel>

                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    Margin="0,2,0,0"
                                    Visibility="{Binding ShowRecentImportSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding RecentImportSummaryTitle}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RecentImportSummaryBody}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Border Style="{StaticResource PageSummaryBadge}"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Padding="7,4"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding RecentlyImportedUnnamedCount, StringFormat=未命名 {0}}"
                                                       Style="{StaticResource PageSummaryValueText}"
                                                       FontSize="9"/>
                                        </Border>
                                        <Border Style="{StaticResource PageSummaryBadge}"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Padding="7,4"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding RecentlyImportedUncategorizedCount, StringFormat=未分类 {0}}"
                                                       Style="{StaticResource PageSummaryValueText}"
                                                       FontSize="9"/>
                                        </Border>
                                        <Border Style="{StaticResource PageSummaryBadge}"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Padding="7,4"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding RecentlyImportedUnseasonedCount, StringFormat=未设季节 {0}}"
                                                       Style="{StaticResource PageSummaryValueText}"
                                                       FontSize="9"/>
                                        </Border>
                                        <Border Style="{StaticResource PageSummaryBadge}"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Padding="7,4"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding RecentlyImportedUntaggedCount, StringFormat=无标签 {0}}"
                                                       Style="{StaticResource PageSummaryValueText}"
                                                       FontSize="9"/>
                                        </Border>
                                        <Border Style="{StaticResource PageSummaryBadge}"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Padding="7,4"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding RecentlyImportedMissingBrandOrColorCount, StringFormat=无品牌/颜色 {0}}"
                                                       Style="{StaticResource PageSummaryValueText}"
                                                       FontSize="9"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ FILTER PANEL ═══ -->
                <Border x:Name="FilterPanel"
                        Style="{StaticResource PageSummaryCard}"
                        Margin="44,0,44,10"
                        Padding="12,10"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsFilterExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="筛选"
                                           Style="{StaticResource PageSummaryTitleText}"
                                           FontSize="14"/>
                                <TextBlock x:Name="TxtFilterHint"
                                           Text="{Binding FilterHint}"
                                           Style="{StaticResource PageSummaryBodyText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCount" Grid.Column="1"
                                       Text="{Binding FilterResultText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="分类"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,5"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel>
                                    <RadioButton x:Name="ChipAll" Content="✨ 全部"
                                                 Style="{StaticResource ChipStyle}"
                                                 IsChecked="{Binding IsCategoryAllSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipTop" Content="👕 上衣"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryTopSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipOuterwear" Content="🧥 外套"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryOuterwearSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipBottom" Content="👖 裤装"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryBottomSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipSkirt" Content="🩰 半裙"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategorySkirtSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipDress" Content="👗 连衣裙"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryDressSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipShoes" Content="👟 鞋子"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryShoesSelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipAccessory" Content="👜 配饰"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryAccessorySelected, Mode=TwoWay}"/>
                                    <RadioButton x:Name="ChipUnspecified" Content="待分类"
                                                 Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                                 IsChecked="{Binding IsCategoryUnspecifiedSelected, Mode=TwoWay}"/>
                                </WrapPanel>
                            </ScrollViewer>

                            <TextBlock Text="季节"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,5"/>
                            <WrapPanel>
                                <RadioButton x:Name="SeasonAll" Content="四季都看"
                                             Style="{StaticResource ChipStyle}"
                                             GroupName="SeasonGroup"
                                             IsChecked="{Binding IsSeasonAllSelected, Mode=TwoWay}"/>
                                <RadioButton x:Name="SeasonSpring" Content="春天"
                                             Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                             GroupName="SeasonGroup"
                                             IsChecked="{Binding IsSeasonSpringSelected, Mode=TwoWay}"/>
                                <RadioButton x:Name="SeasonSummer" Content="夏天"
                                             Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                             GroupName="SeasonGroup"
                                             IsChecked="{Binding IsSeasonSummerSelected, Mode=TwoWay}"/>
                                <RadioButton x:Name="SeasonAutumn" Content="秋天"
                                             Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                             GroupName="SeasonGroup"
                                             IsChecked="{Binding IsSeasonAutumnSelected, Mode=TwoWay}"/>
                                <RadioButton x:Name="SeasonWinter" Content="冬天"
                                             Style="{StaticResource ChipStyle}" Margin="8,0,0,0"
                                             GroupName="SeasonGroup"
                                             IsChecked="{Binding IsSeasonWinterSelected, Mode=TwoWay}"/>
                            </WrapPanel>

                            <TextBlock Text="偏好"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,5"/>
                            <CheckBox x:Name="FavoriteOnlyCheckBox"
                                      Content="只看收藏"
                                      Style="{StaticResource FilterCheckStyle}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding FavoriteOnly, Mode=TwoWay}"/>

                            <TextBlock Text="风格标签"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,5"/>
                            <TextBlock x:Name="TxtTagFilterEmpty"
                                       Text="还没有风格标签，先去标签页加几个会更好筛。"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasAvailableTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding TagFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource TagToggleStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="44,4,44,8"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CollectionSectionTitle}"
                                   Style="{StaticResource PageSectionTitleText}"/>
                        <TextBlock Text="{Binding CollectionSectionBody}"
                                   Style="{StaticResource PageSectionBodyText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ MASONRY FLOW ═══ -->
                <ItemsControl x:Name="ClothesList"
                              Margin="44,0,44,8"
                              ItemsSource="{Binding FilteredClothes}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MasonryPanel ColumnWidth="248" Spacing="14"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:PremiumClothingCard
                                FavoriteToggled="ClothingCard_FavoriteToggled"
                                EditClicked="ClothingCard_Edit"
                                DeleteClicked="ClothingCard_Delete"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ EMPTY STATE ═══ -->
                <states:EmptyState x:Name="EmptyState"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,80,0,0"
                                   Icon="✨"
                                   Title="衣柜还空空的"
                                   Body="先导入一批照片，或者手动记下第一件心动单品。"
                                   ActionText="+ 添加衣服"
                                   ActionClicked="AddClothing_Click"
                                   SecondaryActionText="批量导入"
                                   SecondaryActionVisible="Visible"
                                   SecondaryActionClicked="BatchImport_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
