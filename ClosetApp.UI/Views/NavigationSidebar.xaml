<UserControl x:Class="ClosetApp.UI.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="220">
    <UserControl.Resources>
        <!-- ═══════════════════════════════════════
             NAVIGATION DESIGN TOKENS
             ═══════════════════════════════════════ -->

        <!-- Layout Tokens -->
        <sys:Double x:Key="NavIconSize">22</sys:Double>
        <Thickness x:Key="NavItemPadding">16,14</Thickness>
        <CornerRadius x:Key="NavItemRadius">14</CornerRadius>
        <sys:Double x:Key="NavHeight">52</sys:Double>

        <!-- ═══════════════════════════════════════
             NAV ITEM STYLE
             ═══════════════════════════════════════ -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Height" Value="{StaticResource NavHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="{StaticResource NavItemRadius}"
                                Padding="{StaticResource NavItemPadding}"
                                Margin="8,2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid x:Name="ExpandedLayout">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NavIcon"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="{StaticResource NavIconSize}"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock x:Name="NavText"
                                               Text="{TemplateBinding Content}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                            <TranslateTransform Y="-1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="-0.5"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.986" ScaleY="0.986"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuHeaderItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuDividerStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Sidebar Container -->
    <Border Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo / Brand Area -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="12,28,12,24">
                <Button x:Name="BtnProfile"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        MinHeight="108"
                        HorizontalAlignment="Stretch"
                        ToolTip="个人中心 / 账号菜单"
                        Click="Profile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ProfileShell"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border x:Name="ProfileIdentitySurface"
                                        Margin="0"
                                        Padding="0"
                                        Background="{DynamicResource SurfaceCardBrush}"
                                        CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="ProfileIdentitySurface" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                                <TranslateTransform Y="-1"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter TargetName="ProfileIdentitySurface" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.988" ScaleY="0.988"/>
                                                <TranslateTransform Y="1"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileMenu"
                                     Style="{StaticResource WardrobeCard.MoreMenu}"
                                     ItemContainerStyle="{x:Null}"/>
                    </Button.ContextMenu>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        <shared:LocalUserAvatar x:Name="CurrentUserAvatar"
                                                Width="52"
                                                Height="52"
                                                ShowStatus="False"/>
                            <StackPanel x:Name="ProfileTextPanel"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentUserName"
                                       Text="私人衣橱"
                                       FontSize="{DynamicResource FontSize.Input}"
                                       FontWeight="SemiBold"
                                       MaxWidth="104"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtCurrentUserRole"
                                       Text="个人中心"
                                       FontSize="{DynamicResource FontSize.Meta}"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="ProfileCountBadge"
                                    Margin="0,7,0,0"
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock x:Name="TxtClothingCount"
                                           Text="0 件衣服"
                                           FontSize="{DynamicResource FontSize.Tiny}"
                                           Foreground="{DynamicResource TextPlaceholderBrush}"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="ProfileChevronShell"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock x:Name="ProfileChevron"
                                       Text="›"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"/>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Navigation Items -->
            <StackPanel x:Name="SidebarNavHost"
                        Grid.Row="1"
                        Margin="0,4,0,0">
                <RadioButton x:Name="NavWardrobe"
                             Content="衣柜" Tag="👗"
                             ToolTip="衣柜"
                             Style="{StaticResource NavItemStyle}"
                             IsChecked="True"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavOutfits"
                             Content="搭配" Tag="✨"
                             ToolTip="搭配"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavTags"
                             Content="标签" Tag="🏷"
                             ToolTip="标签"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>

                <!-- Divider -->
                <Border x:Name="SidebarDivider"
                        Height="1"
                        Width="52"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Margin="18,16,18,16"
                        HorizontalAlignment="Center"
                        Opacity="0.6"/>

                <RadioButton x:Name="NavSettings"
                             Content="设置" Tag="⚙"
                             ToolTip="设置"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
