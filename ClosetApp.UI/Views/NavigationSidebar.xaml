<UserControl x:Class="ClosetApp.UI.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="220">
    <UserControl.Resources>
        <!-- ═══════════════════════════════════════
             NAVIGATION DESIGN TOKENS
             ═══════════════════════════════════════ -->

        <!-- Layout Tokens -->
        <sys:Double x:Key="NavIconSize">22</sys:Double>
        <Thickness x:Key="NavItemPadding">16,14</Thickness>
        <CornerRadius x:Key="NavItemRadius">14</CornerRadius>
        <sys:Double x:Key="NavHeight">52</sys:Double>

        <!-- ═══════════════════════════════════════
             NAV ITEM STYLE
             ═══════════════════════════════════════ -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Height" Value="{StaticResource NavHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="{StaticResource NavItemRadius}"
                                Padding="{StaticResource NavItemPadding}"
                                Margin="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavIcon"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="{StaticResource NavIconSize}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="NavText"
                                           Text="{TemplateBinding Content}"
                                           FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapse button style -->
        <Style x:Key="CollapseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuHeaderItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuDividerStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="10,6"
                                Background="{DynamicResource BorderLightBrush}"
                                Opacity="0.9"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Sidebar Container -->
    <Border Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo / Brand Area -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="20,28,20,24">
                <Button x:Name="BtnProfile"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="11"
                        MinHeight="74"
                        HorizontalAlignment="Stretch"
                        ToolTip="账号菜单：编辑档案、用户管理或退出登录"
                        Click="Profile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ProfileShell"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileMenu"
                                     Style="{StaticResource WardrobeCard.MoreMenu}"
                                     ItemContainerStyle="{x:Null}"/>
                    </Button.ContextMenu>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <shared:LocalUserAvatar x:Name="CurrentUserAvatar"
                                                Width="52"
                                                Height="52"/>
                        <StackPanel x:Name="ProfileTextPanel"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentUserName"
                                       Text="私人衣橱"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtCurrentUserRole"
                                       Text="账号菜单"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="ProfileChevronShell"
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <TextBlock x:Name="ProfileChevron"
                                       Text="›"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"/>
                        </Border>
                    </Grid>
                </Button>
                <TextBlock x:Name="TxtClothingCount"
                           Text="0 件衣服"
                           FontSize="12"
                           Foreground="{DynamicResource TextPlaceholderBrush}"
                           Margin="54,8,0,0"/>
            </StackPanel>

            <!-- Navigation Items -->
            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                <RadioButton x:Name="NavWardrobe"
                             Content="衣柜" Tag="👗"
                             Style="{StaticResource NavItemStyle}"
                             IsChecked="True"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavOutfits"
                             Content="搭配" Tag="✨"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavTags"
                             Content="标签" Tag="🏷"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>

                <!-- Divider -->
                <Border Height="1"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Margin="20,16,20,16"
                        Opacity="0.6"/>

                <RadioButton x:Name="NavSettings"
                             Content="设置" Tag="⚙"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
            </StackPanel>

            <!-- Collapse Button -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Button x:Name="BtnCollapse"
                        Style="{StaticResource CollapseBtnStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        Click="Collapse_Click">
                    <Button.RenderTransform>
                        <RotateTransform x:Name="CollapseRotate" Angle="0"/>
                    </Button.RenderTransform>
                    <TextBlock Text="◀" FontSize="11"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
