<UserControl x:Class="ClosetApp.UI.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="180">
    <UserControl.Resources>
        <!-- ═══════════════════════════════════════
             NAVIGATION DESIGN TOKENS
             ═══════════════════════════════════════ -->

        <!-- Layout Tokens -->
        <sys:Double x:Key="NavIconSize">20</sys:Double>
        <Thickness x:Key="NavItemPadding">16,14</Thickness>
        <CornerRadius x:Key="NavItemRadius">14</CornerRadius>
        <sys:Double x:Key="NavHeight">44</sys:Double>
        <sys:Double x:Key="CollapsedSidebarWidth">88</sys:Double>
        <sys:Double x:Key="CollapsedNavButtonSize">48</sys:Double>

        <!-- ═══════════════════════════════════════
             NAV ITEM STYLE
             ═══════════════════════════════════════ -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Height" Value="{StaticResource NavHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="NavActiveIndicator"
                                    Width="3"
                                    Margin="0,10,0,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                            <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="{StaticResource NavItemRadius}"
                                Padding="10,10"
                                Margin="8,2,8,2"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid x:Name="ExpandedLayout">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NavIcon"
                                                   Text="{TemplateBinding Tag}"
                                                   FontSize="{StaticResource NavIconSize}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                        <TextBlock x:Name="NavText"
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                    </Grid>
                                    <Grid x:Name="DockLayout"
                                          Visibility="Collapsed">
                                        <TextBlock x:Name="DockIcon"
                                                   Text="{TemplateBinding Tag}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                            <TranslateTransform Y="-0.5"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="NavActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.986" ScaleY="0.986"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Width" Value="{StaticResource CollapsedNavButtonSize}">
                                <Setter TargetName="NavBg" Property="Width" Value="{StaticResource CollapsedNavButtonSize}"/>
                                <Setter TargetName="NavBg" Property="Height" Value="{StaticResource CollapsedNavButtonSize}"/>
                                <Setter TargetName="NavBg" Property="Padding" Value="0"/>
                                <Setter TargetName="NavBg" Property="Margin" Value="0,0,0,8"/>
                                <Setter TargetName="NavBg" Property="CornerRadius" Value="16"/>
                                <Setter TargetName="ExpandedLayout" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="DockLayout" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NavActiveIndicator" Property="Margin" Value="8,12,0,12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapse button style -->
        <Style x:Key="CollapseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="Transparent"
                                CornerRadius="16"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="BtnBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                            <TranslateTransform Y="-1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuHeaderItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuDividerStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Sidebar Container -->
    <Border Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo / Brand Area -->
            <Grid x:Name="HeaderPanel" Grid.Row="0" Margin="12,24,12,20">
                <Button x:Name="SidebarCollapseButton"
                        Style="{StaticResource CollapseBtnStyle}"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Panel.ZIndex="2"
                        ToolTip="收起侧边栏"
                        Click="Collapse_Click">
                    <TextBlock x:Name="CollapseGlyph"
                               Text="◀"
                               FontSize="{DynamicResource FontSize.Meta}"
                               Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </Button>
                <Button x:Name="CollapsedProfileButton"
                        Width="56"
                        Height="56"
                        Margin="0,4,0,8"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="个人中心 / 账号菜单"
                        Visibility="Collapsed"
                        Click="Profile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CollapsedProfileShell"
                                    Width="56"
                                    Height="56"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="28"
                                    Padding="4"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CollapsedProfileShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter TargetName="CollapsedProfileShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="CollapsedProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                                <TranslateTransform Y="-1"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CollapsedProfileShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter TargetName="CollapsedProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                                <TranslateTransform Y="1"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <shared:LocalUserAvatar x:Name="CollapsedCurrentUserAvatar"
                                            Width="48"
                                            Height="48"
                                            ShowStatus="False"/>
                </Button>
                <Button x:Name="BtnProfile"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        MinHeight="70"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        ToolTip="个人中心 / 账号菜单"
                        Click="Profile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ProfileShell"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1.005" ScaleY="1.005"/>
                                                <TranslateTransform Y="-0.5"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ProfileShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter TargetName="ProfileShell" Property="RenderTransform">
                                        <Setter.Value>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.988" ScaleY="0.988"/>
                                                <TranslateTransform Y="1"/>
                                            </TransformGroup>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileMenu"
                                     Style="{StaticResource WardrobeCard.MoreMenu}"
                                     ItemContainerStyle="{x:Null}"/>
                    </Button.ContextMenu>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <shared:LocalUserAvatar x:Name="CurrentUserAvatar"
                                                Width="42"
                                                Height="42"
                                                ShowStatus="False"/>
                        <StackPanel x:Name="ProfileTextPanel"
                                    Grid.Column="1"
                                    Margin="8,0,28,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentUserName"
                                       Text="私人衣橱"
                                       FontSize="{DynamicResource FontSize.Input}"
                                       FontWeight="SemiBold"
                                       MaxWidth="88"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="ProfileCountBadge"
                                    Margin="0,4,0,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock x:Name="TxtClothingCount"
                                           Text="0 件衣服"
                                           FontSize="{DynamicResource FontSize.Tiny}"
                                           Foreground="{DynamicResource TextPlaceholderBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- Navigation Items -->
            <StackPanel x:Name="SidebarNavHost"
                        Grid.Row="1"
                        Margin="0,10,0,0">
                <RadioButton x:Name="NavWardrobe"
                             Content="衣柜" Tag="👗"
                             ToolTip="衣柜"
                             Style="{StaticResource NavItemStyle}"
                             IsChecked="True"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavOutfits"
                             Content="搭配" Tag="✨"
                             ToolTip="搭配"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
                <RadioButton x:Name="NavTags"
                             Content="标签" Tag="🏷"
                             ToolTip="标签"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>

                <!-- Divider -->
                <Border x:Name="SidebarDivider"
                        Height="1"
                        Width="40"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Margin="0,16,0,14"
                        HorizontalAlignment="Center"
                        Opacity="0.5"/>

                <RadioButton x:Name="NavSettings"
                             Content="设置" Tag="⚙"
                             ToolTip="设置"
                             Style="{StaticResource NavItemStyle}"
                             Checked="NavItem_Checked"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
