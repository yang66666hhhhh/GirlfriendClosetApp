<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush" Color="#667eea"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#764ba2"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F8F9FA"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#999999"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#667eea"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10b981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ef4444"/>

    <SolidColorBrush x:Key="OverlayBrush" Color="#40000000"/>

    <SolidColorBrush x:Key="RatingStarBrush" Color="#fbbf24"/>

</ResourceDictionary>