<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- ============================================== -->
    <!-- PREMIUM CLOTHING CARD STYLES -->
    <!-- Apple + Pinterest + 小红书风格 -->
    <!-- ============================================== -->

    <!-- Card Shadow Layer (Ambient) -->
    <Style x:Key="PremiumCardShadow" TargetType="Border">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Margin" Value="6,6,0,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.12" Color="#80000000" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main Card Style (Base) -->
    <Style x:Key="PremiumClothingCardBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Heart Favorite Button Style -->
    <Style x:Key="HeartFavoriteButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="#80FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="{TemplateBinding Background}">
                        <Path x:Name="heartIcon"
                              Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                              Fill="{DynamicResource DangerBrush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="heartIcon" Property="Width" Value="22"/>
                            <Setter TargetName="heartIcon" Property="Height" Value="22"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="heartIcon" Property="Width" Value="15"/>
                            <Setter TargetName="heartIcon" Property="Height" Value="15"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Star Rating Button Style -->
    <Style x:Key="StarRatingButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Path x:Name="star"
                              Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                              Fill="#E0E0E0"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="star" Property="Fill" Value="{DynamicResource RatingStarBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tag Chip Style (小红书风格) -->
    <Style x:Key="CardTagChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
    </Style>

    <!-- Color Dot Style -->
    <Style x:Key="ColorDot" TargetType="Ellipse">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Stroke" Value="#FFFFFF"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>

    <!-- Season Badge Style -->
    <Style x:Key="SeasonBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="#90FFFFFF"/>
    </Style>

    <!-- ============================================== -->
    <!-- DARK THEME CARD VARIANTS -->
    <!-- ============================================== -->

    <Style x:Key="PremiumCardShadowDark" TargetType="Border">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Margin" Value="6,6,0,0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A2530" Offset="0"/>
                    <GradientStop Color="#1E1A22" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" Color="#000000" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumClothingCardDark" TargetType="Border">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="#1E1A22"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>