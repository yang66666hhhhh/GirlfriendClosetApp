<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfacePageBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="EmptyStateTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EmptyStateBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,24"/>
    </Style>

    <Style x:Key="LookbookCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}"/>
    </Style>

    <Style x:Key="PageSummaryCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <Style x:Key="PageSummaryBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSectionBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="PageSummaryValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageSummaryHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>

    <Style x:Key="PageToolbarCapsuleButton" TargetType="Button" BasedOn="{StaticResource CapsuleButton}">
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style x:Key="PageToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="132"/>
    </Style>

    <Style x:Key="PageToolbarDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

</ResourceDictionary>
