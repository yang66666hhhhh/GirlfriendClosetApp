<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="Shadow.Button"
                      BlurRadius="16"
                      ShadowDepth="3"
                      Opacity="0.12"
                      Color="#40CA9C9F"
                      Direction="270"/>

    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Opacity="0.08"
                      Color="#60000000"
                      Direction="270"/>

    <DropShadowEffect x:Key="Shadow.Hero"
                      BlurRadius="32"
                      ShadowDepth="0"
                      Opacity="0.15"
                      Color="#40CA9C9F"/>

    <DropShadowEffect x:Key="Shadow.Modal"
                      BlurRadius="48"
                      ShadowDepth="8"
                      Opacity="0.10"
                      Color="#40000000"/>

</ResourceDictionary>
