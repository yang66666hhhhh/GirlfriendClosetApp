<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Primary">#FFC48F95</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <Color x:Key="Primary.Dark">#FFA47179</Color>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource Primary.Dark}"/>
    <Color x:Key="Primary.Light">#FFF3EAE9</Color>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Primary.Light}"/>
    <Color x:Key="Primary.Glow">#33C48F95</Color>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource Primary.Glow}"/>

    <Color x:Key="Danger">#FFE88D8D</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <Color x:Key="Danger.Dark">#FFD47A7A</Color>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource Danger.Dark}"/>
    <Color x:Key="Danger.Light">#FFF0E6E6</Color>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource Danger.Light}"/>

    <Color x:Key="Ghost">#80FFFFFF</Color>
    <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource Ghost}"/>

    <Color x:Key="Text.Primary">#FF2D2A26</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Text.Primary}"/>
    <Color x:Key="Text.Secondary">#FF9E958D</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Text.Secondary}"/>
    <Color x:Key="Text.Placeholder">#FFC8C0B8</Color>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource Text.Placeholder}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Text.Placeholder}"/>

    <Color x:Key="Surface.Page">#FFF6F2EF</Color>
    <SolidColorBrush x:Key="SurfacePageBrush" Color="{StaticResource Surface.Page}"/>
    <Color x:Key="Surface.Modal">#FFFFFBF9</Color>
    <SolidColorBrush x:Key="SurfaceModalBrush" Color="{StaticResource Surface.Modal}"/>
    <Color x:Key="Surface.Card">#FFFDFCFC</Color>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource Surface.Card}"/>
    <Color x:Key="Surface.Hero">#FFF4EDEA</Color>
    <SolidColorBrush x:Key="SurfaceHeroBrush" Color="{StaticResource Surface.Hero}"/>
    <Color x:Key="Surface.Section">#FFF9F4F1</Color>
    <SolidColorBrush x:Key="SurfaceSectionBrush" Color="{StaticResource Surface.Section}"/>
    <Color x:Key="Surface.Elevated">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource Surface.Elevated}"/>

    <Color x:Key="Surface.ImageArea">#FFF4EEEA</Color>
    <SolidColorBrush x:Key="SurfaceImageAreaBrush" Color="{StaticResource Surface.ImageArea}"/>

    <Color x:Key="Border.Light">#FFE8DDDB</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource Border.Light}"/>
    <Color x:Key="Border.Divider">#FFEFE7E4</Color>
    <SolidColorBrush x:Key="BorderDividerBrush" Color="{StaticResource Border.Divider}"/>

    <Color x:Key="Sidebar.Background">#FFFBF7F4</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource Sidebar.Background}"/>
    <Color x:Key="Sidebar.Border">#FFEDE3E0</Color>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource Sidebar.Border}"/>

    <Color x:Key="Theme.Sky.Surface">#FFEEF4FF</Color>
    <SolidColorBrush x:Key="ThemeSkySurfaceBrush" Color="{StaticResource Theme.Sky.Surface}"/>
    <Color x:Key="Theme.Sky.Border">#FFCBD9F4</Color>
    <SolidColorBrush x:Key="ThemeSkyBorderBrush" Color="{StaticResource Theme.Sky.Border}"/>
    <Color x:Key="Theme.Sky.Text">#FF5F79AD</Color>
    <SolidColorBrush x:Key="ThemeSkyTextBrush" Color="{StaticResource Theme.Sky.Text}"/>

    <Color x:Key="Theme.Mint.Surface">#FFEEF7F1</Color>
    <SolidColorBrush x:Key="ThemeMintSurfaceBrush" Color="{StaticResource Theme.Mint.Surface}"/>
    <Color x:Key="Theme.Mint.Border">#FFC9E0CF</Color>
    <SolidColorBrush x:Key="ThemeMintBorderBrush" Color="{StaticResource Theme.Mint.Border}"/>
    <Color x:Key="Theme.Mint.Text">#FF5E8A67</Color>
    <SolidColorBrush x:Key="ThemeMintTextBrush" Color="{StaticResource Theme.Mint.Text}"/>

    <Color x:Key="Theme.Rose.Surface">#FFF8EEF0</Color>
    <SolidColorBrush x:Key="ThemeRoseSurfaceBrush" Color="{StaticResource Theme.Rose.Surface}"/>
    <Color x:Key="Theme.Rose.Border">#FFE0CACE</Color>
    <SolidColorBrush x:Key="ThemeRoseBorderBrush" Color="{StaticResource Theme.Rose.Border}"/>
    <Color x:Key="Theme.Rose.Text">#FF9E6C74</Color>
    <SolidColorBrush x:Key="ThemeRoseTextBrush" Color="{StaticResource Theme.Rose.Text}"/>

    <Color x:Key="Theme.Amber.Surface">#FFFCF3E8</Color>
    <SolidColorBrush x:Key="ThemeAmberSurfaceBrush" Color="{StaticResource Theme.Amber.Surface}"/>
    <Color x:Key="Theme.Amber.Border">#FFEBD6BA</Color>
    <SolidColorBrush x:Key="ThemeAmberBorderBrush" Color="{StaticResource Theme.Amber.Border}"/>
    <Color x:Key="Theme.Amber.Text">#FFA67942</Color>
    <SolidColorBrush x:Key="ThemeAmberTextBrush" Color="{StaticResource Theme.Amber.Text}"/>

    <Color x:Key="Theme.Lavender.Surface">#FFF2EFFB</Color>
    <SolidColorBrush x:Key="ThemeLavenderSurfaceBrush" Color="{StaticResource Theme.Lavender.Surface}"/>
    <Color x:Key="Theme.Lavender.Border">#FFD7CFEF</Color>
    <SolidColorBrush x:Key="ThemeLavenderBorderBrush" Color="{StaticResource Theme.Lavender.Border}"/>
    <Color x:Key="Theme.Lavender.Text">#FF7F6AAE</Color>
    <SolidColorBrush x:Key="ThemeLavenderTextBrush" Color="{StaticResource Theme.Lavender.Text}"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Primary.Dark}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Surface.Page}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Surface.Card}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource Surface.Section}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border.Light}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#667EEA"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="RatingStarBrush" Color="#FBBF24"/>

    <Color x:Key="Shadow.Color">#308A7670</Color>
    <SolidColorBrush x:Key="ShadowColorBrush" Color="{StaticResource Shadow.Color}"/>

</ResourceDictionary>
