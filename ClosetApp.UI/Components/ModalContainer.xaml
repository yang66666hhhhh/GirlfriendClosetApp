<UserControl x:Class="ClosetApp.UI.Components.ModalContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="OverlayRoot" Visibility="Collapsed">
        <Border x:Name="Overlay" Background="#66000000" MouseLeftButtonDown="Overlay_Click"/>
        <ContentControl x:Name="ModalContent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="1100" MaxHeight="750"/>
    </Grid>
</UserControl>
