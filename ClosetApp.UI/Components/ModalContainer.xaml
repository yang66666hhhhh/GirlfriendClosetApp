<UserControl x:Class="ClosetApp.UI.Components.ModalContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="OverlayRoot" Visibility="Collapsed">
        <Border x:Name="Overlay" Background="#5C0F1624" Opacity="0" MouseLeftButtonDown="Overlay_Click"/>
        <ContentControl x:Name="ModalContent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        MaxWidth="1280" MaxHeight="900"/>
    </Grid>
</UserControl>
