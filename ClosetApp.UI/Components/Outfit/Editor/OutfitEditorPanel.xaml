<UserControl x:Class="ClosetApp.UI.Components.Outfit.Editor.OutfitEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Color x:Key="PageBgC">#FFF8F6F2</Color>
        <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBgC}"/>
        <Color x:Key="CardBgC">#FFFFFDFC</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgC}"/>
        <Color x:Key="SecondaryBgC">#FFF5F3EE</Color>
        <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBgC}"/>
        <Color x:Key="BorderC">#FFE8E2DC</Color>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderC}"/>
        <Color x:Key="TextPrimaryC">#FF2D2A26</Color>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryC}"/>
        <Color x:Key="TextSecondaryC">#FF5E5A56</Color>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryC}"/>
        <Color x:Key="TextTertiaryC">#FFA39B95</Color>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryC}"/>
        <Color x:Key="AccentC">#FFD9A299</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentC}"/>
        <Color x:Key="AccentLightC">#FFF5EDE9</Color>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightC}"/>

        <DataTemplate x:Key="ClothSelectTemplate">
            <Border Width="100" Height="120" Margin="6"
                    Background="{StaticResource SecondaryBgBrush}"
                    CornerRadius="12" Cursor="Hand"
                    BorderThickness="2" BorderBrush="Transparent"
                    MouseLeftButtonDown="ClothItem_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border CornerRadius="10" ClipToBounds="True" Margin="2">
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}, ConverterParameter=Thumbnail:160}"
                               Stretch="Uniform"/>
                    </Border>
                    <Border Width="20" Height="20" CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,4,0"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                              Fill="White" Width="10" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource ModalCardRoot}"
            MinWidth="760" MinHeight="620"
            MaxWidth="1280" MaxHeight="900"
            Width="980" Height="720">
        <Border x:Name="CardClip"
                Style="{StaticResource ModalCardClip}"
                SizeChanged="CardClip_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                <Grid Margin="24,0">
                    <TextBlock x:Name="TxtHeader" Text="创建搭配" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Form -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
                    <StackPanel>
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="14"
                                Padding="20" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="搭配名称" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SecondaryBgBrush}" CornerRadius="10" Padding="12">
                                    <TextBox x:Name="TxtName" BorderThickness="0" Background="Transparent" FontSize="14"/>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="场景" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbScene">
                                            <ComboBoxItem Content="上班" Tag="Work"/>
                                            <ComboBoxItem Content="约会" Tag="Date"/>
                                            <ComboBoxItem Content="出游" Tag="Travel"/>
                                            <ComboBoxItem Content="派对" Tag="Party"/>
                                            <ComboBoxItem Content="休闲" Tag="Casual"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="季节" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbSeason">
                                            <ComboBoxItem Content="春" Tag="Spring"/>
                                            <ComboBoxItem Content="夏" Tag="Summer"/>
                                            <ComboBoxItem Content="秋" Tag="Autumn"/>
                                            <ComboBoxItem Content="冬" Tag="Winter"/>
                                            <ComboBoxItem Content="四季" Tag="AllSeason"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="满意度" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6"/>
                                <hc:Rate x:Name="RatingControl" Count="5" Value="3" Foreground="#fbbf24" FontSize="22"/>
                            </StackPanel>
                        </Border>

                        <!-- Select Clothes -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="选择衣服" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                <Border x:Name="DressSection" Margin="0,0,0,10">
                                    <Expander Header="连衣裙 (与上衣、裤装、半裙互斥，可搭外套)" IsExpanded="True">
                                        <ItemsControl x:Name="DressList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="TopSection" Margin="0,0,0,10">
                                    <Expander Header="上衣" IsExpanded="True">
                                        <ItemsControl x:Name="TopsList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="OuterwearSection" Margin="0,0,0,10">
                                    <Expander Header="外套" IsExpanded="True">
                                        <ItemsControl x:Name="OuterwearList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="BottomSection" Margin="0,0,0,10">
                                    <Expander Header="裤装" IsExpanded="True">
                                        <ItemsControl x:Name="BottomsList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="SkirtSection" Margin="0,0,0,10">
                                    <Expander Header="半裙" IsExpanded="True">
                                        <ItemsControl x:Name="SkirtsList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="ShoesSection" Margin="0,0,0,10">
                                    <Expander Header="鞋子" IsExpanded="True">
                                        <ItemsControl x:Name="ShoesList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                                <Border x:Name="AccessorySection">
                                    <Expander Header="配饰" IsExpanded="True">
                                        <ItemsControl x:Name="AccessoryList" Margin="0,8,0,0"
                                                      ItemTemplate="{StaticResource ClothSelectTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Live Preview -->
                <Border Grid.Column="1" Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="穿搭预览" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <TextBlock x:Name="TxtPreviewCount" FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                        <Border Background="#F8F5F2" CornerRadius="14" Padding="12">
                            <Grid>
                                <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MinHeight="360">
                                    <TextBlock Text="选择衣服&#x0a;查看穿搭" FontSize="13"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <outfit:OutfitPreviewCanvas x:Name="LivePreview"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterHost}"
                    Padding="24,14">
                <Grid MaxWidth="400" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="取消" Style="{StaticResource ModalCancelButton}" Click="Cancel_Click"/>
                    <Button Grid.Column="2" x:Name="BtnSave" Content="创建搭配" Style="{StaticResource ModalSaveButton}" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Border>
</UserControl>
