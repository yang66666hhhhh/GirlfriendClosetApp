<UserControl x:Class="ClosetApp.UI.Components.Outfit.Controls.OutfitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToNameConverter"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Border x:Name="CardRoot" Width="304"
            Style="{StaticResource Card.Container}">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="3"
                              Opacity="0.06" Color="{DynamicResource Shadow.Color}" Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PreviewRow" Height="344"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview Area -->
            <Border x:Name="PreviewShell"
                    Grid.Row="0"
                    Style="{StaticResource Card.PreviewArea}">
                <Grid>
                    <Border Width="164"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Margin="0,10,0,14"
                            CornerRadius="88"
                            Opacity="0.34">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#30FFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="0.48"/>
                                <GradientStop Color="#05FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="144"
                             Height="15"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,22"
                             Opacity="0.18"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush RadiusX="0.76" RadiusY="0.84">
                                <GradientStop Color="#22000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <outfit:OutfitPreviewCanvas x:Name="PreviewCanvas"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"/>
                    <Border x:Name="ActionOverlay"
                            Style="{StaticResource Card.ActionOverlay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button x:Name="BtnEdit" Content="编辑"
                                    Style="{StaticResource Card.OverlayCapsuleButton}"
                                    Margin="0,0,10,0"/>
                            <Button x:Name="BtnDelete" Content="删除"
                                    Style="{StaticResource Card.OverlayCapsuleButton}"
                                    Foreground="{DynamicResource DangerBrush}"/>
                            <Button x:Name="BtnWorn" Content="今天穿了"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Info Area -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card.InfoArea}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtName"
                                   Style="{StaticResource Card.Title}"/>
                        <TextBlock x:Name="TxtMoodLine"
                                   Style="{StaticResource Card.Subtitle}"
                                   Margin="0,4,0,0"/>
                        <WrapPanel x:Name="MoodChipPanel"
                                   Style="{StaticResource Card.ChipPanel}"/>
                        <TextBlock x:Name="TxtWearInfo"
                                   Style="{StaticResource Card.Tertiary}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnFavorite" Grid.Column="1"
                            Style="{StaticResource Card.FavoriteButtonBase}"
                            Content="♡" FontSize="{StaticResource Card.FavoriteFontSize}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
