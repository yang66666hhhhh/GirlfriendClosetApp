<UserControl x:Class="ClosetApp.UI.Components.Outfit.Controls.OutfitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToNameConverter"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>

        <Storyboard x:Key="CardHoverEnter">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.02" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.02" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="CardHoverLeave">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="CardRoot" Width="304"
            Background="{StaticResource SurfaceCardBrush}"
            CornerRadius="20"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="3"
                              Opacity="0.06" Color="#60000000" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PreviewRow" Height="344"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Outfit Canvas -->
            <Border x:Name="PreviewShell"
                    Grid.Row="0"
                    Background="#F5EFE8"
                    CornerRadius="20,20,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Border Width="164"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Margin="0,10,0,14"
                            CornerRadius="88"
                            Opacity="0.34">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#30FFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="0.48"/>
                                <GradientStop Color="#05FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="144"
                             Height="15"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,22"
                             Opacity="0.18"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush RadiusX="0.76" RadiusY="0.84">
                                <GradientStop Color="#22000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <outfit:OutfitPreviewCanvas x:Name="PreviewCanvas"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"/>
                    <Border x:Name="ActionOverlay" Visibility="Collapsed"
                            Background="#18000000" CornerRadius="18,18,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button x:Name="BtnEdit" Content="编辑" Padding="12,7"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDelete" Content="删除" Padding="12,7"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Foreground="#E88D8D"/>
                            <Button x:Name="BtnWorn" Content="今天穿了" Padding="12,7"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Info -->
            <Border Grid.Row="1"
                    Background="#FFFCFAF8"
                    Padding="16,12,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtMoodLine"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <WrapPanel x:Name="MoodChipPanel"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtWearInfo" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnFavorite" Grid.Column="1"
                            Content="♡" FontSize="18" Padding="8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
