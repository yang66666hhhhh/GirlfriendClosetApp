<UserControl x:Class="ClosetApp.UI.Components.Outfit.Controls.OutfitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToNameConverter"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>

        <Storyboard x:Key="CardHoverEnter">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.02" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.02" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="CardHoverLeave">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="CardRoot" Width="320"
            Background="{StaticResource SurfaceCardBrush}"
            CornerRadius="24"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="20" ShadowDepth="4"
                              Opacity="0.08" Color="#60000000" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Lookbook Preview -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceHeroBrush}" CornerRadius="24,24,0,0" ClipToBounds="True">
                <Grid>
                    <outfit:OutfitPreviewCanvas x:Name="PreviewCanvas"
                                   Width="280" Height="320"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Border x:Name="ActionOverlay" Visibility="Collapsed"
                            Background="#22000000" CornerRadius="24,24,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button x:Name="BtnEdit" Content="编辑" Padding="14,8"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDelete" Content="删除" Padding="14,8"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Foreground="#E88D8D"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Info Bar -->
            <Border Grid.Row="1" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Path x:Name="SceneIcon"
                                  Fill="{StaticResource PrimaryBrush}" Width="12" Height="12"
                                  Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSeason" FontSize="11"
                                       Foreground="#FFA39B95" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnFavorite" Grid.Column="1"
                            Content="♡" FontSize="18" Padding="8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
