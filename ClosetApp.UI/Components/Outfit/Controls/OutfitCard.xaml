<UserControl x:Class="ClosetApp.UI.Components.Outfit.Controls.OutfitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:OutfitSceneToIconConverter x:Key="SceneToIconConverter"/>
        <conv:SeasonToNameConverter x:Key="SeasonToNameConverter"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>

        <Storyboard x:Key="CardHoverEnter">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.02" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.02" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="CardHoverLeave">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="CardRoot" Width="320"
            Background="{StaticResource SurfaceCardBrush}"
            CornerRadius="18"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="4"
                              Opacity="0.07" Color="#60000000" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Outfit Canvas -->
            <Border x:Name="PreviewShell"
                    Grid.Row="0"
                    Background="#F5EFE8"
                    CornerRadius="18,18,0,0"
                    ClipToBounds="True">
                <Grid>
                    <outfit:OutfitPreviewCanvas x:Name="PreviewCanvas"
                                                Margin="18,14,18,8"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"/>
                    <Border x:Name="ActionOverlay" Visibility="Collapsed"
                            Background="#18000000" CornerRadius="18,18,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button x:Name="BtnEdit" Content="编辑" Padding="12,7"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDelete" Content="删除" Padding="12,7"
                                    Style="{StaticResource CapsuleButton}"
                                    FontSize="12" Foreground="#E88D8D"/>
                            <Button x:Name="BtnWorn" Content="今天穿了" Padding="12,7"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Info -->
            <Border Grid.Row="1" Padding="18,16,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtName" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtMoodLine"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtWearInfo" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnFavorite" Grid.Column="1"
                            Content="♡" FontSize="18" Padding="8"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
