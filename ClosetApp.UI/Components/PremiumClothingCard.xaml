<UserControl x:Class="ClosetApp.UI.Components.PremiumClothingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVis"/>
        <conv:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>
        <conv:ClothingTypeToNameConverter x:Key="ClothingTypeToName"/>

        <!-- ═══════════════════════════════════════
             DESIGN TOKENS
             ═══════════════════════════════════════ -->
        <!-- ═══════════════════════════════════════
             ANIMATIONS
             ═══════════════════════════════════════ -->
        <Storyboard x:Key="HoverEnterAnim">
            <DoubleAnimation Storyboard.TargetName="CardFloat"
                             Storyboard.TargetProperty="Y"
                             To="-4" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardShadow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="18" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ImageScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.04" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ImageScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.04" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OverlayActions"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.16"/>
        </Storyboard>

        <Storyboard x:Key="HoverLeaveAnim">
            <DoubleAnimation Storyboard.TargetName="CardFloat"
                             Storyboard.TargetProperty="Y"
                             To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardShadow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="12" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ImageScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ImageScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OverlayActions"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.12"/>
        </Storyboard>

        <Storyboard x:Key="PressAnim">
            <DoubleAnimation Storyboard.TargetName="CardScaleGroup"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.97" Duration="0:0:0.07">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScaleGroup"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.97" Duration="0:0:0.07">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CardLoadAnim" Completed="CardLoadAnim_Completed">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardFloat"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Root: dynamic height via code-behind -->
    <Grid x:Name="CardRoot" Opacity="0"
          MouseEnter="Card_MouseEnter"
          MouseLeave="Card_MouseLeave"
          MouseLeftButtonDown="Card_MouseDown"
          MouseLeftButtonUp="Card_Click">

        <!-- Shadow layer -->
        <Border CornerRadius="18" Margin="2,2,0,0">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow"
                                  BlurRadius="12" ShadowDepth="3"
                                  Opacity="0.06" Color="#B0A090" Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- Main Card -->
        <Border x:Name="MainCard"
                Background="{StaticResource SurfaceCardBrush}"
                CornerRadius="18"
                ClipToBounds="True"
                Cursor="Hand"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScaleGroup" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardFloat" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ IMAGE AREA ═══ -->
                <Border Grid.Row="0"
                        Margin="8,8,8,0"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFAF8F6" Offset="0"/>
                            <GradientStop Color="#FFF4F0EB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="GarmentShadow"
                                 Width="112"
                                 Height="18"
                                 Fill="#2A7C6759"
                                 Opacity="0.18"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,18">
                            <Ellipse.Effect>
                                <BlurEffect Radius="14"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Grid x:Name="GarmentStage"
                              Margin="18,22,18,16"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageBaseScale" ScaleX="1" ScaleY="1"/>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ImageTranslate" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="CardImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Fallback when no image -->
                        <StackPanel x:Name="ImageFallback"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Canvas Width="48" Height="56" HorizontalAlignment="Center">
                                <Ellipse Width="9" Height="9" Canvas.Left="19.5" Canvas.Top="0"
                                         Fill="{StaticResource TextPlaceholderBrush}" Opacity="0.3"/>
                                <Path Stroke="{StaticResource TextPlaceholderBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent" Opacity="0.3"
                                      Data="M24,9 L24,14 M11,19 L22,16 L33,19 M11,19 L7,47 L37,47 L33,19 M14,30 L22,27 L30,30"/>
                            </Canvas>
                        </StackPanel>

                    <!-- Hover overlay buttons (top right, frosted glass) -->
                    <StackPanel x:Name="OverlayActions"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0"
                                Opacity="0">

                        <!-- Favorite -->
                        <Button x:Name="FavoriteBtn"
                                Width="32" Height="32"
                                Margin="0,0,0,8"
                                Background="#90FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Favorite_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FavBorder" Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{TemplateBinding Background}">
                                        <Path x:Name="HeartIcon"
                                              Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                              Fill="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColor}}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FavBorder" Property="Background" Value="#FFFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- More (...) -->
                        <Button x:Name="MoreBtn"
                                Width="32" Height="32"
                                Background="#90FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="More_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MoreBorder" Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock Text="⋯" FontSize="16"
                                                   Foreground="#666666"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MoreBorder" Property="Background" Value="#FFFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Context menu popup -->
                    <Border x:Name="MoreMenu"
                            Background="{StaticResource SurfaceCardBrush}"
                            CornerRadius="10"
                            Padding="6,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,46,8,0"
                            Visibility="Collapsed"
                            Panel.ZIndex="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Content="✏ 编辑"
                                    FontSize="12" FontWeight="Medium"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,6"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Left"
                                    Click="MenuEdit_Click"/>
                            <Button Content="🗑 删除"
                                    FontSize="12" FontWeight="Medium"
                                    Foreground="#E88D8D"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,6"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Left"
                                    Click="MenuDelete_Click"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <!-- ═══ INFO AREA ═══ -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceCardBrush}"
                        MinHeight="74"
                        Padding="12,8,12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TitleText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MetaLineText"
                                   Grid.Row="1"
                                   FontSize="9"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="CaptionLineText"
                                   Grid.Row="2"
                                   FontSize="9"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
