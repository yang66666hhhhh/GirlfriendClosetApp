<UserControl x:Class="ClosetApp.UI.Components.PremiumClothingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVis"/>
        <conv:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor"/>
        <conv:SeasonToNameConverter x:Key="SeasonToName"/>
        <conv:ClothingTypeToNameConverter x:Key="ClothingTypeToName"/>

        <Storyboard x:Key="CardLoadAnim" Completed="CardLoadAnim_Completed">
            <DoubleAnimation Storyboard.TargetName="CardRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="CardRoot" Opacity="0"
          MouseEnter="Card_MouseEnter"
          MouseMove="Card_MouseMove"
          MouseLeave="Card_MouseLeave"
          MouseLeftButtonDown="Card_MouseDown"
          MouseLeftButtonUp="Card_Click">

        <!-- Shadow layer -->
        <Border CornerRadius="{StaticResource Card.Radius}" Margin="2,2,0,0">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow"
                                  BlurRadius="16" ShadowDepth="4"
                                  Opacity="0.06" Color="{DynamicResource Shadow.Color}" Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- Main Card -->
        <Border x:Name="MainCard"
                Style="{StaticResource Card.Container}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ IMAGE AREA ═══ -->
                <Border x:Name="ImageAreaBorder"
                        Grid.Row="0"
                        Margin="8,8,8,0"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource Surface.ImageArea}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Surface.Hero}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="GarmentShadow"
                                 Width="112"
                                 Height="18"
                                 Fill="{DynamicResource ShadowColorBrush}"
                                 Opacity="0.18"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,18">
                            <Ellipse.Effect>
                                <BlurEffect Radius="14"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Grid x:Name="GarmentStage"
                              Margin="18,22,18,16"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageBaseScale" ScaleX="1" ScaleY="1"/>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ImageTranslate" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="CardImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Fallback when no image -->
                        <StackPanel x:Name="ImageFallback"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Canvas Width="48" Height="56" HorizontalAlignment="Center">
                                <Ellipse Width="9" Height="9" Canvas.Left="19.5" Canvas.Top="0"
                                         Fill="{DynamicResource TextPlaceholderBrush}" Opacity="0.3"/>
                                <Path Stroke="{DynamicResource TextPlaceholderBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent" Opacity="0.3"
                                      Data="M24,9 L24,14 M11,19 L22,16 L33,19 M11,19 L7,47 L37,47 L33,19 M14,30 L22,27 L30,30"/>
                            </Canvas>
                        </StackPanel>

                        <Button x:Name="BtnMore"
                                Content="⋯"
                                Style="{StaticResource WardrobeCard.MoreButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,12,0"
                                ToolTip="更多操作"
                                Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu">
                                    <MenuItem Header="编辑" Click="MenuEdit_Click"/>
                                    <MenuItem Header="删除" Click="MenuDelete_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ INFO AREA ═══ -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card.InfoArea}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Style="{StaticResource Card.Title}"/>
                            <TextBlock x:Name="MetaLineText"
                                       Style="{StaticResource Card.Subtitle}"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                            <WrapPanel x:Name="ChipPanel"
                                       Style="{StaticResource Card.ChipPanel}"/>
                        </StackPanel>
                        <Button x:Name="BtnFavorite" Grid.Column="1"
                                Style="{StaticResource Card.FavoriteButtonBase}"
                                Content="♡"
                                FontSize="{StaticResource Card.FavoriteFontSize}"
                                Click="Favorite_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Popup x:Name="HoverInfoPopup"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=CardRoot}"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="False"
               IsHitTestVisible="False">
            <Border Style="{StaticResource WardrobeCard.HoverInfoPopup}">
                <StackPanel>
                    <TextBlock x:Name="HoverInfoTitleText"
                               Style="{StaticResource WardrobeCard.HoverInfoTitle}"/>
                    <TextBlock Text="整理建议"
                               Style="{StaticResource WardrobeCard.HoverInfoLabel}"/>
                    <TextBlock x:Name="HoverInfoDetailText"
                               Style="{StaticResource WardrobeCard.HoverInfoBody}"
                               Margin="0,5,0,0"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前状态"
                                       Style="{StaticResource WardrobeCard.HoverInfoLabel}"/>
                            <TextBlock x:Name="HoverInfoStatusText"
                                       Style="{StaticResource WardrobeCard.HoverInfoValue}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="加入衣柜"
                                       Style="{StaticResource WardrobeCard.HoverInfoLabel}"/>
                            <TextBlock x:Name="HoverInfoCreatedText"
                                       Style="{StaticResource WardrobeCard.HoverInfoValue}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="HoverInfoNotesCard"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="备注"
                                       Style="{StaticResource WardrobeCard.HoverInfoLabel}"/>
                            <TextBlock x:Name="HoverInfoNotesText"
                                       Style="{StaticResource WardrobeCard.HoverInfoBody}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
