<UserControl x:Class="ClosetApp.UI.Components.Shared.ThemeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="CardRootButton"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            MinHeight="58"
            RenderTransformOrigin="0.5,0.5"
            Click="BtnSelect_Click">
        <Button.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform Y="0"/>
            </TransformGroup>
        </Button.RenderTransform>
        <Border x:Name="CardBorder"
                CornerRadius="16"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ThemeChoiceDot"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        BorderThickness="1"/>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TxtName"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateHint"
                               Margin="0,2,0,0"
                               FontSize="{DynamicResource FontSize.Meta}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel x:Name="ThemeSwatchRow"
                           Grid.Column="3"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center">
                    <Border x:Name="SwatchPrimary" Width="10" Height="10" CornerRadius="5" Margin="0,0,4,0"/>
                    <Border x:Name="SwatchSoft" Width="10" Height="10" CornerRadius="5" Margin="0,0,4,0"/>
                    <Border x:Name="SwatchSurface" Width="10" Height="10" CornerRadius="5"/>
                </WrapPanel>

                <Border x:Name="ActionPill"
                        Grid.Column="4"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        Padding="8,3"
                        BorderThickness="1">
                    <TextBlock x:Name="ActionPillText"
                               FontSize="{DynamicResource FontSize.Tiny}"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>
