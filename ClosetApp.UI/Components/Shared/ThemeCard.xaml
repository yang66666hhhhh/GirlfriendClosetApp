<UserControl x:Class="ClosetApp.UI.Components.Shared.ThemeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="CardRootButton"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            MinHeight="172"
            RenderTransformOrigin="0.5,0.5"
            Click="BtnSelect_Click">
        <Button.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform Y="0"/>
            </TransformGroup>
        </Button.RenderTransform>
        <Border x:Name="CardBorder"
                CornerRadius="16"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="TxtName"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateHint"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="SelectedBadge"
                            Grid.Column="1"
                            CornerRadius="8"
                            Padding="8,3"
                            Visibility="Collapsed">
                        <TextBlock Text="当前使用"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border x:Name="PreviewBorder"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        CornerRadius="14"
                        Padding="12">
                    <Grid x:Name="PreviewHost"
                          MinHeight="76">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="PreviewToneRail">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel x:Name="TonePreviewPanel"
                                       VerticalAlignment="Center">
                                <Border x:Name="SwatchPrimary" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0"/>
                                <Border x:Name="SwatchSoft" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0"/>
                                <Border x:Name="SwatchSurface" Width="18" Height="18" CornerRadius="9"/>
                            </WrapPanel>
                            <Border x:Name="ActionPill"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="9"
                                    Padding="8,3"
                                    BorderThickness="1">
                                <TextBlock x:Name="ActionPillText"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtDescription"
                                   Grid.Row="1"
                                   FontSize="11"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ActionHint"
                           Grid.Row="2"
                           Margin="0,12,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Button>
</UserControl>
