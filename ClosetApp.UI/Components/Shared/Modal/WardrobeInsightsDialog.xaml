<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.WardrobeInsightsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InsightCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="InsightTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="InsightValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="InsightHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="DistributionChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHeroBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource ModalCardRoot}"
                Width="520"
                MinHeight="400"
                MaxHeight="720">
            <Border Style="{StaticResource ModalCardClip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="数据洞察" Style="{StaticResource ModalHeaderTitle}"/>
                                <TextBlock Style="{StaticResource ModalHeaderSubtitle}">
                                    <Run Text="你的衣柜使用情况一目了然"/>
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource ModalCloseButton}"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="28,0,28,16">
                        <StackPanel>
                            <!-- 总览卡片 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource InsightCard}">
                                    <StackPanel>
                                        <TextBlock Text="总穿着" Style="{StaticResource InsightHint}"/>
                                        <TextBlock x:Name="TotalWearCountText" Style="{StaticResource InsightValue}"/>
                                        <TextBlock Text="次" Style="{StaticResource InsightHint}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource InsightCard}">
                                    <StackPanel>
                                        <TextBlock Text="活跃天数" Style="{StaticResource InsightHint}"/>
                                        <TextBlock x:Name="ActiveDaysText" Style="{StaticResource InsightValue}"/>
                                        <TextBlock Text="天" Style="{StaticResource InsightHint}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource InsightCard}">
                                    <StackPanel>
                                        <TextBlock Text="连续记录" Style="{StaticResource InsightHint}"/>
                                        <TextBlock x:Name="StreakText" Style="{StaticResource InsightValue}"/>
                                        <TextBlock x:Name="StreakHintText" Style="{StaticResource InsightHint}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 搭配使用率 -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="搭配使用率" Style="{StaticResource InsightTitle}"/>
                                        <TextBlock x:Name="WearRateValueText"
                                                   Style="{StaticResource InsightTitle}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0" Height="8">
                                        <Border Background="{DynamicResource BorderLightBrush}" CornerRadius="4"/>
                                        <Border x:Name="WearRateBar" CornerRadius="4" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock x:Name="WornCountText" Style="{StaticResource InsightHint}"/>
                                        <TextBlock x:Name="NeverWornText" Style="{StaticResource InsightHint}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 最常穿 Top5 -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="最常穿搭配" Style="{StaticResource InsightTitle}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="TopWornList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Rank}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="8,0"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding WearCountText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding LastWornText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoTopWornText"
                                               Text="暂无穿着记录"
                                               Style="{StaticResource InsightHint}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- 场景分布 -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="场景分布" Style="{StaticResource InsightTitle}" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="SceneDistributionPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 季节分布 -->
                            <Border Style="{StaticResource InsightCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="季节分布" Style="{StaticResource InsightTitle}" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="SeasonDistributionPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 闲置预警 -->
                            <Border Style="{StaticResource InsightCard}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="闲置预警" Style="{StaticResource InsightTitle}"/>
                                        <TextBlock x:Name="IdleSummaryText"
                                                   Style="{StaticResource InsightHint}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl x:Name="IdleList" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SeasonText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding IdleText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoIdleText"
                                               Text="所有搭配近期都有穿过，继续保持！"
                                               Style="{StaticResource InsightHint}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Style="{StaticResource ModalFooterHost}"
                            Padding="28,16">
                        <Button Content="关闭"
                                Style="{StaticResource CapsuleButton}"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
