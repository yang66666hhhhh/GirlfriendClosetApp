<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.GeneratedImagePreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCardRoot}"
            Width="980"
            MaxWidth="1120"
            MaxHeight="860">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="效果图预览"
                                       Style="{StaticResource ModalHeaderTitle}"/>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="查看当前搭配已保存的效果图历史。"
                                       Style="{StaticResource ModalHeaderSubtitle}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="28,22,28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="16">
                        <Grid>
                            <Border Background="{DynamicResource SurfaceHeroBrush}"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"/>
                            </Border>

                            <Border x:Name="PrimaryBadge"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Visibility="Collapsed">
                                <TextBlock Text="首选图"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="当前查看"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtMeta"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtHint"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="历史效果图"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="2,16,0,10"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Margin="0,0,0,10"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Tag="{Binding Id}"
                                                        Click="HistoryItem_Click">
                                                    <Border CornerRadius="12"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource SurfaceHeroBrush}">
                                                        <Image Source="{Binding ThumbnailSource}"
                                                               Height="108"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Button>

                                                <StackPanel Grid.Column="2">
                                                    <WrapPanel>
                                                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="8,3"
                                                                Margin="0,0,8,8">
                                                            <TextBlock Text="首选图"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Border Background="{DynamicResource SurfaceCardBrush}"
                                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="8,3"
                                                                Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding CreatedAtText}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding ModelText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11.5"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="20,14">
                    <Button Content="关闭"
                            Style="{StaticResource ModalSaveButton}"
                            HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
