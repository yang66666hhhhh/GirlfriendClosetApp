<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.OutfitHistoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="RecentSectionTriggerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CapsuleButton}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#E1EAF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6FAFF"/>
                    <Setter Property="BorderBrush" Value="#D7E3F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RecentWornRecordTemplate">
            <Border Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8,8"
                    Margin="0,0,0,2"
                    Cursor="Hand"
                    MouseLeftButtonDown="RecentWornItem_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FBFDFF"/>
                                <Setter Property="BorderBrush" Value="#E6EEF8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#F5FAFF"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="3"
                            Height="34"
                            VerticalAlignment="Center"
                            CornerRadius="1.5"
                            Background="{DynamicResource PrimaryBrush}"
                            Opacity="0"
                            Margin="0,1,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DateText}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding OutfitName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimeText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="·"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding MetaText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="3"
                            Margin="12,0,0,0"
                            Padding="7,3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="#D5E3F5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="预览中"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource ModalCardRoot}"
                Width="920"
                MaxHeight="780">
            <Border Style="{StaticResource ModalCardClip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="穿着记录"
                                           Style="{StaticResource ModalHeaderTitle}"/>
                                <TextBlock Text="最近穿着和月历放在一起，回看今天之前都更顺手。"
                                           Style="{StaticResource ModalHeaderSubtitle}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource ModalCloseButton}"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,20">
                            <Grid Margin="4,0,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="最近穿着"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecentSectionSummaryText"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               Margin="10,1,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="OpenRecentSectionButton"
                                        Grid.Column="1"
                                        Style="{StaticResource RecentSectionTriggerButtonStyle}"
                                        VerticalAlignment="Center"
                                        ToolTip="查看最近穿着"
                                        Click="OpenRecentSection_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="16"
                                                        Height="16">
                                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          Data="M8,3 C4.5,3 1.9,5.2 0.8,8 C1.9,10.8 4.5,13 8,13 C11.5,13 14.1,10.8 15.2,8 C14.1,5.2 11.5,3 8,3 z M8,5.2 C9.55,5.2 10.8,6.45 10.8,8 C10.8,9.55 9.55,10.8 8,10.8 C6.45,10.8 5.2,9.55 5.2,8 C5.2,6.45 6.45,5.2 8,5.2 z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="最近穿着"
                                                       Margin="6,0,0,0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <Border Margin="0,10,0,0"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="穿搭日历"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CalendarSummaryText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="‹"
                                                Style="{StaticResource CapsuleButton}"
                                                MinWidth="40"
                                                Padding="11,7"
                                                Click="PrevMonth_Click"/>
                                        <TextBlock Text="{Binding CalendarMonthText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>
                                        <Button Content="›"
                                                Style="{StaticResource CapsuleButton}"
                                                MinWidth="40"
                                                Padding="11,7"
                                                Click="NextMonth_Click"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Grid.Row="1" Columns="7" Margin="0,16,0,6">
                                    <TextBlock Text="一" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="二" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="三" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="四" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="五" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="六" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="日" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                </UniformGrid>

                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding CalendarDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinHeight="66"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="1"
                                                    Padding="8"
                                                    Margin="3"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="CalendarDay_Click">
                                                <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRecords}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderDividerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DayText}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource SurfacePageBrush}"
                                                                BorderBrush="{DynamicResource BorderDividerBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="5,2"
                                                                Visibility="{Binding HasRecords, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding DensityText}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="8.5"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1"
                                                                Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding FirstOutfitName}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="9.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding DensitySummaryText}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   FontSize="8.5"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasRecords, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource ModalFooterHost}" Padding="20,12">
                        <Button Content="关闭"
                                Style="{StaticResource ModalSaveButton}"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>
                    </Border>

                    <Grid x:Name="DayDetailsOverlay"
                          Grid.RowSpan="3"
                          Visibility="Collapsed"
                          Panel.ZIndex="10">
                        <Border Background="#30000000"
                                MouseLeftButtonDown="DayDetailsBackdrop_Click"/>
                        <Grid Margin="24,20,24,20">
                            <ContentControl x:Name="DayDetailsHost"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Popup x:Name="RecentWornPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               Opened="RecentWornPopup_Opened"
               Closed="RecentWornPopup_Closed">
            <Grid Background="Transparent"
                  Margin="8">
            <Border Width="468"
                    CornerRadius="18"
                    Background="#01FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="5"
                                      Opacity="0.1"
                                      Color="#564A61"/>
                </Border.Effect>
            </Border>
            <Border Background="#FFFFFFFF"
                    BorderBrush="#E9E2EC"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.34*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.66*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  MaxHeight="292"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentWornRecords}"
                                      ItemTemplate="{StaticResource RecentWornRecordTemplate}"/>
                    </ScrollViewer>

                    <Border x:Name="CurrentPreviewPanel"
                            Grid.Column="2"
                            Background="#FBFCFF"
                            BorderBrush="#EDF2F8"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="10"
                            VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Padding="7,3"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="#D5E3F5"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="当前预览"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding OutfitName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FocusSummaryText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <Border Height="196"
                                    Margin="0,8,0,0"
                                    Background="{DynamicResource SurfacePageBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid Margin="8">
                                    <Border Width="80"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Stretch"
                                            Margin="0,8,0,12"
                                            CornerRadius="42"
                                            Opacity="0.16"
                                            Visibility="{Binding HasPreviewClothes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#24DCEAFF" Offset="0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse Width="70"
                                             Height="10"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,10"
                                             Opacity="0.07"
                                             IsHitTestVisible="False"
                                             Visibility="{Binding HasPreviewClothes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush RadiusX="0.78" RadiusY="0.9">
                                                <GradientStop Color="#26000000" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <outfit:OutfitPreviewCanvas Clothes="{Binding PreviewClothes}"
                                                                Width="146"
                                                                Height="162"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasPreviewClothes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="这条记录暂时没有可预览的单品"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="9.5"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="130"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasPreviewClothes, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
