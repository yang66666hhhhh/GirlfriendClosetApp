<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.GenerateOutfitImagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCardRoot}"
            MinWidth="620"
            MinHeight="620"
            MaxWidth="900"
            MaxHeight="820"
            Width="720"
            Height="720">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="24,0">
                        <TextBlock Text="生成搭配效果图"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtReadinessTitle"
                                           Text="生成前检查"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtReadinessBody"
                                           Style="{StaticResource PageSectionBodyText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SavedImagesSection"
                                Background="{DynamicResource SurfaceCardBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="已保存效果图"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtSavedImagesSummary"
                                           Style="{StaticResource PageSectionBodyText}"
                                           Margin="0,6,0,0"/>
                                <ItemsControl x:Name="SavedImagesList"
                                              Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PageInsetCard}"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="124"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Height="164"
                                                            Background="{DynamicResource SurfaceHeroBrush}"
                                                            CornerRadius="12"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding ThumbnailSource}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2">
                                                        <WrapPanel>
                                                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="8,3"
                                                                    Margin="0,0,8,8">
                                                                <TextBlock Text="{Binding PrimaryBadgeText}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="8,3"
                                                                    Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <TextBlock Text="{Binding ModelText}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding MetaText}"
                                                                   Style="{StaticResource PageSectionBodyText}"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ReuseHint}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"/>

                                                        <WrapPanel Margin="0,12,0,0">
                                                            <Button Content="{Binding PrimaryActionText}"
                                                                    Style="{StaticResource PageToolbarCapsuleButton}"
                                                                    Padding="12,6"
                                                                    Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanSetPrimary}"
                                                                    Click="SetPrimary_Click"/>
                                                            <Button Content="删除"
                                                                    Style="{StaticResource PageToolbarCapsuleButton}"
                                                                    Padding="12,6"
                                                                    Margin="8,0,0,0"
                                                                    Foreground="{DynamicResource DangerBrush}"
                                                                    Tag="{Binding Id}"
                                                                    Click="DeleteSavedImage_Click"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="14" Padding="18">
                            <StackPanel>
                                <TextBlock Text="再生成一张"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="修改场景和氛围可以保留多张历史；相同条件下会优先复用已保存结果。"
                                           Style="{StaticResource PageSectionBodyText}"
                                           Margin="0,6,0,0"/>

                                <UniformGrid Columns="2" Rows="3" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="场景" Style="{StaticResource PageFieldLabelText}"/>
                                        <ComboBox x:Name="CmbScene" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="姿态" Style="{StaticResource PageFieldLabelText}"/>
                                        <ComboBox x:Name="CmbPose" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="背景" Style="{StaticResource PageFieldLabelText}"/>
                                        <ComboBox x:Name="CmbBackgroundStyle" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="构图" Style="{StaticResource PageFieldLabelText}"/>
                                        <ComboBox x:Name="CmbFraming" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="情绪" Style="{StaticResource PageFieldLabelText}"/>
                                        <ComboBox x:Name="CmbMood" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Border Background="{DynamicResource SurfaceSectionBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="或者手动上传"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="如果你已经在别处生成好了效果图，也可以直接上传到这套搭配，和远端生成结果一起管理。"
                                                   Style="{StaticResource PageSectionBodyText}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                        <Button x:Name="BtnUpload"
                                                Content="上传并保存效果图"
                                                Style="{StaticResource PageToolbarCapsuleButton}"
                                                Padding="12,6"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Click="Upload_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="24,14">
                    <Grid MaxWidth="420" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="关闭"
                                Style="{StaticResource ModalCancelButton}"
                                Click="Close_Click"/>
                        <Button x:Name="BtnGenerate"
                                Grid.Column="2"
                                Content="生成并保存"
                                Style="{StaticResource ModalSaveButton}"
                                Click="Generate_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
