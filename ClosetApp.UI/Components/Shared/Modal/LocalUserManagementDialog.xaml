<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.LocalUserManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <UserControl.Resources>
        <Style x:Key="UserManager.Input" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserManager.PasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="InputShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserManager.SecondaryButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModalSaveButton}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.DangerButton" TargetType="Button" BasedOn="{StaticResource ModalDangerButton}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="UserManager.ListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ModalCardRoot}"
            Width="920"
            MinHeight="620">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="28,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="用户管理"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="为每个本地用户维护独立衣柜工作区"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="308"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="新增本地用户"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="账号"
                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                    <TextBox x:Name="TxtNewAccountName"
                                             Style="{StaticResource UserManager.Input}"
                                             Tag="例如：xiaoyu"/>
                                    <TextBlock Text="显示名称"
                                               Margin="0,10,0,6"
                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                    <TextBox x:Name="TxtNewUserName"
                                             Style="{StaticResource UserManager.Input}"
                                             Tag="例如：小鱼"/>
                                    <TextBlock Text="初始密码"
                                               Margin="0,10,0,6"
                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                    <PasswordBox x:Name="NewUserPasswordBox"
                                                 Style="{StaticResource UserManager.PasswordInput}"/>
                                    <TextBlock Text="快捷 PIN（可选）"
                                               Margin="0,10,0,6"
                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                    <PasswordBox x:Name="NewUserPinBox"
                                                 Style="{StaticResource UserManager.PasswordInput}"/>
                                    <Button Content="新增用户"
                                            Margin="0,14,0,0"
                                            Style="{StaticResource UserManager.PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="CreateUser_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="UsersList"
                                 Grid.Row="1"
                                 Margin="0,16,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource UserManager.ListItem}"
                                 SelectionChanged="UsersList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <shared:LocalUserAvatar Width="44"
                                                                Height="44"
                                                                AvatarPath="{Binding AvatarPath}"
                                                                Initial="{Binding AvatarInitial}"
                                                                IsCurrent="{Binding IsCurrent}"/>
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SummaryText}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AccountHint}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextPlaceholderBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="22"
                            DataContext="{Binding SelectedItem, ElementName=UsersList}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <shared:LocalUserAvatar Width="62"
                                                        Height="62"
                                                        AvatarPath="{Binding AvatarPath}"
                                                        Initial="{Binding AvatarInitial}"
                                                        IsCurrent="{Binding IsCurrent}"/>
                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SummaryText}"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="账号" Style="{StaticResource UserManager.FieldLabel}"/>
                                    <TextBox Text="{Binding EditableAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UserManager.Input}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="显示名称" Style="{StaticResource UserManager.FieldLabel}"/>
                                    <TextBox Text="{Binding EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UserManager.Input}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="重置密码" Style="{StaticResource UserManager.FieldLabel}"/>
                                    <PasswordBox x:Name="ResetPasswordBox"
                                                 Style="{StaticResource UserManager.PasswordInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="重置 PIN（留空清除）" Style="{StaticResource UserManager.FieldLabel}"/>
                                    <PasswordBox x:Name="ResetPinBox"
                                                 Style="{StaticResource UserManager.PasswordInput}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,18,0,0"
                                    Background="{DynamicResource SurfaceSectionBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="工作区规则"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RuleText}"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4"
                                  Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="删除用户"
                                        Grid.Column="0"
                                        Style="{StaticResource UserManager.DangerButton}"
                                        IsEnabled="{Binding CanDelete}"
                                        Click="DeleteUser_Click"/>
                                <Button Grid.Column="2"
                                        Content="保存"
                                        Style="{StaticResource UserManager.SecondaryButton}"
                                        IsEnabled="{Binding HasSelection}"
                                        Click="SaveUser_Click"/>
                                <Button Grid.Column="4"
                                        Content="重置凭证"
                                        Style="{StaticResource UserManager.SecondaryButton}"
                                        IsEnabled="{Binding CanResetCredential}"
                                        Click="ResetCredential_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="28,14">
                    <Button Content="关闭"
                            Style="{StaticResource ModalCancelButton}"
                            HorizontalAlignment="Right"
                            MinWidth="96"
                            Click="Close_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
