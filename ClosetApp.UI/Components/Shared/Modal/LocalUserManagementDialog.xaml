<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.LocalUserManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <UserControl.Resources>
        <Style x:Key="UserManager.SecondaryButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModalSaveButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.DangerButton" TargetType="Button" BasedOn="{StaticResource ModalDangerButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserManager.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="UserManager.SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="UserManager.MetaChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="UserManager.HeroMetaChip" TargetType="Border" BasedOn="{StaticResource UserManager.MetaChip}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="UserManager.InfoCard" TargetType="Border" BasedOn="{StaticResource UserManager.SectionCard}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="UserManager.ListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ModalCardRoot}"
            Width="1020"
            Height="756"
            MinWidth="980"
            MinHeight="700">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="28,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="用户管理"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="28,18,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="CurrentSessionBar"
                            Style="{StaticResource UserManager.SectionCard}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <shared:LocalUserAvatar x:Name="CurrentSessionAvatar"
                                                    Width="34"
                                                    Height="34"
                                                    VerticalAlignment="Center"
                                                    ShowStatus="False"/>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCurrentSessionUser"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtCurrentSessionContext"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="3"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center">
                                <Border Style="{StaticResource UserManager.MetaChip}"
                                        Margin="0,0,8,0"
                                        Padding="10,6">
                                    <StackPanel>
                                        <TextBlock Text="总用户"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtTotalUsers"
                                                   Margin="0,2,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource UserManager.MetaChip}"
                                        Margin="0"
                                        Padding="10,6">
                                    <StackPanel>
                                        <TextBlock Text="普通用户"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtMemberUsers"
                                                   Margin="0,2,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="MemberManagementCard"
                            Grid.Row="2"
                            Style="{StaticResource UserManager.SectionCard}"
                            Background="{DynamicResource SurfaceCardBrush}"
                            Padding="26,26,26,32">
                        <Grid x:Name="UserManagerDetailRegion">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MemberNavigatorCard"
                                    Grid.Column="0"
                                    Style="{StaticResource UserManager.SectionCard}"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="MemberSectionHeader">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="MemberListActionBar">
                                            <TextBlock Text="成员列表"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <Button x:Name="BtnCreateUserInline"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Content="新增用户"
                                                Style="{StaticResource UserManager.PrimaryButton}"
                                                Click="ShowCreateUser_Click"/>
                                    </Grid>

                                    <Border x:Name="UserDirectorySearchCard"
                                            Grid.Row="2"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Padding="10">
                                        <TextBox x:Name="TxtUserSearch"
                                                 Style="{StaticResource WorkbenchTextInput}"
                                                 TextChanged="UserSearch_TextChanged"/>
                                    </Border>

                                    <Border x:Name="CreateUserPanel"
                                            Grid.Row="4"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="新增用户"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <Grid x:Name="CreateUserFormGrid"
                                                  Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="账号"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <TextBox x:Name="TxtNewAccountName"
                                                             Style="{StaticResource WorkbenchTextInput}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="显示名称"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <TextBox x:Name="TxtNewUserName"
                                                             Style="{StaticResource WorkbenchTextInput}"/>
                                                </StackPanel>

                                                <Grid x:Name="CreateUserCredentialGrid"
                                                      Grid.Row="2"
                                                      Grid.ColumnSpan="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="初始密码"
                                                                   Style="{StaticResource UserManager.FieldLabel}"/>
                                                        <PasswordBox x:Name="NewUserPasswordBox"
                                                                     Style="{StaticResource WorkbenchPasswordInput}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="PIN（可选）"
                                                                   Style="{StaticResource UserManager.FieldLabel}"/>
                                                        <PasswordBox x:Name="NewUserPinBox"
                                                                     Style="{StaticResource WorkbenchPasswordInput}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Button Grid.Row="4"
                                                        Grid.ColumnSpan="3"
                                                        Content="创建用户"
                                                        Style="{StaticResource UserManager.PrimaryButton}"
                                                        HorizontalAlignment="Right"
                                                        Click="CreateUser_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="UsersList"
                                             Grid.Row="6"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource UserManager.ListItem}"
                                             SelectionChanged="UsersList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <shared:LocalUserAvatar Width="46"
                                                                            Height="46"
                                                                            AvatarPath="{Binding AvatarPath}"
                                                                            Initial="{Binding AvatarInitial}"
                                                                            IsCurrent="{Binding IsCurrent}"/>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EditableName}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SummaryText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AccountHint}"
                                                                   Margin="0,3,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextPlaceholderBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Top"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryDarkBrush}"
                                                               Text="{Binding ListBadgeText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SelectedUserWorkbench"
                                            DataContext="{Binding SelectedItem, ElementName=UsersList}">
                                    <Border x:Name="SelectedUserHeroCard"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Background="{DynamicResource PrimaryLightBrush}"
                                            Padding="26,26,26,24"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Width="138"
                                                        VerticalAlignment="Top">
                                                <shared:LocalUserAvatar x:Name="SelectedUserAvatar"
                                                                        Width="112"
                                                                        Height="112"
                                                                        HorizontalAlignment="Left"
                                                                        AvatarPath="{Binding AvatarPath}"
                                                                        Initial="{Binding AvatarInitial}"
                                                                        IsCurrent="{Binding IsCurrent}"/>
                                                <WrapPanel Margin="0,16,0,0"
                                                           ItemHeight="38">
                                                    <Button Content="更换头像"
                                                            Style="{StaticResource UserManager.SecondaryButton}"
                                                            Click="SelectAvatar_Click"/>
                                                    <Button Content="移除头像"
                                                            Margin="10,0,0,0"
                                                            Style="{StaticResource UserManager.SecondaryButton}"
                                                            IsEnabled="{Binding HasAvatar}"
                                                            Click="RemoveAvatar_Click"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top">
                                                <TextBlock Text="{Binding EditableName}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AccountHandle}"
                                                           Margin="0,6,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                <WrapPanel Margin="0,14,0,0">
                                                    <Border Style="{StaticResource UserManager.HeroMetaChip}">
                                                        <TextBlock Text="{Binding RoleText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource UserManager.HeroMetaChip}">
                                                        <TextBlock Text="{Binding SessionText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource UserManager.HeroMetaChip}">
                                                        <TextBlock Text="{Binding CredentialSummary}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding ActivityText}"
                                                           Margin="0,14,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4"
                                                        VerticalAlignment="Top">
                                                <Button Content="保存资料"
                                                        Style="{StaticResource UserManager.PrimaryButton}"
                                                        IsEnabled="{Binding HasSelection}"
                                                        Click="SaveUser_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SelectedUserAccountSection"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Padding="26,22,26,24"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="账号资料"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="登录账号与展示名称"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="账号"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <TextBox Text="{Binding EditableAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource WorkbenchTextInput}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="显示名称"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <TextBox Text="{Binding EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource WorkbenchTextInput}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SelectedUserSecuritySection"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Padding="26,22,26,24"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="安全"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="更新密码与可选 PIN"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="新密码"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <PasswordBox x:Name="ResetPasswordBox"
                                                                 Style="{StaticResource WorkbenchPasswordInput}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="新 PIN（可选）"
                                                               Style="{StaticResource UserManager.FieldLabel}"/>
                                                    <PasswordBox x:Name="ResetPinBox"
                                                                 Style="{StaticResource WorkbenchPasswordInput}"/>
                                                </StackPanel>
                                            </Grid>

                                            <DockPanel Margin="0,16,0,0"
                                                       LastChildFill="False">
                                                <TextBlock Text="{Binding CredentialSummary}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Content="重置凭证"
                                                        Margin="16,0,0,0"
                                                        Style="{StaticResource UserManager.SecondaryButton}"
                                                        IsEnabled="{Binding CanResetCredential}"
                                                        Click="ResetCredential_Click"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SelectedUserDangerSection"
                                            Style="{StaticResource UserManager.SectionCard}"
                                            Padding="26,22,26,24"
                                            Background="{DynamicResource SurfaceCardBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="危险操作"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DangerHintText}"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Row="2"
                                                    Content="删除用户"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource UserManager.DangerButton}"
                                                    IsEnabled="{Binding CanDelete}"
                                                    Click="DeleteUser_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="28,14">
                    <Button Content="关闭"
                            HorizontalAlignment="Right"
                            MinWidth="96"
                            Style="{StaticResource ModalCancelButton}"
                            Click="Close_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
