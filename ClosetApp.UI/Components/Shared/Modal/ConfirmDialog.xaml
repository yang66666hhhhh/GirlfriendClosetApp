<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCardRoot}"
            Width="440">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="28,26,28,22">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource ModalHeaderTitle}"
                               FontSize="22"
                               Text="确认操作"/>
                    <TextBlock x:Name="BodyText"
                               Style="{StaticResource ModalHeaderSubtitle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <Border Background="{StaticResource SurfaceSectionBrush}"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,20,0,0">
                        <TextBlock x:Name="DetailText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="20,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Content="取消"
                                Style="{StaticResource ModalCancelButton}"
                                Margin="0,0,12,0"
                                Click="CancelButton_Click"/>
                        <Button x:Name="ConfirmButton"
                                Content="确认"
                                Style="{StaticResource ModalDangerButton}"
                                Click="ConfirmButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
