<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.PersonalCenterDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <UserControl.Resources>
        <Style x:Key="PersonalCenter.SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="PersonalCenter.TabButton" TargetType="RadioButton" BasedOn="{StaticResource AppSegmentedTabButton}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="PersonalCenter.TabRail" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style x:Key="PersonalCenter.SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="138"/>
        </Style>

        <Style x:Key="PersonalCenter.SubtleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PersonalCenter.ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="PersonalCenter.HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PersonalCenter.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource ModalCardRoot}"
            Width="980"
            Height="780"
            MinWidth="920"
            MinHeight="700"
            MaxWidth="1160"
            MaxHeight="920">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <shared:LocalUserAvatar x:Name="AccountAvatar"
                                                Width="56"
                                                Height="56"
                                                VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderName"
                                       Text="个人中心"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtHeaderMeta"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="28,20,28,20">
                    <StackPanel>
                        <Border x:Name="PersonalCenterTabRail"
                                Style="{StaticResource AppSegmentedTabShell}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,18">
                            <StackPanel x:Name="PersonalCenterTabBar"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <RadioButton x:Name="BtnAccountTab"
                                             Content="账号资料"
                                             GroupName="PersonalCenterTab"
                                             IsChecked="True"
                                             Style="{StaticResource PersonalCenter.TabButton}"
                                             Checked="AccountTab_Checked"/>
                                <RadioButton x:Name="BtnProfileTab"
                                             Content="个人档案"
                                             GroupName="PersonalCenterTab"
                                             Margin="2,0,0,0"
                                             Style="{StaticResource PersonalCenter.TabButton}"
                                             Checked="ProfileTab_Checked"/>
                                <RadioButton x:Name="BtnSecurityTab"
                                             Content="安全"
                                             GroupName="PersonalCenterTab"
                                             Margin="2,0,0,0"
                                             Style="{StaticResource PersonalCenter.TabButton}"
                                             Checked="SecurityTab_Checked"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="AccountPanel">
                            <Border x:Name="AccountSummaryHero"
                                    Style="{StaticResource PersonalCenter.SectionCard}"
                                    Margin="0,0,0,18"
                                    Background="{DynamicResource SurfaceSectionBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="132"
                                            Height="132"
                                            CornerRadius="18"
                                            Background="{DynamicResource SurfaceCardBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <shared:LocalUserAvatar x:Name="AccountAvatarPreview"
                                                                    Width="96"
                                                                    Height="96"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ShowStatus="False"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="账号资料"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource PersonalCenter.SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="账号"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TxtSummaryAccountName"
                                                               Margin="0,4,0,0"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource PersonalCenter.SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="角色"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TxtSummaryRole"
                                                               Margin="0,4,0,0"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource PersonalCenter.SummaryCard}"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="头像状态"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TxtSummaryAvatarState"
                                                               Margin="0,4,0,0"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="侧边栏与登录页会复用这个头像。"
                                                   Margin="0,2,0,0"
                                                   Style="{StaticResource PersonalCenter.HintText}"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="更换头像"
                                                    Style="{StaticResource SettingsButton}"
                                                    Click="SelectAccountAvatar_Click"/>
                                            <Button Content="移除头像"
                                                    x:Name="BtnRemoveAccountAvatar"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Click="RemoveAccountAvatar_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="AccountIdentityCard"
                                    Style="{StaticResource PersonalCenter.SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="账号信息"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="账号"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <TextBox x:Name="TxtAccountName"
                                                     Style="{StaticResource WorkbenchTextInput}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="显示名称"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <TextBox x:Name="TxtDisplayName"
                                                     Style="{StaticResource WorkbenchTextInput}"
                                                     TextChanged="AccountIdentityChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="保存账号资料"
                                            HorizontalAlignment="Left"
                                            Margin="0,18,0,0"
                                            Style="{StaticResource ModalSaveButton}"
                                            Click="SaveAccount_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ProfilePanel"
                                    Visibility="Collapsed">
                            <Border x:Name="ProfileProfileCard"
                                    Style="{StaticResource PersonalCenter.SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="个人档案"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <Grid x:Name="ProfileBasicsGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="昵称"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtProfileDisplayName"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="身高（cm）"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtHeightCm"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="身材描述"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtBodyShape"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="肤色"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtSkinTone"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="发长"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtHairLength"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="发色"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <TextBox x:Name="TxtHairColor"
                                                             Style="{StaticResource WorkbenchTextInput}"
                                                             TextChanged="PromptInputChanged"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="五官特征"
                                                       Margin="0,14,0,6"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <TextBox x:Name="TxtFaceFeaturesSummary"
                                                     MinHeight="80"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Style="{StaticResource WorkbenchTextInput}"
                                                     TextChanged="PromptInputChanged"/>

                                            <TextBlock Text="喜欢的关键词"
                                                       Margin="0,14,0,6"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <TextBox x:Name="TxtStyleKeywords"
                                                     MinHeight="72"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Style="{StaticResource WorkbenchTextInput}"
                                                     TextChanged="PromptInputChanged"/>

                                            <TextBlock Text="避开的关键词"
                                                       Margin="0,14,0,6"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <TextBox x:Name="TxtAvoidKeywords"
                                                     MinHeight="72"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Style="{StaticResource WorkbenchTextInput}"
                                                     TextChanged="PromptInputChanged"/>
                                        </StackPanel>

                                        <StackPanel x:Name="ProfileAssistColumn"
                                                    Grid.Column="2">
                                            <Border x:Name="ProfileReferenceCard"
                                                    Style="{StaticResource PersonalCenter.SubtleCard}"
                                                    Padding="14"
                                                    Background="{DynamicResource SurfaceSectionBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="参考照片"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="未单独设置时会复用账号头像。"
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource PersonalCenter.HintText}"/>

                                                    <TextBlock Text="头像参考照"
                                                               Margin="0,14,0,6"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <Border x:Name="ProfileReferenceHero"
                                                            Margin="0,2,0,0"
                                                            Height="210"
                                                            CornerRadius="14"
                                                            Background="{DynamicResource SurfaceHeroBrush}">
                                                        <Image x:Name="AvatarPreview"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <UniformGrid x:Name="ProfileReferenceActions"
                                                                 Columns="2"
                                                                 Margin="0,10,0,0">
                                                        <Button Content="选择头像"
                                                                Style="{StaticResource PersonalCenter.ToolButton}"
                                                                Click="SelectAvatar_Click"/>
                                                        <Button Content="移除"
                                                                x:Name="BtnRemoveProfileAvatar"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource SettingsGhostButton}"
                                                                Click="RemoveAvatar_Click"/>
                                                    </UniformGrid>

                                                    <TextBlock Text="全身照"
                                                               Margin="0,16,0,6"
                                                               Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                                    <Border Height="210"
                                                            Margin="0,2,0,0"
                                                            CornerRadius="14"
                                                            Background="{DynamicResource SurfaceHeroBrush}">
                                                        <Image x:Name="FullBodyPreview"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <UniformGrid x:Name="ProfileFullBodyActions"
                                                                 Columns="2"
                                                                 Margin="0,10,0,0">
                                                        <Button Content="选择全身照"
                                                                Style="{StaticResource PersonalCenter.ToolButton}"
                                                                Click="SelectFullBody_Click"/>
                                                        <Button Content="移除"
                                                                x:Name="BtnRemoveFullBody"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource SettingsGhostButton}"
                                                                Click="RemoveFullBody_Click"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="PromptPreviewCard"
                                                    Style="{StaticResource PersonalCenter.SubtleCard}"
                                                    Margin="0,16,0,0"
                                                    Padding="14"
                                                    Background="{DynamicResource SurfaceSectionBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="默认效果图提示词"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBox x:Name="TxtPromptPreview"
                                                             Margin="0,12,0,0"
                                                             MinHeight="170"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"/>
                                                    <CheckBox x:Name="ChkConsent"
                                                              Margin="0,14,0,0"
                                                              Content="我同意把参考照片发送到云端图片生成服务"
                                                              Checked="PromptConsentChanged"
                                                              Unchecked="PromptConsentChanged"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="保存个人档案"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,16,0,0"
                                                    Style="{StaticResource ModalSaveButton}"
                                                    Click="SaveProfile_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SecurityPanel"
                                    Visibility="Collapsed">
                            <Border x:Name="SecurityOverviewCard"
                                    Style="{StaticResource PersonalCenter.SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="安全"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="PIN 留空会被清除。"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource PersonalCenter.HintText}"/>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="新密码"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <PasswordBox x:Name="NewPasswordBox"
                                                         Style="{StaticResource WorkbenchPasswordInput}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="新 PIN（可选）"
                                                       Style="{StaticResource PersonalCenter.FieldLabel}"/>
                                            <PasswordBox x:Name="NewPinBox"
                                                         Style="{StaticResource WorkbenchPasswordInput}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="更新密码/PIN"
                                            HorizontalAlignment="Left"
                                            Margin="0,18,0,0"
                                            Style="{StaticResource ModalSaveButton}"
                                            Click="SaveSecurity_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="28,14">
                    <Button Content="关闭"
                            HorizontalAlignment="Right"
                            MinWidth="96"
                            Style="{StaticResource ModalCancelButton}"
                            Click="Close_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
