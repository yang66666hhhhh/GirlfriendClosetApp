<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.WornDayDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootCard"
            Style="{StaticResource ModalCardRoot}"
            Width="560"
            MinHeight="360">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Style="{StaticResource ModalHeaderTitle}"/>
                            <TextBlock x:Name="SubtitleText" Style="{StaticResource ModalHeaderSubtitle}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceSectionBrush}"
                        CornerRadius="18"
                        Padding="16"
                        Margin="28,20,28,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="给这一天补一条穿搭记录"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="适合补记昨天、周末或者约会那天穿了什么。"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <ComboBox x:Name="OutfitPicker"
                                      Width="180"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,10,0"/>
                            <Button Content="添加"
                                    Style="{StaticResource ModalSaveButton}"
                                    MinWidth="86"
                                    Padding="14,9"
                                    Click="AddRecordButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="28,18,28,22">
                    <TextBlock x:Name="EmptyText"
                               Text="这一天还没有记录。选一套搭配点「添加」，日历就会被点亮。"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ScrollViewer MaxHeight="420">
                    <ItemsControl x:Name="RecordsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="18"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="16"
                                                Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="👗"
                                                       FontSize="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding OutfitName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="撤销"
                                                Tag="{Binding Id}"
                                                Style="{StaticResource ModalCancelButton}"
                                                MinWidth="64"
                                                Padding="10,7"
                                                VerticalAlignment="Center"
                                                Click="DeleteRecordButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource ModalFooterHost}" Padding="24,14">
                    <Button Content="关闭"
                            Style="{StaticResource ModalSaveButton}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
