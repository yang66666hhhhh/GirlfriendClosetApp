<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.WornDayDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outfit="clr-namespace:ClosetApp.UI.Components.Outfit.Controls"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="RecordPreviewButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="#D7E3F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTip" Value="查看预览"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WornDayRecordItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WornRecordMetaBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="RootCard"
                Style="{StaticResource ModalCardRoot}"
                Width="560"
                MinHeight="360">
            <Border Style="{StaticResource ModalCardClip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TitleText" Style="{StaticResource ModalHeaderTitle}"/>
                                <TextBlock x:Name="SubtitleText" Style="{StaticResource ModalHeaderSubtitle}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource ModalCloseButton}"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceSectionBrush}"
                            CornerRadius="18"
                            Padding="16"
                            Margin="28,20,28,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="给这一天补一条穿搭记录"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="适合补记昨天、周末或者约会那天穿了什么。"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <ComboBox x:Name="OutfitPicker"
                                          Width="180"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,10,0"/>
                                <Button Content="添加"
                                        Style="{StaticResource ModalSaveButton}"
                                        MinWidth="86"
                                        Padding="14,9"
                                        Click="AddRecordButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="28,18,28,22">
                        <TextBlock x:Name="EmptyText"
                                   Text="这一天还没有记录。选一套搭配点「添加」，日历就会被点亮。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <ListBox x:Name="RecordsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="468"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="RecordsList_SelectionChanged"
                                 ItemContainerStyle="{StaticResource WornDayRecordItemContainerStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemBorder"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="SelectedRail"
                                                    Width="4"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    Opacity="0"
                                                    Margin="0,2,0,2"/>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding OutfitName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <Border x:Name="SelectedBadge"
                                                            Grid.Column="1"
                                                            Background="{DynamicResource PrimaryLightBrush}"
                                                            BorderBrush="#60FFFFFF"
                                                            BorderThickness="1"
                                                            Width="8"
                                                            Height="8"
                                                            CornerRadius="4"
                                                            Margin="8,0,0,0"
                                                            Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,6,0,0"/>
                                                <Border Style="{StaticResource WornRecordMetaBadge}"
                                                        Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding PreviewMetaText}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <!-- 状态提示 -->
                                                <Border Background="{DynamicResource TagRoseSurfaceBrush}"
                                                        BorderBrush="{DynamicResource TagRoseBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,3"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TagRoseTextBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource TagAmberSurfaceBrush}"
                                                        BorderBrush="{DynamicResource TagAmberBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasMissingImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MissingImageText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagAmberTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Content="修复"
                                                                Style="{StaticResource ModalCancelButton}"
                                                                MinWidth="48"
                                                                Padding="8,3"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding CanRepairMissingImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Click="RepairMissingImageButton_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource RecordPreviewButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Click="PreviewButton_Click">
                                                <Button.Content>
                                                    <Viewbox Width="13"
                                                             Height="13">
                                                        <Canvas Width="16"
                                                                Height="16">
                                                            <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                  Data="M8,3 C4.5,3 1.9,5.2 0.8,8 C1.9,10.8 4.5,13 8,13 C11.5,13 14.1,10.8 15.2,8 C14.1,5.2 11.5,3 8,3 z M8,5.2 C9.55,5.2 10.8,6.45 10.8,8 C10.8,9.55 9.55,10.8 8,10.8 C6.45,10.8 5.2,9.55 5.2,8 C5.2,6.45 6.45,5.2 8,5.2 z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button.Content>
                                            </Button>

                                            <Button Grid.Column="5"
                                                    Content="撤销"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource ModalCancelButton}"
                                                    MinWidth="64"
                                                    Padding="10,7"
                                                    VerticalAlignment="Center"
                                                    Click="DeleteRecordButton_Click"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    <Setter TargetName="SelectedRail" Property="Opacity" Value="1"/>
                                            <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border x:Name="FooterHost" Grid.Row="3" Style="{StaticResource ModalFooterHost}" Padding="24,14">
                        <Button Content="关闭"
                                Style="{StaticResource ModalSaveButton}"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <Popup x:Name="RecordPreviewPopup"
               Placement="Left"
               AllowsTransparency="True"
               StaysOpen="False">
            <Grid Background="Transparent"
                  Margin="6">
                <Border Width="214"
                        CornerRadius="16"
                        Background="#01FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="6"
                                          Opacity="0.12"
                                          Color="#564A61"/>
                    </Border.Effect>
                </Border>
                <Border Background="#FFFFFFFF"
                        BorderBrush="#E9E2EC"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="PreviewPopupTitleText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PreviewPopupMetaText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                        <Border Height="210"
                                Margin="0,10,0,0"
                                Background="{DynamicResource SurfacePageBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid Margin="8">
                                <Border x:Name="PreviewPopupGlow"
                                        Width="78"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Margin="0,8,0,12"
                                        CornerRadius="40"
                                        Opacity="0.16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#24DCEAFF" Offset="0"/>
                                            <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="PreviewPopupShadow"
                                         Width="70"
                                         Height="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,12"
                                         Opacity="0.07"
                                         IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush RadiusX="0.78" RadiusY="0.9">
                                            <GradientStop Color="#26000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <outfit:OutfitPreviewCanvas x:Name="PreviewPopupCanvas"
                                                            Width="170"
                                                            Height="182"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                <TextBlock x:Name="PreviewPopupEmptyText"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           MaxWidth="152"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
