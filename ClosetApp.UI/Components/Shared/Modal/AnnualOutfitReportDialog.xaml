<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.AnnualOutfitReportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="ReportTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ReportValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ReportHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="HighlightChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHeroBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource ModalCardRoot}"
                Width="520"
                MinHeight="400"
                MaxHeight="720">
            <Border Style="{StaticResource ModalCardClip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TitleText" Style="{StaticResource ModalHeaderTitle}"/>
                                <TextBlock Style="{StaticResource ModalHeaderSubtitle}">
                                    <Run Text="回顾这一年的穿搭记录"/>
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource ModalCloseButton}"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="28,0,28,16">
                        <StackPanel>
                            <!-- 精彩瞬间 -->
                            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="精彩瞬间" Style="{StaticResource ReportTitle}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="HighlightsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HighlightChip}">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 总览 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource ReportCard}">
                                    <StackPanel>
                                        <TextBlock Text="总穿着" Style="{StaticResource ReportHint}"/>
                                        <TextBlock x:Name="TotalWearCountText" Style="{StaticResource ReportValue}"/>
                                        <TextBlock Text="次" Style="{StaticResource ReportHint}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource ReportCard}">
                                    <StackPanel>
                                        <TextBlock Text="活跃天数" Style="{StaticResource ReportHint}"/>
                                        <TextBlock x:Name="ActiveDaysText" Style="{StaticResource ReportValue}"/>
                                        <TextBlock Text="天" Style="{StaticResource ReportHint}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 最常穿搭配 -->
                            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="最常穿搭配" Style="{StaticResource ReportTitle}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="TopOutfitsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Rank}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="8,0"/>

                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource SurfaceHeroBrush}"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding SeasonText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>

                                                    <Border Grid.Column="3"
                                                            Background="{DynamicResource SurfaceHeroBrush}"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SceneText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding WearCountText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 月度统计 -->
                            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="月度统计" Style="{StaticResource ReportTitle}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="MonthlyStatsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding MonthName}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BorderLightBrush}"
                                                                Height="6"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Stretch"/>
                                                        <Border x:Name="MonthBar"
                                                                Background="{DynamicResource PrimaryBrush}"
                                                                Height="6"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Left"/>
                                                    </Grid>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SummaryText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 场景分布 -->
                            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="场景分布" Style="{StaticResource ReportTitle}" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="SceneDistributionPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 季节分布 -->
                            <Border Style="{StaticResource ReportCard}">
                                <StackPanel>
                                    <TextBlock Text="季节分布" Style="{StaticResource ReportTitle}" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="SeasonDistributionPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Style="{StaticResource ModalFooterHost}"
                            Padding="28,16">
                        <Button Content="关闭"
                                Style="{StaticResource CapsuleButton}"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
