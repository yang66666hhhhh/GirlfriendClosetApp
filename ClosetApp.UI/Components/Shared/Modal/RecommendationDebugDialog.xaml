<UserControl x:Class="ClosetApp.UI.Components.Shared.Modal.RecommendationDebugDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:ScoreToColorConverter x:Key="ScoreToColorConverter"/>
        <conv:ScoreToSignConverter x:Key="ScoreToSignConverter"/>

        <Style x:Key="DebugChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DebugChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource ModalCardRoot}"
                Width="520"
                MinHeight="400"
                MaxHeight="720">
            <Border Style="{StaticResource ModalCardClip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}" Padding="28,22">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="推荐详情" Style="{StaticResource ModalHeaderTitle}"/>
                                <TextBlock x:Name="SubtitleText" Style="{StaticResource ModalHeaderSubtitle}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource ModalCloseButton}"
                                    Click="CloseButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="28,0,28,16">
                        <StackPanel>
                            <!-- 总分 -->
                            <Border Background="{DynamicResource SurfaceHeroBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20,16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="总分"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="TotalScoreText"
                                                       FontSize="36"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" 分"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="2,0,0,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="ScoreRankText"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="排名"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 评分明细 -->
                            <TextBlock Text="评分明细"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ItemsControl x:Name="BreakdownList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Detail}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Score, Converter={StaticResource ScoreToSignConverter}}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Score, Converter={StaticResource ScoreToColorConverter}}"/>
                                                    <TextBlock Text="{Binding Score, StringFormat={}{0}}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Score, Converter={StaticResource ScoreToColorConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 推荐理由 -->
                            <TextBlock Text="推荐理由"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,10"/>

                            <ItemsControl x:Name="ReasonsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="•"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="ComparisonSection"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="ComparisonTitleText"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <ItemsControl x:Name="ComparisonList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceHeroBrush}"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="→"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,0,8,0"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="CautionsSection"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="需要留意"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <ItemsControl x:Name="CautionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AmberSubtleBrush}"
                                                    BorderBrush="{DynamicResource AmberBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="!"
                                                               Foreground="{DynamicResource AmberBrush}"
                                                               Margin="0,0,8,0"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 偏好权重 -->
                            <TextBlock Text="当前偏好权重"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,10"/>

                            <Border Background="{DynamicResource SurfaceSectionBrush}"
                                    CornerRadius="14"
                                    Padding="16,14">
                                <StackPanel>
                                    <StackPanel x:Name="SceneWeightsPanel" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="TagWeightsPanel" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="ColorWeightsPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Style="{StaticResource ModalFooterHost}"
                            Padding="28,16">
                        <Button Content="关闭"
                                Style="{StaticResource CapsuleButton}"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
