<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FormCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}"/>
    </Style>

    <Style x:Key="FormCardSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FormSectionTitle}">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="FormHintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>

</ResourceDictionary>
