<UserControl x:Class="ClosetApp.UI.Components.Shared.States.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
        <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center">
            <TextBlock x:Name="IconText" Text="✨" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
        </Border>
        <TextBlock x:Name="TitleText"
                   Text="暂无内容"
                   Style="{StaticResource EmptyStateTitleText}"
                   Margin="0,18,0,0"/>
        <TextBlock x:Name="BodyText"
                   Text="先创建一项内容吧"
                   Style="{StaticResource EmptyStateBodyText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>
        <WrapPanel HorizontalAlignment="Center">
            <Button x:Name="SecondaryActionButton"
                    Content="稍后再说"
                    Style="{StaticResource CapsuleButton}"
                    Margin="0,0,10,0"
                    Visibility="{Binding SecondaryActionVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding IsSecondaryActionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Click="SecondaryActionButton_Click"/>
            <Button x:Name="ActionButton"
                    Content="开始创建"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ActionVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding IsActionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Click="ActionButton_Click"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
