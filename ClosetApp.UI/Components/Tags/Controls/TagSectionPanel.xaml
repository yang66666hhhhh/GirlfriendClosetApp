<UserControl x:Class="ClosetApp.UI.Components.Tags.Controls.TagSectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PageSummaryCard}"
            Padding="16,14"
            Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SectionVisibility}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SectionTitle}"
                               Style="{StaticResource PageSummaryTitleText}"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SectionDescription}"
                               Style="{StaticResource PageSummaryBodyText}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource PageSummaryBadge}"
                        Background="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BadgeBackground}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BadgeBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Padding="12,10">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=CountText}"
                               Style="{StaticResource PageSummaryValueText}"/>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemsSource}"
                          ItemTemplate="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
