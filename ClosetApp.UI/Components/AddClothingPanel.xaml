<UserControl x:Class="ClosetApp.UI.Components.AddClothingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#FFF6F3EE"/>
        <SolidColorBrush x:Key="ModalBg" Color="#FFFDFAF7"/>
        <SolidColorBrush x:Key="SectionBg" Color="#FFF8F5F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFD9A299"/>
        <SolidColorBrush x:Key="AccentDark" Color="#FFC48B81"/>
        <SolidColorBrush x:Key="AccentLight" Color="#FFF2E6E3"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF2D2A26"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9E958D"/>
        <SolidColorBrush x:Key="TextPlaceholder" Color="#FFC8C0B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#FFE8E2DC"/>
        <SolidColorBrush x:Key="DividerColor" Color="#FFEEE8E2"/>
        <SolidColorBrush x:Key="ImageBg" Color="#FFF5F0EB"/>
        <SolidColorBrush x:Key="TagBg" Color="#FFF5EDEA"/>
        <SolidColorBrush x:Key="TagBgSelected" Color="#FFD9A299"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SectionBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="Ph"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource TextPlaceholder}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="false"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Segment"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="15" Margin="0,0,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="SegBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTag" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource TagBg}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PillBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="11,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBg" Property="Background" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBg" Property="Background" Value="{StaticResource TagBgSelected}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LevelBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Fav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="LvlBg"
                                Background="Transparent"
                                CornerRadius="16"
                                Width="48" Height="48">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LvlBg" Property="Background" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LvlBg" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- MODAL CARD -->
    <Border x:Name="Card"
            MaxWidth="1020" MaxHeight="640"
            Width="1020" Height="640"
            Background="{StaticResource ModalBg}"
            CornerRadius="24"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Card_MouseDown">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="8" Opacity="0.1" Color="#40000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="84"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="40,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="添加新衣服"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="记录今天喜欢的穿搭 ✨"
                               FontSize="15" Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="BtnClose" Content="✕"
                        Width="36" Height="36"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontSize="16" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondary}"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBg" Property="Background" Value="{StaticResource AccentLight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Rectangle Grid.Row="0" VerticalAlignment="Bottom"
                       Fill="{StaticResource DividerColor}" Height="1" Margin="40,0"/>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*"/>
                    <ColumnDefinition Width="42*"/>
                </Grid.ColumnDefinitions>

                <!-- IMAGE AREA -->
                <Border x:Name="ImageArea"
                        Grid.Column="0"
                        Background="{StaticResource ImageBg}"
                        CornerRadius="0"
                        ClipToBounds="True">
                    <Grid>
                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    AllowDrop="True"
                                    DragEnter="ImageArea_DragEnter"
                                    DragLeave="ImageArea_DragLeave"
                                    Drop="ImageArea_Drop"
                                    MouseLeftButtonDown="Upload_Click">
                            <Ellipse Width="96" Height="96"
                                     Fill="{StaticResource AccentLight}" Margin="0,0,0,24">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.2" Color="#D9A299"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="拖拽图片到这里"
                                       FontSize="18" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="或者上传今天喜欢的衣服"
                                       FontSize="14" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,28"/>
                            <Border Background="{StaticResource AccentColor}" CornerRadius="14"
                                    Padding="28,12">
                                <TextBlock Text="选择图片" Foreground="White"
                                           FontSize="14" FontWeight="Medium"/>
                            </Border>
                            <TextBlock Text="支持 JPG / PNG / WebP"
                                       FontSize="12" Foreground="{StaticResource TextPlaceholder}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>

                        <Border x:Name="PreviewState"
                                Visibility="Collapsed"
                                CornerRadius="0" ClipToBounds="True"
                                AllowDrop="True"
                                DragEnter="ImageArea_DragEnter"
                                DragLeave="ImageArea_DragLeave"
                                Drop="ImageArea_Drop">
                            <Grid>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <Button x:Name="BtnDeleteImage"
                                        Content="✕"
                                        Width="32" Height="32"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="16" FontSize="13" Cursor="Hand"
                                        Background="White" Foreground="#999"
                                        Click="DeleteImage_Click"
                                        Opacity="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border VerticalAlignment="Bottom"
                                        Background="#99000000"
                                        Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtImageInfo"
                                                   Text="图片已上传"
                                                   FontSize="13" Foreground="White" Opacity="0.85"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="#33FFFFFF" CornerRadius="8"
                                                Padding="14,6">
                                            <TextBlock Text="更换图片"
                                                       FontSize="13" Foreground="White"
                                                       MouseLeftButtonDown="Upload_Click"
                                                       Cursor="Hand"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="0" HorizontalAlignment="Right"
                           Fill="{StaticResource DividerColor}" Width="1"/>

                <!-- FORM AREA -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <StackPanel x:Name="FormPanel" Margin="36,32">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="8"/>
                        </StackPanel.RenderTransform>

                        <TextBlock Text="衣服信息"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtName" Tag="给它起个名字"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,20"/>

                        <TextBlock Text="分类" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,20">
                            <RadioButton Content="上衣" Tag="👕" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Category_Checked"/>
                            <RadioButton Content="下装" Tag="👖" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Category_Checked"/>
                            <RadioButton Content="外套" Tag="🧥" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Category_Checked"/>
                            <RadioButton Content="裙子" Tag="👗" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Category_Checked"/>
                            <RadioButton Content="鞋子" Tag="👟" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Category_Checked"/>
                            <RadioButton Content="配饰" Tag="👜" Style="{StaticResource SegmentBtn}"
                                         Checked="Category_Checked"/>
                        </WrapPanel>

                        <TextBlock Text="季节" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="SeasonPanel" Margin="0,0,0,24">
                            <RadioButton Content="春" Tag="🌸" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Season_Checked"/>
                            <RadioButton Content="夏" Tag="☀️" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Season_Checked"/>
                            <RadioButton Content="秋" Tag="🍂" Style="{StaticResource SegmentBtn}"
                                         Margin="0,0,8,0" Checked="Season_Checked"/>
                            <RadioButton Content="冬" Tag="❄️" Style="{StaticResource SegmentBtn}"
                                         Checked="Season_Checked"/>
                        </WrapPanel>

                        <Rectangle Fill="{StaticResource DividerColor}" Height="1" Margin="0,0,0,24"/>

                        <TextBlock Text="风格与颜色"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="颜色" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtColor" Tag="如：奶白、雾蓝、燕麦"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="品牌" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtBrand" Tag="可选"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,20"/>

                        <TextBlock Text="情绪标签" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="EmotionPanel" Margin="0,0,0,24">
                            <ToggleButton Content="温柔风" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="通勤风" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="法式" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="休闲" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="运动" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="约会" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="度假" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                            <ToggleButton Content="甜美" Style="{StaticResource PillTag}"
                                          Margin="0,0,8,8" Click="EmotionTag_Click"/>
                        </WrapPanel>

                        <Rectangle Fill="{StaticResource DividerColor}" Height="1" Margin="0,0,0,24"/>

                        <TextBlock Text="喜欢程度"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,16"/>

                        <StackPanel x:Name="FavoritePanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                            <RadioButton Tag="1" Style="{StaticResource LevelBtn}"
                                         Content="😐" Margin="0,0,12,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="2" Style="{StaticResource LevelBtn}"
                                         Content="🙂" Margin="0,0,12,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="3" Style="{StaticResource LevelBtn}"
                                         Content="😊" Margin="0,0,12,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="4" Style="{StaticResource LevelBtn}"
                                         Content="😍" Margin="0,0,12,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="5" Style="{StaticResource LevelBtn}"
                                         Content="🤩" Checked="FavLevel_Checked"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFavHint" Text="选一个表情吧"
                                   FontSize="12" Foreground="{StaticResource TextPlaceholder}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER -->
            <Rectangle Grid.Row="2" VerticalAlignment="Top"
                       Fill="{StaticResource DividerColor}" Height="1"/>

            <Border Grid.Row="2" Background="{StaticResource SectionBg}">
                <Grid Margin="40,0">
                    <TextBlock Text="填写名称即可保存"
                               FontSize="13" Foreground="{StaticResource TextPlaceholder}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnCancel" Content="取消"
                                Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                FontSize="14" Cursor="Hand" Padding="20,10" Click="Close_Click"
                                Margin="0,0,12,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBg" Background="Transparent" CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBg" Property="Background" Value="{StaticResource AccentLight}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnSave" Content="保存衣服  ♥"
                                Background="{StaticResource AccentColor}" Foreground="White"
                                FontSize="14" FontWeight="Medium" Cursor="Hand"
                                MinWidth="160" Padding="28,12" Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SaveBg"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.15" Color="#D9A299"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SaveBg" Property="Background" Value="{StaticResource AccentDark}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
