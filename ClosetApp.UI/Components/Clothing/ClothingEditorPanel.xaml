<UserControl x:Class="ClosetApp.UI.Components.Clothing.ClothingEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:tags="clr-namespace:ClosetApp.UI.Components.Tags.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InputFocusBrush" Color="{DynamicResource Primary}"/>
        <SolidColorBrush x:Key="InputUnderlineBrush" Color="{DynamicResource Border.Light}"/>

    </UserControl.Resources>

    <!-- MODAL -->
    <Border x:Name="Card"
            MinWidth="860" MaxWidth="1080"
            MinHeight="680" MaxHeight="900"
            Width="1040" Height="760"
            Style="{StaticResource ModalCardRoot}"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Card_MouseDown">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="8" Opacity="0.10" Color="#40000000"/>
        </Border.Effect>

        <Border x:Name="CardClip"
                Style="{StaticResource ModalCardClip}"
                SizeChanged="CardClip_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                <Grid Margin="36,0,36,0">
                    <StackPanel x:Name="HeaderAdd" VerticalAlignment="Center">
                        <TextBlock Text="添加一件心动单品"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="照片、分类和小标签，以后都会成为搭配灵感 ✨"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="12" FontWeight="Regular"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="HeaderEdit" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="编辑衣服"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="更新它的照片、标签和喜欢程度"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="12" FontWeight="Regular"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            x:Name="BtnHeaderCancel"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- ═══ BODY ═══ -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>

                <!-- ── HERO AREA ── -->
                <Grid Grid.Column="0" Margin="28,0,0,0">
                    <!-- 空状态 -->
                    <Border x:Name="EmptyState"
                            Background="{DynamicResource SurfaceHeroBrush}"
                            CornerRadius="22"
                            AllowDrop="True"
                            DragEnter="ImageArea_DragEnter"
                            DragLeave="ImageArea_DragLeave"
                            Drop="ImageArea_Drop"
                            MouseEnter="EmptyState_HoverEnter"
                            MouseLeave="EmptyState_HoverLeave"
                            MouseLeftButtonDown="Upload_Click"
                            Cursor="Hand"
                            Margin="8,0,8,0">
                        <Grid>
                            <!-- 径向柔和光晕 -->
                            <Ellipse Width="400" Height="400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.4">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#40D9A299" Offset="0"/>
                                        <GradientStop Color="#00D9A299" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 中心 Icon -->
                                <Border Width="72" Height="72"
                                        CornerRadius="36"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <TextBlock Text="👕" FontSize="32"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="添加衣服照片"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="17" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="拖拽图片到这里，或点击选择文件"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12" FontWeight="Regular"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 上传后预览 -->
                    <Border x:Name="PreviewState"
                            Visibility="Collapsed"
                            Background="Transparent"
                            CornerRadius="22"
                            ClipToBounds="True"
                            AllowDrop="True"
                            DragEnter="ImageArea_DragEnter"
                            DragLeave="ImageArea_DragLeave"
                            Drop="ImageArea_Drop"
                            MouseLeftButtonDown="Upload_Click"
                            Cursor="Hand"
                            Margin="8,0,8,0">
                        <Grid>
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- 底部操作栏 -->
                            <Border VerticalAlignment="Bottom"
                                    Background="#66000000"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="移除"
                                            Style="{StaticResource GhostButton}"
                                            Click="DeleteImage_Click"
                                            Margin="0,0,8,0"/>
                                    <Button Content="更换"
                                            Style="{StaticResource GhostButton}"
                                            Click="Upload_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── FORM AREA ── -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FormPanel" Margin="32,24,36,36">

                        <!-- 基础信息 -->
                        <TextBlock Text="基础信息"
                                   Style="{StaticResource FormSectionTitle}"/>

                        <TextBlock Text="名称"
                                   Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="TxtName" Tag="给这件衣服起个名字"
                                 Style="{StaticResource SoftInput}" Margin="0,0,0,18"/>

                        <!-- 分类 -->
                        <TextBlock Text="分类"
                                   Style="{StaticResource FormFieldLabel}" Margin="0,0,0,10"/>
                         <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,20">
                            <RadioButton Content="❓ 未选择"  Tag="Unspecified" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" IsChecked="True" Checked="Category_Checked"/>
                            <RadioButton Content="👕 上衣"    Tag="Top"       Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👖 裤装"    Tag="Bottom"    Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="🧥 外套"    Tag="Outerwear" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👗 连衣裙"  Tag="Dress"     Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="🩰 半裙"    Tag="Skirt"     Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👟 鞋子"    Tag="Shoes"     Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👜 配饰"    Tag="Accessory" Style="{StaticResource CategoryChip}" Margin="0,0,0,8" Checked="Category_Checked"/>
                        </WrapPanel>

                        <!-- 季节 -->
                        <TextBlock Text="季节"
                                   Style="{StaticResource FormFieldLabel}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="SeasonPanel" Margin="0,0,0,28">
                            <RadioButton Content="🍃 春"  Tag="Spring"  Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="☀️ 夏"  Tag="Summer"  Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="🍂 秋"  Tag="Autumn"  Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="❄️ 冬"  Tag="Winter"  Style="{StaticResource SeasonChip}" Margin="0,0,0,8" Checked="Season_Checked"/>
                        </WrapPanel>

                        <!-- 风格与颜色 -->
                        <TextBlock Text="风格与颜色"
                                   Style="{StaticResource FormSectionTitle}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="颜色"
                                           Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="TxtColor" Tag="如：奶白、雾蓝"
                                         Style="{StaticResource SoftInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="品牌"
                                           Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="TxtBrand" Tag="可选"
                                         Style="{StaticResource SoftInput}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="备注"
                                   Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="TxtNotes" Tag="可选，写下它适合的场合或搭配灵感..."
                                 Style="{StaticResource SoftMultilineInput}" Margin="0,0,0,20"/>

                         <!-- 风格标签 -->
                         <tags:TagSelectionSection x:Name="TagSelection" Margin="0,0,0,28"/>

                        <!-- 喜欢程度 -->
                        <TextBlock Text="喜欢程度"
                                   Style="{StaticResource FormSectionTitle}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="FavoritePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <RadioButton Tag="1" Style="{StaticResource LevelBtn}" Content="😐" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="2" Style="{StaticResource LevelBtn}" Content="🙂" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="3" Style="{StaticResource LevelBtn}" Content="😊" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="4" Style="{StaticResource LevelBtn}" Content="😍" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                            <RadioButton Tag="5" Style="{StaticResource LevelBtn}" Content="🤩" Checked="FavLevel_Checked"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFavHint" Text="选一个表情吧"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="11" FontWeight="Regular"
                                   Foreground="{DynamicResource TextPlaceholderBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ STICKY FOOTER ═══ -->
            <Border Grid.Row="2"
                    Style="{StaticResource ModalFooterHost}"
                    Padding="24,14">
                <Grid>
                    <Button x:Name="BtnDelete"
                            Content="删除这件衣服"
                            Style="{StaticResource ModalDangerButton}"
                            VerticalAlignment="Center"
                            Click="Delete_Click"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                    <Grid MaxWidth="400" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="BtnFooterCancel"
                                Content="取消"
                                Style="{StaticResource ModalCancelButton}"
                                Click="Cancel_Click"/>
                        <Button Grid.Column="2"
                                x:Name="BtnSave"
                                Content="保存衣服 ♥"
                                Style="{StaticResource ModalSaveButton}"
                                Click="Save_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Border>
</UserControl>
