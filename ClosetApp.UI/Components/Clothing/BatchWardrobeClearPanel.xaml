<UserControl x:Class="ClosetApp.UI.Components.Clothing.BatchWardrobeClearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CategoryToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder"
                                Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,12"
                                Margin="0,0,10,10">
                            <Grid MinWidth="148">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CountText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="CheckMark"
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckMarkText"
                                               Text="✓"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="Transparent"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="CheckMark" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMarkText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border MinWidth="720"
            MaxWidth="860"
            Width="780"
            Height="680"
            Style="{StaticResource ModalCardRoot}">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="78"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="36,0,36,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="批量清空衣柜"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="可以一次清空整个衣柜，也可以只清空选中的分类。"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnClose"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,24,36,28">
                        <Border Background="{DynamicResource SurfaceHeroBrush}"
                                CornerRadius="18"
                                Padding="18,16"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="TxtSummary"
                                           Text="会删除选中分类里的衣服，只清理未被穿着历史引用的图片。"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="如果某套搭配删完后已经没有衣服了，也会自动一起清理。"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkSelectAll"
                                  Content="清空整个衣柜"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="SelectAll_Checked"
                                  Unchecked="SelectAll_Checked"/>
                        <TextBlock x:Name="TxtSelectAllHint"
                                   Text="已选择全部分类。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,14"/>

                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource CategoryToggleStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource SurfaceSectionBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="最后确认"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <CheckBox x:Name="ChkUnderstand"
                                          Content="我知道这个操作不可撤销，会清理未被穿着历史引用的图片和可能变空的搭配"
                                          Margin="0,10,0,0"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Checked="Acknowledge_Checked"
                                          Unchecked="Acknowledge_Checked"/>
                                <TextBlock x:Name="TxtValidation"
                                           Visibility="Collapsed"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="24,14">
                    <Grid>
                        <TextBlock x:Name="TxtFooterHint"
                                   Text="先选要清空的分类，再做最后确认。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Grid MaxWidth="430" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCancel"
                                    Grid.Column="0"
                                    Content="取消"
                                    Style="{StaticResource ModalCancelButton}"
                                    Click="Cancel_Click"/>
                            <Button x:Name="BtnSave"
                                    Grid.Column="2"
                                    Content="清空选中分类"
                                    Style="{StaticResource ModalDangerButton}"
                                    Click="Save_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
