<UserControl x:Class="ClosetApp.UI.Components.Clothing.BatchClothingCompletionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tags="clr-namespace:ClosetApp.UI.Components.Tags.Controls">
    <Border x:Name="Card"
            MinWidth="760"
            MaxWidth="920"
            Width="840"
            Height="720"
            Style="{StaticResource ModalCardRoot}">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="36,0,36,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="批量补全当前结果"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="只补缺失的信息，不会覆盖已经填好的资料。"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnClose"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,24,36,28">
                        <Border Background="{DynamicResource SurfaceHeroBrush}"
                                CornerRadius="18"
                                Padding="18,16"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="TxtSummary"
                                           Text="会对当前结果里的衣服补全缺失资料。"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="例如：未分类才会补分类，没品牌才会写品牌；标签只会新增，不会删掉已有标签。"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkType"
                                  Content="补分类"
                                  Margin="0,0,0,8"
                                  Checked="ApplyOption_Changed"
                                  Unchecked="ApplyOption_Changed"/>
                        <WrapPanel x:Name="CategoryPanel"
                                   Margin="0,0,0,20"
                                   IsEnabled="False"
                                   Opacity="0.45">
                            <RadioButton Content="👕 上衣" Tag="Top" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👖 裤装" Tag="Bottom" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="🧥 外套" Tag="Outerwear" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👗 连衣裙" Tag="Dress" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="🩰 半裙" Tag="Skirt" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👟 鞋子" Tag="Shoes" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                            <RadioButton Content="👜 配饰" Tag="Accessory" Style="{StaticResource CategoryChip}" Margin="0,0,0,8" Checked="Category_Checked"/>
                        </WrapPanel>

                        <CheckBox x:Name="ChkSeason"
                                  Content="补季节"
                                  Margin="0,0,0,8"
                                  Checked="ApplyOption_Changed"
                                  Unchecked="ApplyOption_Changed"/>
                        <WrapPanel x:Name="SeasonPanel"
                                   Margin="0,0,0,20"
                                   IsEnabled="False"
                                   Opacity="0.45">
                            <RadioButton Content="🍃 春" Tag="Spring" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="☀️ 夏" Tag="Summer" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="🍂 秋" Tag="Autumn" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                            <RadioButton Content="❄️ 冬" Tag="Winter" Style="{StaticResource SeasonChip}" Margin="0,0,0,8" Checked="Season_Checked"/>
                        </WrapPanel>

                        <CheckBox x:Name="ChkBrand"
                                  Content="补品牌"
                                  Margin="0,0,0,8"
                                  Checked="ApplyOption_Changed"
                                  Unchecked="ApplyOption_Changed"/>
                        <TextBox x:Name="TxtBrand"
                                 Tag="如：Uniqlo"
                                 Style="{StaticResource SoftInput}"
                                 Margin="0,0,0,20"
                                 IsEnabled="False"
                                 Opacity="0.45"/>

                        <CheckBox x:Name="ChkColor"
                                  Content="补颜色"
                                  Margin="0,0,0,8"
                                  Checked="ApplyOption_Changed"
                                  Unchecked="ApplyOption_Changed"/>
                        <TextBox x:Name="TxtColor"
                                 Tag="如：奶白、深灰"
                                 Style="{StaticResource SoftInput}"
                                 Margin="0,0,0,20"
                                 IsEnabled="False"
                                 Opacity="0.45"/>

                        <CheckBox x:Name="ChkTags"
                                  Content="补标签"
                                  Margin="0,0,0,8"
                                  Checked="ApplyOption_Changed"
                                  Unchecked="ApplyOption_Changed"/>
                        <Border x:Name="TagSectionHost"
                                Opacity="0.45"
                                IsEnabled="False">
                            <tags:TagSelectionSection x:Name="TagSelection"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="24,14">
                    <Grid>
                        <TextBlock x:Name="TxtFooterHint"
                                   Text="选好要补的字段后，会只更新当前结果里的缺失资料。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Grid MaxWidth="420" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCancel"
                                    Grid.Column="0"
                                    Content="取消"
                                    Style="{StaticResource ModalCancelButton}"
                                    Click="Cancel_Click"/>
                            <Button x:Name="BtnSave"
                                    Grid.Column="2"
                                    Content="补全这一批"
                                    Style="{StaticResource ModalSaveButton}"
                                    Click="Save_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
