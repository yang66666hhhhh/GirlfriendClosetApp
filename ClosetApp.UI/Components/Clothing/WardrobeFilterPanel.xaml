<UserControl x:Class="ClosetApp.UI.Components.Clothing.WardrobeFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClosetApp.UI;component/Components/Clothing/WardrobeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource PageFilterCard}"
            Margin="44,0,44,10"
            Padding="16,14"
            Visibility="{Binding IsFilterExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="筛选"
                               Style="{StaticResource PageSummaryTitleText}"
                               FontSize="14"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding FilterResultText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Top"/>
            </Grid>

            <StackPanel>
                <TextBlock Text="分类"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel>
                        <RadioButton Content="✨ 全部"
                                     Style="{StaticResource ChipStyle}"
                                     IsChecked="{Binding IsCategoryAllSelected, Mode=TwoWay}"/>
                        <RadioButton Content="👕 上衣"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryTopSelected, Mode=TwoWay}"/>
                        <RadioButton Content="🧥 外套"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryOuterwearSelected, Mode=TwoWay}"/>
                        <RadioButton Content="👖 裤装"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryBottomSelected, Mode=TwoWay}"/>
                        <RadioButton Content="🩰 半裙"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategorySkirtSelected, Mode=TwoWay}"/>
                        <RadioButton Content="👗 连衣裙"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryDressSelected, Mode=TwoWay}"/>
                        <RadioButton Content="👟 鞋子"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryShoesSelected, Mode=TwoWay}"/>
                        <RadioButton Content="👜 配饰"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryAccessorySelected, Mode=TwoWay}"/>
                        <RadioButton Content="待分类"
                                     Style="{StaticResource ChipStyle}"
                                     Margin="8,0,0,0"
                                     IsChecked="{Binding IsCategoryUnspecifiedSelected, Mode=TwoWay}"/>
                    </WrapPanel>
                </ScrollViewer>

                <TextBlock Text="季节"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,6"/>
                <WrapPanel>
                    <RadioButton Content="四季都看"
                                 Style="{StaticResource ChipStyle}"
                                 GroupName="SeasonGroup"
                                 IsChecked="{Binding IsSeasonAllSelected, Mode=TwoWay}"/>
                    <RadioButton Content="春天"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,0"
                                 GroupName="SeasonGroup"
                                 IsChecked="{Binding IsSeasonSpringSelected, Mode=TwoWay}"/>
                    <RadioButton Content="夏天"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,0"
                                 GroupName="SeasonGroup"
                                 IsChecked="{Binding IsSeasonSummerSelected, Mode=TwoWay}"/>
                    <RadioButton Content="秋天"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,0"
                                 GroupName="SeasonGroup"
                                 IsChecked="{Binding IsSeasonAutumnSelected, Mode=TwoWay}"/>
                    <RadioButton Content="冬天"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,0"
                                 GroupName="SeasonGroup"
                                 IsChecked="{Binding IsSeasonWinterSelected, Mode=TwoWay}"/>
                </WrapPanel>

                <TextBlock Text="偏好"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,6"/>
                <CheckBox Content="只看收藏"
                          Style="{StaticResource FilterCheckStyle}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding FavoriteOnly, Mode=TwoWay}"/>

                <TextBlock Text="风格标签"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,6"/>
                <TextBlock Text="还没有风格标签，先去标签页加几个会更好筛。"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasAvailableTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding TagFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource TagToggleStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
