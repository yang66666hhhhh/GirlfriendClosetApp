<UserControl x:Class="ClosetApp.UI.Components.Clothing.BatchClothingImportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:tags="clr-namespace:ClosetApp.UI.Components.Tags.Controls">
    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
    </UserControl.Resources>

    <Border x:Name="Card"
            MinWidth="860"
            MaxWidth="1080"
            Width="980"
            Height="720"
            Style="{StaticResource ModalCardRoot}"
            MouseLeftButtonDown="Card_MouseDown">
        <Border Style="{StaticResource ModalCardClip}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModalHeaderHost}">
                    <Grid Margin="36,0,36,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="批量导入衣服"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="先预览文件清单，再一次性导入；失败时会自动撤回已保存图片"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                x:Name="BtnCancel"
                                Content="✕"
                                Style="{StaticResource ModalCloseButton}"
                                Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,22,32,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceHeroBrush}"
                            CornerRadius="22"
                            Padding="22"
                            AllowDrop="True"
                            DragEnter="Files_DragEnter"
                            DragLeave="Files_DragLeave"
                            Drop="Files_Drop">
                        <Grid>
                            <StackPanel x:Name="ImageEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="PickImages_Click"
                                        Cursor="Hand">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="36"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,18">
                                    <TextBlock Text="🖼"
                                               FontSize="30"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="选择一组图片"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="点击选择或拖拽图片到这里"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ImageListState" Visibility="Collapsed">
                                <TextBlock x:Name="TxtSelectedCount"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <Border x:Name="DuplicateWarningState"
                                        Visibility="Collapsed"
                                        Background="#FFFCE8E6"
                                        CornerRadius="14"
                                        Padding="12,10"
                                        Margin="0,10,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtDuplicateWarning"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <Button x:Name="BtnRemoveDuplicateItems"
                                                Content="一键移除可疑重复项"
                                                Style="{StaticResource CapsuleButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed"
                                                Click="RemoveDuplicateItems_Click"/>
                                        </StackPanel>
                                </Border>
                                <Border x:Name="ConfirmDuplicateState"
                                        Visibility="Collapsed"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14,12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="检测到可疑重复"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ConfirmDuplicateDetail"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,12,0,0">
                                            <Button Content="先回去处理"
                                                    Style="{StaticResource ModalCancelButton}"
                                                    Margin="0,0,10,0"
                                                    Click="ConfirmDuplicateBack_Click"/>
                                            <Button Content="仍然继续导入"
                                                    Style="{StaticResource ModalDangerButton}"
                                                    Click="ConfirmDuplicateContinue_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="下面是导入预览；名称默认是未命名，文件名只用来帮你辨认图片。"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,14"/>
                                <ListBox x:Name="SelectedFilesList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MaxHeight="390">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceCardBrush}"
                                                    CornerRadius="14"
                                                    Padding="12,9"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.RowSpan="2"
                                                            Width="58"
                                                            Height="58"
                                                            CornerRadius="12"
                                                            Background="{StaticResource SurfaceHeroBrush}"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="预览"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <Image Source="{Binding FilePath, Converter={StaticResource ImagePathConverter}, ConverterParameter=Thumbnail:120}"
                                                                   Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Tag="名称"
                                                             Style="{StaticResource SoftInput}"
                                                             MinHeight="36"
                                                             Padding="12,7"
                                                             Margin="0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Grid.Row="1"
                                                               Text="{Binding FileName}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Grid.Row="1"
                                                               Text="{Binding DuplicateReason}"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Visibility="{Binding IsDuplicateRisk, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Margin="8,3,0,0"/>
                                                    <Button Grid.Column="4"
                                                            Grid.RowSpan="2"
                                                            Content="✕"
                                                            Style="{StaticResource IconButton}"
                                                            Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Click="RemovePreviewItem_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="BtnPickImages"
                                        Content="重新选择图片"
                                        Style="{StaticResource CapsuleButton}"
                                        HorizontalAlignment="Left"
                                        Click="PickImages_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,0,16">
                            <TextBlock Text="可选批量信息"
                                       Style="{StaticResource FormSectionTitle}"/>
                            <TextBlock Text="只填写这批衣服已经确定的信息；没填的字段会保持待整理。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="分类（可选）"
                                       Style="{StaticResource FormFieldLabel}"
                                       Margin="0,0,0,10"/>
                            <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,20">
                                <RadioButton Content="👕 上衣" Tag="Top" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="👖 裤装" Tag="Bottom" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="🧥 外套" Tag="Outerwear" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="👗 连衣裙" Tag="Dress" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="🩰 半裙" Tag="Skirt" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="👟 鞋子" Tag="Shoes" Style="{StaticResource CategoryChip}" Margin="0,0,8,8" Checked="Category_Checked"/>
                                <RadioButton Content="👜 配饰" Tag="Accessory" Style="{StaticResource CategoryChip}" Margin="0,0,0,8" Checked="Category_Checked"/>
                            </WrapPanel>

                            <TextBlock Text="季节（可选）"
                                       Style="{StaticResource FormFieldLabel}"
                                       Margin="0,0,0,10"/>
                            <WrapPanel x:Name="SeasonPanel" Margin="0,0,0,22">
                                <RadioButton Content="🍃 春" Tag="Spring" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                                <RadioButton Content="☀️ 夏" Tag="Summer" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                                <RadioButton Content="🍂 秋" Tag="Autumn" Style="{StaticResource SeasonChip}" Margin="0,0,8,8" Checked="Season_Checked"/>
                                <RadioButton Content="❄️ 冬" Tag="Winter" Style="{StaticResource SeasonChip}" Margin="0,0,0,8" Checked="Season_Checked"/>
                            </WrapPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="颜色"
                                               Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox x:Name="TxtColor"
                                             Tag="可选"
                                             Style="{StaticResource SoftInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="品牌"
                                               Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox x:Name="TxtBrand"
                                             Tag="可选"
                                             Style="{StaticResource SoftInput}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="备注"
                                       Style="{StaticResource FormFieldLabel}"/>
                            <TextBox x:Name="TxtNotes"
                                     Tag="可选，比如：这批都是冬季外套"
                                     Style="{StaticResource SoftMultilineInput}"
                                     Margin="0,0,0,20"/>

                            <tags:TagSelectionSection x:Name="TagSelection" Margin="0,0,0,24"/>

                            <TextBlock Text="喜欢程度"
                                       Style="{StaticResource FormSectionTitle}"
                                       Margin="0,0,0,12"/>
                            <StackPanel x:Name="FavoritePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <RadioButton Tag="1" Style="{StaticResource LevelBtn}" Content="😐" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                                <RadioButton Tag="2" Style="{StaticResource LevelBtn}" Content="🙂" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                                <RadioButton Tag="3" Style="{StaticResource LevelBtn}" Content="😊" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                                <RadioButton Tag="4" Style="{StaticResource LevelBtn}" Content="😍" Margin="0,0,10,0" Checked="FavLevel_Checked"/>
                                <RadioButton Tag="5" Style="{StaticResource LevelBtn}" Content="🤩" Checked="FavLevel_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtFavHint"
                                       Text="可不选，之后逐件补也行"
                                       FontSize="11"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource ModalFooterHost}"
                        Padding="24,14">
                    <Grid>
                            <TextBlock x:Name="TxtImportHint"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Grid MaxWidth="420" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    x:Name="BtnFooterCancel"
                                    Content="取消"
                                    Style="{StaticResource ModalCancelButton}"
                                    Click="Cancel_Click"/>
                            <Button Grid.Column="2"
                                    x:Name="BtnSave"
                                    Content="导入这一批"
                                    Style="{StaticResource ModalSaveButton}"
                                    Click="Save_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
