<UserControl x:Class="ClosetApp.UI.Components.Clothing.WardrobeSummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClosetApp.UI;component/Components/Clothing/WardrobeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource PageSummaryCard}"
            Margin="44,12,44,10"
            Padding="16,14"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1"
            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="衣柜"
                               Style="{StaticResource PageSummaryTitleText}"
                               FontSize="14"/>
                    <TextBlock Text="搜索、筛选、待整理都在这里。"
                               Style="{StaticResource PageSummaryHintText}"
                               Margin="8,1,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="18,0,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource PageSummaryBadge}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 件}"
                                       Style="{StaticResource PageSummaryValueText}"/>
                            <TextBlock Text=" 全部"
                                       Style="{StaticResource PageSummaryHintText}"
                                       Margin="4,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource PageSummaryBadge}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilteredCount, StringFormat={}{0} 件}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" 当前"
                                       Style="{StaticResource PageSummaryHintText}"
                                       Margin="4,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource SearchBoxStyle}"
                         MinWidth="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Content="{Binding FilterToggleText}"
                            Style="{StaticResource WardrobeButton}"
                            Click="ToggleFilter_Click"/>
                    <Button Content="清除"
                            Style="{StaticResource WardrobeButton}"
                            Margin="6,0,0,0"
                            Click="ClearFilter_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="待整理"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="导入后优先补资料"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,1,0,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="批量补全"
                                Style="{StaticResource WardrobeButton}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding CanBatchCompleteCurrentQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="BatchCompleteQueue_Click"/>
                        <Button Content="{Binding ClearCurrentCategoryText}"
                                Style="{StaticResource WardrobeButton}"
                                Margin="4,0,0,0"
                                Visibility="{Binding CanClearCurrentCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="ClearCurrentCategory_Click"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,2">
                    <RadioButton Content="{Binding QueueAllText}"
                                 Style="{StaticResource ChipStyle}"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueAllSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUnnamedText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUnnamedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUncategorizedText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUncategorizedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUnseasonedText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUnseasonedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUntaggedText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUntaggedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueMissingBrandOrColorText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueMissingBrandOrColorSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueRecentlyImportedText}"
                                 Style="{StaticResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueRecentlyImportedSelected, Mode=TwoWay}"/>
                </WrapPanel>

                <Border Background="{DynamicResource SurfaceSectionBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,4,0,0"
                        Visibility="{Binding ShowRecentImportSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RecentImportSummaryTitle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecentImportSummaryBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUnnamedCount, StringFormat=未命名 {0}}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUncategorizedCount, StringFormat=未分类 {0}}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUnseasonedCount, StringFormat=未设季节 {0}}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUntaggedCount, StringFormat=无标签 {0}}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,0,4">
                                <TextBlock Text="{Binding RecentlyImportedMissingBrandOrColorCount, StringFormat=无品牌/颜色 {0}}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
