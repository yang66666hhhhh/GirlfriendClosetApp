<UserControl x:Class="ClosetApp.UI.Components.Clothing.WardrobeSummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource PageSummaryCard}"
            Margin="44,8,44,8"
            Padding="12,10"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="1"
            Visibility="{Binding IsEmpty, Converter={DynamicResource InverseBooleanToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="衣柜"
                               Style="{DynamicResource PageSummaryTitleText}"
                               FontSize="13"/>
                    <TextBlock Text="搜索、筛选、待整理都在这里。"
                               Style="{DynamicResource PageSummaryHintText}"
                               Margin="6,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Style="{DynamicResource PageSummaryBadge}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Padding="8,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 件}"
                                       Style="{DynamicResource PageSummaryValueText}"/>
                            <TextBlock Text=" 全部"
                                       Style="{DynamicResource PageSummaryHintText}"
                                       Margin="4,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource PageSummaryBadge}"
                            Background="{DynamicResource PrimaryLightBrush}"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilteredCount, StringFormat={}{0} 件}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" 当前"
                                       Style="{DynamicResource PageSummaryHintText}"
                                       Margin="4,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{DynamicResource SearchBoxStyle}"
                         MinWidth="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Content="{Binding FilterToggleText}"
                            Style="{DynamicResource WardrobeButton}"
                            Click="ToggleFilter_Click"/>
                    <Button Content="清除"
                            Style="{DynamicResource WardrobeButton}"
                            Margin="4,0,0,0"
                            Click="ClearFilter_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="待整理"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="导入后优先补资料"
                               FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,1,0,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="批量补全"
                                Style="{DynamicResource WardrobeButton}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding CanBatchCompleteCurrentQueue, Converter={DynamicResource BooleanToVisibilityConverter}}"
                                Click="BatchCompleteQueue_Click"/>
                        <Button Content="{Binding ClearCurrentCategoryText}"
                                Style="{DynamicResource WardrobeButton}"
                                Margin="4,0,0,0"
                                Visibility="{Binding CanClearCurrentCategory, Converter={DynamicResource BooleanToVisibilityConverter}}"
                                Click="ClearCurrentCategory_Click"/>
                    </StackPanel>
                </Grid>

                <WrapPanel>
                    <RadioButton Content="{Binding QueueAllText}"
                                 Style="{DynamicResource ChipStyle}"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueAllSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUnnamedText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUnnamedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUncategorizedText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUncategorizedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUnseasonedText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUnseasonedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueUntaggedText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueUntaggedSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueMissingBrandOrColorText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueMissingBrandOrColorSelected, Mode=TwoWay}"/>
                    <RadioButton Content="{Binding QueueRecentlyImportedText}"
                                 Style="{DynamicResource ChipStyle}"
                                 Margin="8,0,0,8"
                                 GroupName="QueueGroup"
                                 IsChecked="{Binding IsQueueRecentlyImportedSelected, Mode=TwoWay}"/>
                </WrapPanel>

                <Border Background="{DynamicResource SurfaceSectionBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,8"
                        Margin="0,2,0,0"
                        Visibility="{Binding ShowRecentImportSummary, Converter={DynamicResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RecentImportSummaryTitle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecentImportSummaryBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Border Style="{DynamicResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUnnamedCount, StringFormat=未命名 {0}}"
                                           Style="{DynamicResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{DynamicResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUncategorizedCount, StringFormat=未分类 {0}}"
                                           Style="{DynamicResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{DynamicResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUnseasonedCount, StringFormat=未设季节 {0}}"
                                           Style="{DynamicResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{DynamicResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,5,4">
                                <TextBlock Text="{Binding RecentlyImportedUntaggedCount, StringFormat=无标签 {0}}"
                                           Style="{DynamicResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                            <Border Style="{DynamicResource PageSummaryBadge}"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    Padding="7,4"
                                    Margin="0,0,0,4">
                                <TextBlock Text="{Binding RecentlyImportedMissingBrandOrColorCount, StringFormat=无品牌/颜色 {0}}"
                                           Style="{DynamicResource PageSummaryValueText}"
                                           FontSize="9"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
