<UserControl x:Class="ClosetApp.UI.Components.Settings.AiImageGenerationSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconCapsuleButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <TextBlock Text="AI 图片生成"
                       Style="{StaticResource PageSectionTitleText}"/>
            <StackPanel x:Name="AiConnectionGrid"
                        Margin="0,0,0,0">
                <Border Style="{StaticResource SettingsInsetCard}">
                    <StackPanel x:Name="AiConnectionContent"
                                VerticalAlignment="Stretch">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="连接配置"
                                       Style="{StaticResource PageFieldLabelText}"/>
                            <Button x:Name="BtnTestConnection"
                                    Content="测试连接"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="TestConnection_Click"
                                    Margin="12,0,0,0"/>
                        </DockPanel>

                        <TextBlock Text="Base URL"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBox x:Name="TxtBaseUrl"
                                 Style="{StaticResource SettingsFieldInput}"
                                 Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid x:Name="AiConnectionMetaGrid"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.65*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="模型"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource PageFieldLabelText}"/>
                                <Grid x:Name="AiModelGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ComboBox x:Name="CmbModelPreset"
                                              Width="170"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsFieldComboBox}"
                                              SelectionChanged="ModelPreset_SelectionChanged">
                                        <ComboBoxItem Content="gpt-image-2" Tag="gpt-image-2"/>
                                        <ComboBoxItem Content="gpt-image-1" Tag="gpt-image-1"/>
                                        <ComboBoxItem Content="gpt-image-1.5" Tag="gpt-image-1.5"/>
                                        <ComboBoxItem Content="gpt-image-1-mini" Tag="gpt-image-1-mini"/>
                                        <ComboBoxItem Content="gpt-5.5" Tag="gpt-5.5"/>
                                        <ComboBoxItem Content="gpt-5.4" Tag="gpt-5.4"/>
                                        <ComboBoxItem Content="自定义" Tag="__custom__"/>
                                    </ComboBox>

                                    <StackPanel x:Name="AiCustomModelPanel"
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                        <TextBox x:Name="TxtModel"
                                                 Style="{StaticResource SettingsFieldInput}"
                                                 Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="仅在自定义模型时填写完整模型名。"
                                                   Style="{StaticResource PageMutedBodyText}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="超时（秒）"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource PageFieldLabelText}"/>
                                <TextBox x:Name="TxtTimeoutSeconds"
                                         Width="96"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource SettingsFieldInput}"
                                         Text="{Binding AiTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="建议 90 到 180 秒。"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AiCredentialCard"
                        Style="{StaticResource SettingsInsetCard}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="凭证"
                                   Style="{StaticResource PageFieldLabelText}"/>

                        <TextBlock Text="API Key"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtApiKeyVisible"
                                     Grid.Column="0"
                                     Style="{StaticResource SettingsFieldInput}"
                                     Visibility="Collapsed"
                                     TextChanged="ApiKeyVisible_TextChanged"/>
                            <PasswordBox x:Name="TxtApiKey"
                                         Grid.Column="0"
                                         Style="{StaticResource WorkbenchPasswordInput}"
                                         PasswordChanged="ApiKeyPasswordChanged"/>
                            <Button x:Name="BtnToggleApiKeyVisibility"
                                    Grid.Column="2"
                                    Content="👁"
                                    Style="{StaticResource IconCapsuleButton}"
                                    ToolTip="显示或隐藏 API Key"
                                    Click="ToggleApiKeyVisibility_Click"/>
                        </Grid>

                        <Border x:Name="AiStatusCard"
                                Style="{StaticResource PageInsetCard}"
                                Background="{DynamicResource SurfacePageBrush}"
                                Margin="0,12,0,0"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding AiSettingsSummary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AiSettingsDetail}"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,4,0,0"
                                           MaxHeight="72"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="AiCredentialActionRow"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSaveConfig"
                                    Grid.Column="0"
                                    Content="保存配置"
                                    Style="{StaticResource SettingsButton}"
                                    Click="Save_Click"/>
                            <Button x:Name="BtnOpenProfile"
                                    Grid.Column="2"
                                    Content="个人中心"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenProfile_Click"/>
                        </Grid>

                        <UniformGrid x:Name="AiCredentialActions"
                                     Columns="2"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtAiOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
