<UserControl x:Class="ClosetApp.UI.Components.Settings.AiImageGenerationSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconCapsuleButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PresetShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetShell" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="PresetShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="PresetShell" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="PresetShell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PresetShell" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}">
                <TextBlock Text="图片生成"
                           Style="{StaticResource SettingsEyebrowBadgeText}"/>
            </Border>

            <TextBlock Text="AI 图片生成"
                       Style="{StaticResource PageSectionTitleText}"/>
            <TextBlock Text="管理中转接口、模型和 API Key，让生成配置更稳定也更容易切换。"
                       Style="{StaticResource PageSectionBodyText}"/>

            <Border Style="{StaticResource SettingsInsetCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="快捷预设"
                                       Style="{StaticResource PageFieldLabelText}"/>
                            <TextBlock Text="切换时会保留你已保存的 API Key。"
                                       Style="{StaticResource PageMutedBodyText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnTestConnection"
                                Content="测试连接"
                                Style="{StaticResource SettingsGhostButton}"
                                Click="TestConnection_Click"
                                Margin="12,0,0,0"/>
                    </DockPanel>

                    <UniformGrid Columns="2"
                                 Margin="0,14,0,0">
                        <Button x:Name="BtnPresetOpenAiMain"
                                Margin="0,0,10,10"
                                Style="{StaticResource PresetButton}"
                                Click="Preset_Click">
                            <StackPanel>
                                <TextBlock x:Name="TxtPresetOpenAiMain"
                                           Text="GPT Image 2"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="gpt-image-2"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="当前中转主路线"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPresetOpenAi15"
                                Margin="0,0,0,10"
                                Style="{StaticResource PresetButton}"
                                Click="Preset_Click">
                            <StackPanel>
                                <TextBlock x:Name="TxtPresetOpenAi15"
                                           Text="OpenAI 1.5"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="gpt-image-1.5"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="更高质量优先"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPresetOpenAiMini"
                                Margin="0,0,10,0"
                                Style="{StaticResource PresetButton}"
                                Click="Preset_Click">
                            <StackPanel>
                                <TextBlock x:Name="TxtPresetOpenAiMini"
                                           Text="OpenAI Mini"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="gpt-image-1-mini"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="低成本尝试"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPresetOpenAi55"
                                Style="{StaticResource PresetButton}"
                                Click="Preset_Click">
                            <StackPanel>
                                <TextBlock x:Name="TxtPresetOpenAi55"
                                           Text="GPT-5.5"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="responses 路由"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="实验兼容"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="连接配置"
                                   Style="{StaticResource PageFieldLabelText}"/>

                        <TextBlock Text="Base URL"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBox x:Name="TxtBaseUrl"
                                 Style="{StaticResource SettingsFieldInput}"
                                 Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="模型"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbModelPreset"
                                      Grid.Column="0"
                                      MinHeight="40"
                                      SelectionChanged="ModelPreset_SelectionChanged">
                                <ComboBoxItem Content="gpt-image-2" Tag="gpt-image-2"/>
                                <ComboBoxItem Content="gpt-image-1" Tag="gpt-image-1"/>
                                <ComboBoxItem Content="gpt-image-1.5" Tag="gpt-image-1.5"/>
                                <ComboBoxItem Content="gpt-image-1-mini" Tag="gpt-image-1-mini"/>
                                <ComboBoxItem Content="gpt-5.5" Tag="gpt-5.5"/>
                                <ComboBoxItem Content="gpt-5.4" Tag="gpt-5.4"/>
                                <ComboBoxItem Content="自定义" Tag="__custom__"/>
                            </ComboBox>
                            <TextBox x:Name="TxtModel"
                                     Grid.Column="2"
                                     Style="{StaticResource SettingsFieldInput}"
                                     Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Text="超时（秒）"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBox x:Name="TxtTimeoutSeconds"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource SettingsFieldInput}"
                                 Text="{Binding AiTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="凭证与说明"
                                   Style="{StaticResource PageFieldLabelText}"/>

                        <TextBlock Text="API Key"
                                   Margin="0,12,0,6"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtApiKeyVisible"
                                     Grid.Column="0"
                                     Style="{StaticResource SettingsFieldInput}"
                                     Visibility="Collapsed"
                                     TextChanged="ApiKeyVisible_TextChanged"/>
                            <PasswordBox x:Name="TxtApiKey"
                                         Grid.Column="0"
                                         MinHeight="40"
                                         Padding="12,0"
                                         PasswordChanged="ApiKeyPasswordChanged"/>
                            <Button x:Name="BtnToggleApiKeyVisibility"
                                    Grid.Column="2"
                                    Content="👁"
                                    Style="{StaticResource IconCapsuleButton}"
                                    ToolTip="显示或隐藏 API Key"
                                    Click="ToggleApiKeyVisibility_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtApiKeyHint"
                                   Text="可切换显示或隐藏。"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,8,0,0"/>

                        <Border Style="{StaticResource PageInsetCard}"
                                Background="{DynamicResource SurfacePageBrush}"
                                Margin="0,14,0,0"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding AiSettingsSummary}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AiSettingsDetail}"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="BtnSaveConfig"
                                    Content="保存配置"
                                    Style="{StaticResource SettingsButton}"
                                    Margin="0,0,8,8"
                                    Click="Save_Click"/>
                            <Button x:Name="BtnOpenProfile"
                                    Content="编辑个人档案"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Margin="0,0,0,8"
                                    Click="OpenProfile_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="TxtAiOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
