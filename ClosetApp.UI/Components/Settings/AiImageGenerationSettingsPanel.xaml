    <UserControl x:Class="ClosetApp.UI.Components.Settings.AiImageGenerationSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="IconCapsuleButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource PageToolbarCapsuleButton}">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <TextBlock Text="AI 图片生成"
                       Style="{StaticResource PageSectionTitleText}"/>
            <TextBlock Text="配置接口、模型和 API Key。"
                       Style="{StaticResource PageSectionBodyText}"
                       Margin="0,6,0,0"/>

            <TextBlock Text="一键切换"
                       Margin="0,16,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <UniformGrid Columns="2">
                <Button x:Name="BtnPresetOpenAiMain"
                        Style="{StaticResource PresetButton}"
                        Margin="0,0,10,10"
                        Click="Preset_Click">
                    <StackPanel>
                        <TextBlock x:Name="TxtPresetOpenAiMain"
                                   Text="GPT Image 2"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="gpt-image-2 · 当前中转主路线"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPresetOpenAi15"
                        Style="{StaticResource PresetButton}"
                        Margin="0,0,0,10"
                        Click="Preset_Click">
                    <StackPanel>
                        <TextBlock x:Name="TxtPresetOpenAi15"
                                   Text="OpenAI 1.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="gpt-image-1.5 · 更高质量优先"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPresetOpenAiMini"
                        Style="{StaticResource PresetButton}"
                        Margin="0,0,10,0"
                        Click="Preset_Click">
                    <StackPanel>
                        <TextBlock x:Name="TxtPresetOpenAiMini"
                                   Text="OpenAI Mini"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="gpt-image-1-mini · 低成本尝试"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                <Button x:Name="BtnPresetOpenAi55"
                        Style="{StaticResource PresetButton}"
                        Click="Preset_Click">
                    <StackPanel>
                        <TextBlock x:Name="TxtPresetOpenAi55"
                                   Text="GPT-5.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="实验兼容 · responses 路由"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
            <TextBlock Text="预设会保留已保存的 API Key，并自动测试连通性。"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Base URL" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="TxtBaseUrl"
                     Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="模型" Margin="0,14,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbModelPreset"
                          Grid.Column="0"
                          SelectionChanged="ModelPreset_SelectionChanged">
                    <ComboBoxItem Content="gpt-image-2" Tag="gpt-image-2"/>
                    <ComboBoxItem Content="gpt-image-1" Tag="gpt-image-1"/>
                    <ComboBoxItem Content="gpt-image-1.5" Tag="gpt-image-1.5"/>
                    <ComboBoxItem Content="gpt-image-1-mini" Tag="gpt-image-1-mini"/>
                    <ComboBoxItem Content="gpt-5.5" Tag="gpt-5.5"/>
                    <ComboBoxItem Content="gpt-5.4" Tag="gpt-5.4"/>
                    <ComboBoxItem Content="自定义" Tag="__custom__"/>
                </ComboBox>
                <TextBox x:Name="TxtModel"
                         Grid.Column="2"
                         Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <TextBlock Text="gpt-image-2 走文生图；支持编辑的图片模型才会上传参考图。"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock Text="API Key" Margin="0,14,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtApiKeyVisible"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         TextChanged="ApiKeyVisible_TextChanged"/>
                <PasswordBox x:Name="TxtApiKey"
                             Grid.Column="0"
                             PasswordChanged="ApiKeyPasswordChanged"/>
                <Button x:Name="BtnToggleApiKeyVisibility"
                        Grid.Column="2"
                        Content="👁"
                        Style="{StaticResource IconCapsuleButton}"
                        ToolTip="显示或隐藏 API Key"
                        Click="ToggleApiKeyVisibility_Click"/>
            </Grid>
            <TextBlock x:Name="TxtApiKeyHint"
                       Text="可切换显示或隐藏。"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock Text="超时（秒）" Margin="0,14,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="TxtTimeoutSeconds"
                     Text="{Binding AiTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>

            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="BtnSaveConfig"
                        Content="保存配置"
                        Style="{StaticResource SettingsButton}"
                        Margin="0,0,8,8"
                        Click="Save_Click"/>
                <Button x:Name="BtnTestConnection"
                        Content="测试连接"
                        Style="{StaticResource CapsuleButton}"
                        Margin="0,0,8,8"
                        Click="TestConnection_Click"/>
                <Button x:Name="BtnOpenProfile"
                        Content="编辑个人档案"
                        Style="{StaticResource CapsuleButton}"
                        Margin="0,0,8,8"
                        Click="OpenProfile_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtAiOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,2,0,0"
                       Visibility="Collapsed"/>

            <Border Background="{DynamicResource SurfaceSectionBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding AiSettingsSummary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding AiSettingsDetail}"
                               Style="{StaticResource PageMutedBodyText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
