<UserControl x:Class="ClosetApp.UI.Components.Settings.StorageLocationsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Grid x:Name="StorageHeaderGrid"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="文件位置"
                               Style="{StaticResource PageSectionTitleText}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="应用目录"
                        Style="{StaticResource SettingsButton}"
                        Click="OpenAppDir_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <Grid x:Name="StoragePathsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="数据目录" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock x:Name="TxtDataDir"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <WrapPanel Style="{StaticResource SettingsActionWrap}">
                            <Button Content="打开目录"
                                    Style="{StaticResource SettingsButton}"
                                    Click="OpenDataDir_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="定位数据库"
                                    Style="{StaticResource SettingsButton}"
                                    Click="OpenDatabase_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="图片目录" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock x:Name="TxtImagesDir"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <WrapPanel Style="{StaticResource SettingsActionWrap}">
                            <Button Content="打开图片"
                                    Style="{StaticResource SettingsButton}"
                                    Click="OpenImagesDir_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="打开缓存"
                                    Style="{StaticResource SettingsButton}"
                                    Click="OpenThumbnailsDir_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
