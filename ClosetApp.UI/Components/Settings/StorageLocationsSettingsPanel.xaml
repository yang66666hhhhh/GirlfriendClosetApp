<UserControl x:Class="ClosetApp.UI.Components.Settings.StorageLocationsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ClosetApp.Infrastructure;assembly=ClosetApp.Infrastructure">
    <Border Style="{StaticResource SettingsCompactSectionCard}">
        <Border x:Name="StorageWorkbenchCard"
                Style="{StaticResource SettingsInsetCard}">
            <StackPanel>
                <Grid x:Name="StorageHeaderGrid"
                      Style="{StaticResource SettingsCardHeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目录与路径"
                               VerticalAlignment="Center"
                               Style="{StaticResource SettingsCardTitleText}"/>
                    <Button Grid.Column="1"
                            Content="应用目录"
                            Style="{StaticResource SettingsGhostButton}"
                            Click="OpenAppDir_Click"
                            VerticalAlignment="Top"/>
                </Grid>

                <StackPanel x:Name="StoragePathsStack">
                    <Grid x:Name="StorageRowGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="数据库"
                                   Style="{StaticResource SettingsRowFieldLabelText}"/>
                        <TextBlock x:Name="TxtDataDir"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Content="打开目录"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenDataDir_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="定位数据库"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenDatabase_Click"
                                    Margin="0"/>
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,10,0,10"
                                Height="1"
                                Background="{DynamicResource BorderDividerBrush}"
                                Opacity="0.75"/>

                        <TextBlock Grid.Row="2"
                                   Text="图片"
                                   Style="{StaticResource SettingsRowFieldLabelText}"/>
                        <TextBlock x:Name="TxtImagesDir"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Content="打开图片"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenImagesDir_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="打开缓存"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenThumbnailsDir_Click"
                                    Margin="0"/>
                        </WrapPanel>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Margin="0,10,0,10"
                                Height="1"
                                Background="{DynamicResource BorderDividerBrush}"
                                Opacity="0.75"/>

                        <TextBlock Grid.Row="4"
                                   Text="缓存"
                                   Style="{StaticResource SettingsRowFieldLabelText}"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{x:Static infra:AppPaths.ThumbnailsDir}"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Grid.Row="4"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Content="打开缓存"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenThumbnailsDir_Click"
                                    Margin="0"/>
                        </WrapPanel>

                        <Border Grid.Row="5"
                                Grid.ColumnSpan="3"
                                Margin="0,10,0,10"
                                Height="1"
                                Background="{DynamicResource BorderDividerBrush}"
                                Opacity="0.75"/>

                        <TextBlock Grid.Row="6"
                                   Text="日志"
                                   Style="{StaticResource SettingsRowFieldLabelText}"/>
                        <TextBlock x:Name="TxtLogsDir"
                                   Grid.Row="6"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <WrapPanel x:Name="StorageActionRail"
                                   Grid.Row="6"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Content="打开日志"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="OpenLogsDir_Click"
                                    Margin="0"/>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
