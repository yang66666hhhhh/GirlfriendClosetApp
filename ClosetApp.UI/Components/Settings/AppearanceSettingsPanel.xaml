<UserControl x:Class="ClosetApp.UI.Components.Settings.AppearanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource LookbookCard}">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingsEyebrowBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingsInsetCard" TargetType="Border" BasedOn="{StaticResource PageInsetCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}"
                    Background="{DynamicResource PrimaryLightBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1">
                <TextBlock Text="外观"
                           Style="{StaticResource SettingsEyebrowBadgeText}"
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="界面与应用"
                       Style="{StaticResource PageSectionTitleText}"/>
            <TextBlock Text="把主题调性和应用信息放在同一块，右侧阅读会更顺。"
                       Style="{StaticResource PageSectionBodyText}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="系统配色"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <shared:ThemeCard x:Name="ThemeRoseCard"
                                              Grid.Column="0"
                                              ThemeKind="Rose"
                                              DisplayName="柔粉"
                                              Description="柔和、克制、奶雾粉。"
                                              PrimaryColor="#CA9C9F"
                                              SoftColor="#F7F0EE"
                                              SurfaceColor="#F9F5F1"
                                              Selected="ThemeCard_Selected"/>

                            <shared:ThemeCard x:Name="ThemeBlueCard"
                                              Grid.Column="2"
                                              ThemeKind="Blue"
                                              DisplayName="清蓝"
                                              Description="克制、清爽、冷一点。"
                                              PrimaryColor="#5881D6"
                                              SoftColor="#E0ECFF"
                                              SurfaceColor="#EBF1FB"
                                              Selected="ThemeCard_Selected"/>
                        </Grid>
                        <TextBlock Text="{Binding ThemeSummary}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ThemeDescription}"
                                   Style="{StaticResource PageMutedBodyText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="应用信息"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock x:Name="TxtVersion"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text=".NET WPF / SQLite / Clean Architecture"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <Button Content="打开应用目录"
                                Style="{StaticResource PageToolbarCapsuleButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="OpenAppDir_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
