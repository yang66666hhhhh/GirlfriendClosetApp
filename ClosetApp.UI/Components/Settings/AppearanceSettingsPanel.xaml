<UserControl x:Class="ClosetApp.UI.Components.Settings.AppearanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <Border x:Name="AppearanceWorkbenchCard"
            Style="{StaticResource SettingsSectionCard}">
        <StackPanel x:Name="AppearanceFlowStack">
            <Border x:Name="AppearanceThemeSection"
                    Style="{StaticResource SettingsInsetCard}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                <StackPanel>
                    <TextBlock Text="主题"
                               Style="{StaticResource SettingsRowFieldLabelText}"
                               Margin="0,0,0,8"/>

                    <StackPanel x:Name="AppearanceThemeCompactList"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <shared:ThemeCard x:Name="ThemeRoseCard"
                                          Margin="0,0,8,0"
                                          ThemeKind="Rose"
                                          DisplayName="柔粉"
                                          Description=""
                                          PrimaryColor="#CA9C9F"
                                          SoftColor="#F7F0EE"
                                          SurfaceColor="#F9F5F1"
                                          Selected="ThemeCard_Selected"/>

                        <shared:ThemeCard x:Name="ThemeBlueCard"
                                          ThemeKind="Blue"
                                          DisplayName="清蓝"
                                          Description=""
                                          PrimaryColor="#5881D6"
                                          SoftColor="#E0ECFF"
                                          SurfaceColor="#F0F5FC"
                                          Selected="ThemeCard_Selected"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="AppearanceSectionDivider"
                    Height="1"
                    Margin="0,14,0,14"
                    Background="{DynamicResource BorderDividerBrush}"
                    Opacity="0.7"/>

            <Border x:Name="AppearanceFontSizeSection"
                    Style="{StaticResource SettingsInsetCard}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="字体大小"
                               Style="{StaticResource SettingsRowFieldLabelText}"
                               Margin="0,0,0,8"/>

                    <Border Style="{StaticResource AppSegmentedTabShell}"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="3"
                                     Width="186">
                            <RadioButton x:Name="RadioFontCompact"
                                         Content="A-"
                                         Tag="Compact"
                                         GroupName="FontSizeLevel"
                                         Style="{StaticResource AppSegmentedTabButton}"
                                         Checked="FontSizeLevel_Checked"/>
                            <RadioButton x:Name="RadioFontBalanced"
                                         Content="A"
                                         Tag="Balanced"
                                         GroupName="FontSizeLevel"
                                         Style="{StaticResource AppSegmentedTabButton}"
                                         Checked="FontSizeLevel_Checked"/>
                            <RadioButton x:Name="RadioFontExpanded"
                                         Content="A+"
                                         Tag="Expanded"
                                         GroupName="FontSizeLevel"
                                         Style="{StaticResource AppSegmentedTabButton}"
                                         Checked="FontSizeLevel_Checked"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="AppearanceDisplayModeSection"
                    Style="{StaticResource SettingsInsetCard}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="默认展示"
                               Style="{StaticResource SettingsRowFieldLabelText}"
                               Margin="0,0,0,8"/>

                    <Border Style="{StaticResource AppSegmentedTabShell}"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2"
                                     Width="220">
                            <RadioButton x:Name="RadioOutfitFirst"
                                         Content="搭配卡片"
                                         GroupName="OutfitDisplayMode"
                                         Style="{StaticResource AppSegmentedTabButton}"
                                         Checked="OutfitDisplayMode_Checked"/>
                            <RadioButton x:Name="RadioEffectImageFirst"
                                         Content="效果图卡片"
                                         GroupName="OutfitDisplayMode"
                                         Style="{StaticResource AppSegmentedTabButton}"
                                         Checked="OutfitDisplayMode_Checked"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
