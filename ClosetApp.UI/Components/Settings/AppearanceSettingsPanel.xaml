<UserControl x:Class="ClosetApp.UI.Components.Settings.AppearanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <Border Style="{StaticResource SettingsSectionCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.98*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource SettingsEyebrowBadge}">
                    <TextBlock Text="外观与界面"
                               Style="{StaticResource SettingsEyebrowBadgeText}"/>
                </Border>
                <TextBlock Text="主题与列表显示"
                           Style="{StaticResource PageSectionTitleText}"/>
                <TextBlock Text="选择整体配色，并设置搭配卡片默认展示方式。"
                           Style="{StaticResource PageSectionBodyText}"
                           Margin="0,6,0,0"/>

                <TextBlock Text="系统主题"
                           Style="{StaticResource PageFieldLabelText}"
                           Margin="0,14,0,0"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <shared:ThemeCard x:Name="ThemeRoseCard"
                                      Grid.Column="0"
                                      ThemeKind="Rose"
                                      DisplayName="柔粉"
                                      Description="柔和、生活化。"
                                      PrimaryColor="#CA9C9F"
                                      SoftColor="#F7F0EE"
                                      SurfaceColor="#F9F5F1"
                                      Selected="ThemeCard_Selected"/>

                    <shared:ThemeCard x:Name="ThemeBlueCard"
                                      Grid.Column="2"
                                      ThemeKind="Blue"
                                      DisplayName="清蓝"
                                      Description="克制、工具感。"
                                      PrimaryColor="#5881D6"
                                      SoftColor="#E0ECFF"
                                      SurfaceColor="#F0F5FC"
                                      Selected="ThemeCard_Selected"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource SettingsSurfacePanel}">
                    <StackPanel>
                        <TextBlock Text="搭配卡片展示"
                                   Style="{StaticResource PageFieldLabelText}"/>

                        <Border Style="{StaticResource AppSegmentedTabShell}"
                                Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RadioOutfitFirst"
                                             Content="搭配优先"
                                             GroupName="OutfitDisplayMode"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="OutfitDisplayMode_Checked"/>
                                <RadioButton x:Name="RadioEffectImageFirst"
                                             Content="效果图优先"
                                             GroupName="OutfitDisplayMode"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="OutfitDisplayMode_Checked"/>
                            </UniformGrid>
                        </Border>

                        <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource SettingsInfoChip}">
                                <TextBlock Text="列表即时切换"
                                           Style="{StaticResource PageSummaryHintText}"/>
                            </Border>
                            <Border Style="{StaticResource SettingsInfoChip}">
                                <TextBlock Text="无效果图自动回退"
                                           Style="{StaticResource PageSummaryHintText}"/>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource SettingsMicroCard}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="当前默认"
                                           Style="{StaticResource PageSummaryHintText}"/>
                                <TextBlock Text="{Binding OutfitCardDisplaySummary}"
                                           Style="{StaticResource PageSummaryValueText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OutfitCardDisplayDetail}"
                                           Style="{StaticResource PageMutedBodyText}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSurfacePanel}"
                        Margin="0,12,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel>
                            <TextBlock Text="应用信息"
                                       Style="{StaticResource PageFieldLabelText}"/>
                            <TextBlock Text="{Binding ThemeSummary}"
                                       Style="{StaticResource PageSummaryValueText}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ThemeDescription}"
                                       Style="{StaticResource PageMutedBodyText}"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtVersion"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text=".NET WPF / SQLite"
                                       Style="{StaticResource PageMutedBodyText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="打开目录"
                                Style="{StaticResource PageToolbarCapsuleButton}"
                                Margin="12,0,0,0"
                                MinWidth="86"
                                Click="OpenAppDir_Click"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
