<UserControl x:Class="ClosetApp.UI.Components.Settings.AppearanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ClosetApp.UI.Components.Shared">
    <Border Style="{StaticResource SettingsSectionCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="AppearanceWorkbenchHeader"
                        Grid.Column="0">
                <TextBlock Text="外观"
                           Style="{StaticResource PageSectionTitleText}"/>

                <TextBlock Text="主题"
                           Style="{StaticResource PageFieldLabelText}"
                           Margin="0,10,0,0"/>
                <Grid x:Name="AppearanceThemeGrid"
                      Margin="0,10,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <shared:ThemeCard x:Name="ThemeRoseCard"
                                      Grid.Column="0"
                                      ThemeKind="Rose"
                                      DisplayName="柔粉"
                                      Description="柔和、生活化。"
                                      PrimaryColor="#CA9C9F"
                                      SoftColor="#F7F0EE"
                                      SurfaceColor="#F9F5F1"
                                      Selected="ThemeCard_Selected"/>

                    <shared:ThemeCard x:Name="ThemeBlueCard"
                                      Grid.Column="2"
                                      ThemeKind="Blue"
                                      DisplayName="清蓝"
                                      Description="克制、工具感。"
                                      PrimaryColor="#5881D6"
                                      SoftColor="#E0ECFF"
                                      SurfaceColor="#F0F5FC"
                                      Selected="ThemeCard_Selected"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border x:Name="AppearanceDisplayModeCard"
                        Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <StackPanel x:Name="AppearancePreferenceHeader">
                            <TextBlock Text="卡片默认"
                                       Style="{StaticResource PageFieldLabelText}"/>
                        </StackPanel>

                        <Border Style="{StaticResource AppSegmentedTabShell}"
                                Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RadioOutfitFirst"
                                             Content="搭配优先"
                                             GroupName="OutfitDisplayMode"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="OutfitDisplayMode_Checked"/>
                                <RadioButton x:Name="RadioEffectImageFirst"
                                             Content="效果图优先"
                                             GroupName="OutfitDisplayMode"
                                             Style="{StaticResource AppSegmentedTabButton}"
                                             Checked="OutfitDisplayMode_Checked"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="AppearanceAppInfoCard"
                        Style="{StaticResource SettingsInsetCard}"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel x:Name="AppearanceInfoHeader">
                                <TextBlock Text="应用"
                                           Style="{StaticResource PageFieldLabelText}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsMicroCard}"
                                    Margin="0,10,0,0"
                                    Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVersion"
                                               Style="{StaticResource PageSummaryValueText}"/>
                                    <TextBlock Text=".NET WPF / SQLite"
                                               Style="{StaticResource PageMutedBodyText}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="打开目录"
                                Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0"
                                MinWidth="86"
                                Click="OpenAppDir_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
