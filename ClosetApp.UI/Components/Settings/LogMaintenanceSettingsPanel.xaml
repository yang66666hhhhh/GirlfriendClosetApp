<UserControl x:Class="ClosetApp.UI.Components.Settings.LogMaintenanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsCompactSectionCard}">
        <StackPanel>
            <Grid x:Name="LogHeaderGrid"
                  Style="{StaticResource SettingsCardHeaderGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="日志维护"
                               Style="{StaticResource SettingsCardTitleText}"/>
                    <TextBlock Text="查看体积并处理历史日志。"
                               Style="{StaticResource SettingsCardSubtitleText}"/>
                </StackPanel>
                <Button x:Name="BtnRefreshStats"
                        Grid.Column="1"
                        Content="刷新"
                        Style="{StaticResource SettingsButton}"
                        Click="RefreshStats_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <Border x:Name="LogSummaryCard"
                    Style="{StaticResource SettingsInsetCard}">
                <StackPanel>
                    <TextBlock Text="当前状态"
                               Style="{StaticResource SettingsRowFieldLabelText}"/>
                    <TextBlock Text="{Binding LogStats}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="日志目录"
                               Margin="0,10,0,0"
                               Style="{StaticResource SettingsRowFieldLabelText}"/>
                    <TextBlock x:Name="TxtLogDir"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnOpenLogsDir"
                        Grid.Column="0"
                        Content="打开日志目录"
                        Style="{StaticResource SettingsGhostButton}"
                        Click="OpenLogsDir_Click"
                        HorizontalAlignment="Stretch"/>
                <Button x:Name="BtnClearLogs"
                        Grid.Column="2"
                        Content="清理历史日志"
                        Style="{StaticResource SettingsDangerGhostButton}"
                        Click="ClearLogs_Click"
                        HorizontalAlignment="Stretch"/>
            </Grid>
            <TextBlock x:Name="TxtLogOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
