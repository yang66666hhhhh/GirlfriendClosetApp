<UserControl x:Class="ClosetApp.UI.Components.Settings.LogMaintenanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}">
                <TextBlock Text="排障"
                           Style="{StaticResource SettingsEyebrowBadgeText}"/>
            </Border>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="系统日志"
                               Style="{StaticResource PageSectionTitleText}"/>
                    <TextBlock Text="查看目录并清理历史日志。"
                               Style="{StaticResource PageSectionBodyText}"/>
                </StackPanel>
                <Button x:Name="BtnRefreshStats"
                        Grid.Column="1"
                        Content="刷新"
                        Style="{StaticResource SettingsButton}"
                        Click="RefreshStats_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <Border Style="{StaticResource SettingsInsetCard}">
                <StackPanel>
                    <TextBlock Text="{Binding LogStats}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtLogDir"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                <Button x:Name="BtnOpenLogsDir"
                        Content="打开日志目录"
                        Style="{StaticResource SettingsButton}"
                        Click="OpenLogsDir_Click"
                        Margin="0,0,8,8"/>
                <Button x:Name="BtnClearLogs"
                        Content="清理历史日志"
                        Style="{StaticResource PageToolbarDangerButton}"
                        Click="ClearLogs_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtLogOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
