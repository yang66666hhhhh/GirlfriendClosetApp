<UserControl x:Class="ClosetApp.UI.Components.Settings.ImageMaintenanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}">
                <TextBlock Text="维护"
                           Style="{StaticResource SettingsEyebrowBadgeText}"/>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="图片资产"
                               Style="{StaticResource PageSectionTitleText}"/>
                    <TextBlock Text="缓存、缺图和孤儿原图。"
                               Style="{StaticResource PageSectionBodyText}"/>
                </StackPanel>
                <Button x:Name="BtnRefreshStats"
                        Grid.Column="1"
                        Content="刷新"
                        Style="{StaticResource SettingsButton}"
                        Click="RefreshStats_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Border Style="{StaticResource SettingsStatCard}">
                    <StackPanel>
                        <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                        <TextBlock Text="{Binding ImageStats}" Style="{StaticResource SettingsStatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsStatCard}">
                    <StackPanel>
                        <TextBlock Text="缓存体量" Style="{StaticResource SettingsStatLabel}"/>
                        <TextBlock Text="{Binding CacheStats}" Style="{StaticResource SettingsStatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsStatCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="缺失状态" Style="{StaticResource SettingsStatLabel}"/>
                        <TextBlock Text="{Binding MissingImageStats}" Style="{StaticResource SettingsStatValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="缓存健康" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding ThumbnailHealthStats}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="原图治理" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding OrphanOriginalStats}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel Style="{StaticResource SettingsActionWrap}">
                <Button x:Name="BtnRebuildThumbnails"
                        Content="重建缓存"
                        Style="{StaticResource SettingsButton}"
                        Click="RebuildThumbnails_Click"
                        Margin="0,0,8,8"/>
                <Button x:Name="BtnRepairMissingImages"
                        Content="修复缺图"
                        Style="{StaticResource SettingsButton}"
                        Click="RepairMissingImages_Click"
                        Margin="0,0,8,8"/>
                <Button x:Name="BtnCheckWornRecordImages"
                        Content="检查历史图"
                        Style="{StaticResource SettingsButton}"
                        Click="CheckWornRecordImages_Click"
                        Margin="0,0,8,8"/>
                <Button x:Name="BtnClearThumbnails"
                        Content="清理缓存"
                        Style="{StaticResource PageToolbarDangerButton}"
                        Click="ClearThumbnails_Click"
                        Margin="0,0,8,8"/>
                <Button x:Name="BtnCleanupOrphanOriginals"
                        Content="清理原图"
                        Style="{StaticResource PageToolbarDangerButton}"
                        Click="CleanupOrphanOriginals_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtImageOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
