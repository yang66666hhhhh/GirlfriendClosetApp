<UserControl x:Class="ClosetApp.UI.Components.Settings.ImageMaintenanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsCompactSectionCard}">
        <StackPanel>
            <Grid Style="{StaticResource SettingsCardHeaderGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="图片治理"
                               Style="{StaticResource SettingsCardTitleText}"/>
                    <TextBlock Text="关注缓存、缺图和原图清理。"
                               Style="{StaticResource SettingsCardSubtitleText}"/>
                </StackPanel>
                <Button x:Name="BtnRefreshStats"
                        Grid.Column="1"
                        Content="刷新"
                        Style="{StaticResource SettingsButton}"
                        Click="RefreshStats_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <Grid x:Name="ImageStatsGrid"
                  Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3"
                        Style="{StaticResource SettingsInsetCard}"
                        Margin="0,0,0,10"
                        Background="{DynamicResource SurfacePageBrush}">
                    <StackPanel>
                        <TextBlock Text="当前概况"
                                   Style="{StaticResource SettingsRowFieldLabelText}"/>
                        <TextBlock Text="{Binding MissingImageStats}"
                                   Style="{StaticResource SettingsStatValue}"/>
                        <TextBlock Text="优先处理缺图，再安排缓存重建和原图清理。"
                                   Style="{StaticResource SettingsInlineHintText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource SettingsStatCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="原图规模" Style="{StaticResource SettingsStatLabel}"/>
                        <TextBlock Text="{Binding ImageStats}" Style="{StaticResource SettingsStatValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource SettingsStatCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="缓存体量" Style="{StaticResource SettingsStatLabel}"/>
                        <TextBlock Text="{Binding CacheStats}" Style="{StaticResource SettingsStatValue}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ImageHealthGrid"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="缓存健康" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding ThumbnailHealthStats}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="原图治理" Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding OrphanOriginalStats}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="ImageActionsWrap"
                        Margin="0,0,0,0">
                <Grid x:Name="ImagePrimaryActions">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRebuildThumbnails"
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="重建缓存"
                            Style="{StaticResource SettingsButton}"
                            Click="RebuildThumbnails_Click"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="BtnRepairMissingImages"
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="修复缺图"
                            Style="{StaticResource SettingsButton}"
                            Click="RepairMissingImages_Click"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="BtnCheckWornRecordImages"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Content="检查历史图"
                            Style="{StaticResource SettingsGhostButton}"
                            Click="CheckWornRecordImages_Click"
                            HorizontalAlignment="Stretch"/>
                </Grid>

                <Grid x:Name="ImageDangerActions"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnClearThumbnails"
                            Grid.Column="0"
                            Content="清理缓存"
                            Style="{StaticResource SettingsDangerGhostButton}"
                            Click="ClearThumbnails_Click"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="BtnCleanupOrphanOriginals"
                            Grid.Column="2"
                            Content="清理原图"
                            Style="{StaticResource SettingsDangerButton}"
                            Click="CleanupOrphanOriginals_Click"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="TxtImageOperationStatus"
                       Style="{StaticResource PageMutedBodyText}"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
