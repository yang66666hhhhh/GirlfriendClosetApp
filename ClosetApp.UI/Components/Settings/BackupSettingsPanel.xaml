<UserControl x:Class="ClosetApp.UI.Components.Settings.BackupSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters"
             xmlns:dto="clr-namespace:ClosetApp.Application.DTOs;assembly=ClosetApp.Application">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}"
            Margin="0">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}">
                <TextBlock Text="安全"
                           Style="{StaticResource SettingsEyebrowBadgeText}"/>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="数据备份与恢复"
                               Style="{StaticResource PageSectionTitleText}"/>
                    <TextBlock Text="导出、导入与历史。"
                               Style="{StaticResource PageSectionBodyText}"/>
                </StackPanel>
                <Button x:Name="BtnRefreshBackupState"
                        Grid.Column="1"
                        Content="刷新状态"
                        Style="{StaticResource SettingsButton}"
                        Click="RefreshBackupState_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <Grid x:Name="BackupActionGrid"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BackupExportCard"
                        Style="{StaticResource SettingsInsetCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="导出备份"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="ZIP 保留图片。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,10"/>
                        <UniformGrid x:Name="BackupExportActions"
                                     Columns="2">
                            <Button x:Name="BtnExportBackup"
                                    Content="导出 ZIP"
                                    Style="{StaticResource SettingsButton}"
                                    Click="ExportBackup_Click"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnQuickExportBackup"
                                    Content="快速导出"
                                    Style="{StaticResource SettingsGhostButton}"
                                    Click="QuickExportBackup_Click"
                                    Margin="8,0,0,8"/>
                        </UniformGrid>
                        <Button x:Name="BtnOpenBackupsDir"
                                Content="打开备份目录"
                                Style="{StaticResource SettingsGhostButton}"
                                Click="OpenBackupsDir_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BackupImportCard"
                        Grid.Column="2"
                        Style="{StaticResource SettingsInsetCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="导入恢复"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="会覆盖当前数据。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,10"/>
                        <Button x:Name="BtnImportBackup"
                                Content="导入备份"
                                Style="{StaticResource SettingsDangerButton}"
                                Click="ImportBackup_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="导出前校验"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding BackupValidation}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding BackupValidationData}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding BackupValidationImages}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding BackupValidationHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <Border Style="{StaticResource PageWarningCard}"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsBackupValidationWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="导出提醒"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BackupValidationWarnings}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SettingsInsetCard}">
                    <StackPanel>
                        <TextBlock Text="最近一次导入"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <TextBlock Text="{Binding LastImportSummary}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LastImportDetail}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <Border Style="{StaticResource PageWarningCard}"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsLastImportWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="建议处理"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastImportWarning}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                                <Button x:Name="BtnRepairMissingImages"
                                        Content="修复缺图"
                                        Style="{StaticResource SettingsButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="RepairMissingImages_Click"
                                        Visibility="{Binding IsRepairAfterImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PageInsetCard}"
                                Background="{DynamicResource SurfacePageBrush}"
                                Padding="12"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsLastImportMissingCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="缺失图片"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastImportMissingFiles}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="BackupHistoryCard"
                    Style="{StaticResource SettingsInsetCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="备份历史"
                                   Style="{StaticResource PageFieldLabelText}"/>
                        <Button x:Name="BtnClearBackupHistory"
                                Content="清空历史"
                                Style="{StaticResource SettingsDangerGhostButton}"
                                HorizontalAlignment="Right"
                                Click="ClearBackupHistory_Click"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding BackupHistory}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dto:BackupHistoryItem}">
                                <Border Background="{DynamicResource SurfacePageBrush}"
                                        CornerRadius="14"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Summary}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MetaText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding TimestampText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"/>
                                        <UniformGrid x:Name="BackupHistoryActions"
                                                     Columns="2"
                                                     Margin="0,8,0,0">
                                            <Button Content="打开文件"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Click="OpenBackupFile_Click"
                                                    Tag="{Binding FilePath}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="打开目录"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Click="OpenBackupFolder_Click"
                                                    Tag="{Binding FilePath}"
                                                    Margin="8,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BackupHistoryEmptyText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsBackupHistoryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock x:Name="TxtBackupOperationStatus"
                               Style="{StaticResource PageMutedBodyText}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
