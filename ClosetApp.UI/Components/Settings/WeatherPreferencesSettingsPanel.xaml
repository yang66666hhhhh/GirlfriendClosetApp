<UserControl x:Class="ClosetApp.UI.Components.Settings.WeatherPreferencesSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClosetApp.UI.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsSectionCard}">
        <StackPanel>
            <Border Style="{StaticResource SettingsEyebrowBadge}">
                <TextBlock Text="偏好"
                           Style="{StaticResource SettingsEyebrowBadgeText}"/>
            </Border>
            <TextBlock Text="天气与城市"
                       Style="{StaticResource PageSectionTitleText}"/>
            <TextBlock Text="默认城市会用于获取实时天气，后续天气穿搭推荐也会直接复用这里。"
                       Style="{StaticResource PageSectionBodyText}"/>

            <Border Style="{StaticResource SettingsInsetCard}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="默认城市"
                               Style="{StaticResource PageFieldLabelText}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtWeatherCity"
                                 Grid.Column="0"
                                 MinHeight="40"
                                 Padding="12,9"
                                 IsEnabled="{Binding CanEditWeather}"
                                 Text="{Binding WeatherCity, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button x:Name="BtnSaveWeatherCity"
                                Grid.Column="2"
                                Content="{Binding WeatherSaveButtonText}"
                                Style="{StaticResource SettingsButton}"
                                Click="SaveWeatherCity_Click"
                                IsEnabled="{Binding CanEditWeather}"/>
                        <Button x:Name="BtnRefreshWeather"
                                Grid.Column="4"
                                Content="{Binding WeatherRefreshButtonText}"
                                Style="{StaticResource SettingsButton}"
                                Click="RefreshWeather_Click"
                                IsEnabled="{Binding CanEditWeather}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsInsetCard}">
                <StackPanel>
                    <TextBlock Text="{Binding WeatherSummary}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WeatherDetails}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding WeatherObservedAt}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                    <Border Style="{StaticResource PageInsetCard}"
                            Background="{DynamicResource SurfacePageBrush}"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsWeatherStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding WeatherStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsInsetCard}"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="今日推荐偏好"
                               Style="{StaticResource PageFieldLabelText}"/>
                    <TextBlock Text="这里会影响搭配页的天气推荐，先把常用场景、轮换方式和是否避开今天已穿过设好。"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  MinHeight="36"
                                  ItemsSource="{Binding RecommendationSceneOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  IsEnabled="{Binding CanEditRecommendationPreferences}"
                                  SelectedValue="{Binding RecommendationDefaultScene, Mode=TwoWay}"/>
                        <ComboBox Grid.Column="2"
                                  MinHeight="36"
                                  ItemsSource="{Binding RecommendationRotationStrategyOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  IsEnabled="{Binding CanEditRecommendationPreferences}"
                                  SelectedValue="{Binding RecommendationRotationStrategy, Mode=TwoWay}"/>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0"
                               VerticalAlignment="Center">
                        <CheckBox Content="避开今天已穿过"
                                  IsChecked="{Binding RecommendationAvoidWornToday, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditRecommendationPreferences}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,8"/>
                        <Button x:Name="BtnSaveRecommendationPreferences"
                                Content="{Binding RecommendationSaveButtonText}"
                                Style="{StaticResource SettingsButton}"
                                Margin="0,0,0,8"
                                IsEnabled="{Binding CanEditRecommendationPreferences}"
                                Click="SaveRecommendationPreferences_Click"/>
                    </WrapPanel>

                    <Border Style="{StaticResource PageInsetCard}"
                            Background="{DynamicResource SurfacePageBrush}"
                            Padding="12"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsRecommendationStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding RecommendationStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
